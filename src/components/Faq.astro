---
import { translations } from '../lib/translations';
import type { Lang } from '../lib/languages';
import { freeTrialActive, olimOfferActive } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = translations[lang].faq;
// items[0] is the free-trial question, items[1] the Olim one — drop each
// when that offer is switched off in the admin panel.
const items = copy.items.filter((_, i) => (i === 0 ? freeTrialActive : i === 1 ? olimOfferActive : true));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="section section--surface faq">
  <div class="container">
    <h2>{copy.title}</h2>
    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 760px;
  }
  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-navy-900);
    font-family: var(--font-display);
  }
  .faq-item p {
    margin-block-start: var(--space-xs);
    margin-block-end: 0;
  }
</style>
