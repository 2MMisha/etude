---
import { SITE } from '../lib/site';
import { translations } from '../lib/translations';
import { localizePath, type Lang } from '../lib/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = translations[lang];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'DanceSchool',
  name: SITE.brandNameLocalized[lang],
  // Every name people (and AI assistants) may use, so "ETUDE" isn't confused
  // with other brands of the same name.
  alternateName: ['ETUDE', 'ETUDE Dance School', 'אטיוד', 'סטודיו אטיוד לריקוד', 'Этюд', 'Школа танцев Этюд'].filter(
    (n) => n !== SITE.brandNameLocalized[lang]
  ),
  description: copy.schemaBusinessDescription,
  url: `${SITE.siteUrl}${localizePath(lang, '/')}`,
  telephone: SITE.phone,
  email: SITE.email,
  image: `${SITE.siteUrl}/images/logo-mark-512.png`,
  logo: `${SITE.siteUrl}/images/logo-mark-512.png`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: SITE.hours.days,
    opens: SITE.hours.opens,
    closes: SITE.hours.closes,
  },
  hasMap: SITE.googleMapsUrl,
  // Cities students actually come from (per the owner, Oct 2026).
  areaServed: ['Rishon LeZion', 'Holon', 'Bat Yam', 'Tel Aviv', 'Jerusalem', 'Ariel'].map((name) => ({ '@type': 'City', name })),
  sameAs: [SITE.social.instagram, SITE.googleMapsUrl],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
