---
// "Print" and "Share" for a news post. Share opens the dialog from
// src/lib/shareCard.ts (an Instagram/Facebook story or post image with a QR
// code, plus share links). Printing keeps only the article, under the logo
// and a QR code to the post.
import QRCode from 'qrcode';
import { type Lang } from '../lib/languages';
import { translations } from '../lib/translations';
import { icon } from '../lib/icons';

interface Props {
  lang: Lang;
  url: string; // absolute URL of the post
  title: string;
  lead: string; // plain-text start of the post
  date: string; // already formatted for the language
  image?: string;
}

const { lang, url, title, lead, date, image } = Astro.props;
const t = translations[lang].share;
const qrSvg = await QRCode.toString(url, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#17224a', light: '#ffffff' } });
---

<div class="news-share" data-post={JSON.stringify({ lang, url, title, lead, date, image })} data-text={JSON.stringify(t)}>
  <button type="button" class="btn btn--ghost" data-print><Fragment set:html={icon('printer')} />{t.print}</button>
  <button type="button" class="btn btn--primary" data-open><Fragment set:html={icon('share')} />{t.share}</button>
</div>

<!-- Only on paper: logo and a QR code to the post above the article. -->
<div class="news-print" aria-hidden="true">
  <img src="/images/brand/logo-line.svg" alt="" />
  <p>{t.scanToRead}<br /><span dir="ltr">{url}</span></p>
  <div class="news-print__qr" set:html={qrSvg} />
</div>

<script>
  import { openShare } from '../lib/shareCard';

  for (const root of document.querySelectorAll<HTMLElement>('.news-share')) {
    root.querySelector('[data-print]')!.addEventListener('click', () => window.print());
    root.querySelector('[data-open]')!.addEventListener('click', () => openShare(JSON.parse(root.dataset.post!), JSON.parse(root.dataset.text!)));
  }
</script>

<style>
  .news-share {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-line);
  }
  .news-share :global(.ic) {
    inline-size: 1.25em;
    block-size: 1.25em;
    flex: none;
  }

  .news-print {
    display: none;
  }

  @media print {
    @page {
      margin: 12mm;
    }
    :global(body) {
      background: #fff;
    }
    /* Only the article: no header, footer, banners or floating buttons. */
    :global(body > :not(main)),
    :global(.back-link),
    .news-share {
      display: none !important;
    }
    :global(main .section) {
      padding: 0;
    }
    /* Photo at a size that leaves the text on the same page. */
    :global(.news-article .news-article__figure) {
      margin-block: 3mm;
    }
    :global(.news-article .news-article__frame) {
      aspect-ratio: auto !important;
      display: flex;
      justify-content: center;
    }
    :global(.news-article .news-article__frame::before) {
      display: none;
    }
    :global(.news-article .news-article__image) {
      inline-size: auto;
      max-inline-size: 100%;
      block-size: auto;
      max-block-size: 60mm;
    }
    :global(.news-article h1) {
      margin-block: 0;
      font-size: 24pt;
    }
    :global(.news-article .news-article__body) {
      font-size: 10.5pt;
    }
    :global(.news-article__inner) {
      display: flex;
      flex-direction: column;
    }
    .news-print {
      order: -1;
      display: flex;
      align-items: center;
      gap: 5mm;
      margin-block-end: 4mm;
      padding-block-end: 3mm;
      border-block-end: 1px solid #ccc;
    }
    .news-print img {
      block-size: 12mm;
      margin-inline-end: auto;
    }
    .news-print__qr {
      inline-size: 22mm;
      block-size: 22mm;
      flex: none;
    }
    .news-print__qr :global(svg) {
      display: block;
      inline-size: 100%;
      block-size: 100%;
    }
    .news-print p {
      margin: 0;
      max-inline-size: 70mm;
      font-size: 9pt;
      font-weight: 600;
      text-align: end;
    }
    .news-print p span {
      font-weight: 400;
      font-size: 0.85em;
      color: #555;
      word-break: break-all;
    }
  }
</style>
