---
// Cookie consent bar. Shown until the visitor accepts or declines; Google
// Analytics cookies are enabled only after "Accept" (see Analytics.astro). The footer's
// "Cookie settings" link ([data-cookie-settings]) reopens it.
import { SITE } from '../lib/site';
import { localizePath, type Lang } from '../lib/languages';
import { translations } from '../lib/translations';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = translations[lang].common;
---

{SITE.ga4MeasurementId && (
  <div class="cookie-bar" id="cookie-bar" role="region" aria-label={copy.cookieSettings} hidden>
    <p>
      {copy.cookieText}{' '}
      <a href={localizePath(lang, '/privacy')}>{copy.privacy}</a>
    </p>
    <div class="cookie-bar__actions">
      <button type="button" class="btn btn--primary" data-consent="granted">{copy.cookieAccept}</button>
      <button type="button" class="btn btn--secondary" data-consent="denied">{copy.cookieDecline}</button>
    </div>
  </div>
)}

<script>
  const KEY = 'etude-cookie-consent';
  const bar = document.getElementById('cookie-bar');
  const read = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };
  if (bar) {
    if (!read()) bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const choice = (e.target as HTMLElement).closest<HTMLElement>('[data-consent]')?.dataset.consent;
      if (!choice) return;
      try {
        localStorage.setItem(KEY, choice);
      } catch {}
      bar.hidden = true;
      if (choice === 'granted') (window as any).etudeLoadAnalytics?.();
    });
    document.querySelectorAll('[data-cookie-settings]').forEach((link) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        bar.hidden = false;
        bar.querySelector<HTMLButtonElement>('[data-consent]')?.focus();
      })
    );
  }
</script>

<style>
  .cookie-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    /* Below the WhatsApp (150) and accessibility buttons, which sit in its side padding. */
    z-index: 140;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs) var(--space-md);
    /* Side room for the floating WhatsApp and accessibility buttons. */
    padding: var(--space-sm) 4.5rem calc(var(--space-sm) + env(safe-area-inset-bottom, 0px));
    background: var(--color-surface);
    border-block-start: 1px solid var(--color-line);
    box-shadow: 0 -6px 24px rgb(23 34 74 / 0.12);
    font-size: 0.92rem;
  }
  .cookie-bar[hidden] {
    display: none;
  }
  .cookie-bar p {
    margin: 0;
    max-width: 60ch;
  }
  .cookie-bar a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .cookie-bar__actions {
    display: flex;
    gap: var(--space-xs);
  }
  .cookie-bar .btn {
    padding: 0.55em 1.2em;
  }
</style>
