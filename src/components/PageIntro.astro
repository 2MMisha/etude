---
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<section class="page-intro">
  <div class="container">
    <h1>{title}</h1>
    {intro && <p class="page-intro__text">{intro}</p>}
  </div>
</section>

<style>
  .page-intro {
    background: var(--color-silver-100);
    padding-block: var(--space-lg);
    border-block-end: 1px solid var(--color-line);
  }
  .page-intro__text {
    max-width: 65ch;
    font-size: 1.05rem;
  }
</style>
