---
import { localizePath, type Lang } from '../lib/languages';
import { translations } from '../lib/translations';
import { SITE } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = translations[lang];
const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${SITE.whatsapp}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <a href={localizePath(lang, '/')} class="footer-brand">
        <img src="/images/logo-circular-192.png" alt="" width="40" height="40" />
        <span>{SITE.brandNameLocalized[lang]}</span>
      </a>
      <p>{SITE.tagline[lang]}</p>
    </div>

    <div class="footer-col">
      <h3>{copy.contact.detailsTitle}</h3>
      <ul class="footer-list">
        <li><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
        <li><a href={whatsappHref} target="_blank" rel="noopener noreferrer">{copy.common.whatsapp}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>{SITE.address.street}, {SITE.address.cityLocalized[lang]}</li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>{copy.contact.hoursTitle}</h3>
      <p dir="ltr">08:00 – 21:00</p>
      <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="footer-social">Instagram</a>
    </div>

    <div class="footer-col">
      <h3>{copy.nav.home}</h3>
      <ul class="footer-list">
        <li><a href={localizePath(lang, '/about')}>{copy.nav.about}</a></li>
        <li><a href={localizePath(lang, '/classes')}>{copy.nav.classes}</a></li>
        <li><a href={localizePath(lang, '/pricing')}>{copy.nav.pricing}</a></li>
        <li><a href={localizePath(lang, '/contact')}>{copy.nav.contact}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} {SITE.brandNameLocalized[lang]}. {copy.common.allRightsReserved}.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-900);
    color: var(--color-silver-200);
    padding-block-start: var(--space-xl);
    margin-block-start: var(--space-xl);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-lg);
    padding-block-end: var(--space-lg);
  }
  @media (max-width: 880px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-block-end: 0.75rem;
  }
  .footer-brand span {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: #fff;
    font-weight: 700;
  }
  .footer-col h3 {
    color: var(--color-silver-100);
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-block-end: 0.9rem;
  }
  .footer-col p {
    color: var(--color-silver-300);
    font-size: 0.92rem;
  }
  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer-list a,
  .footer-social {
    color: var(--color-silver-300);
    font-size: 0.92rem;
    text-decoration: none;
  }
  .footer-list a:hover,
  .footer-social:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer-social {
    display: inline-block;
    margin-block-start: 0.5rem;
  }
  .footer-bottom {
    border-block-start: 1px solid rgba(255,255,255,0.12);
    padding-block: var(--space-sm);
    font-size: 0.82rem;
    color: var(--color-silver-300);
  }
  .footer-bottom p { margin: 0; }
</style>
