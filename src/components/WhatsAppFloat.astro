---
import { SITE } from '../lib/site';
import { translations } from '../lib/translations';
import type { Lang } from '../lib/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = translations[lang];
const href = `https://wa.me/${SITE.whatsapp}`;
---

<a href={href} target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label={copy.common.whatsapp}>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.23.6 4.32 1.65 6.12L4 29l8.06-1.6a12.9 12.9 0 0 0 3.96.62c6.62 0 12.02-5.4 12.02-12.02C28.04 8.4 22.64 3 16.02 3zm0 21.9a9.8 9.8 0 0 1-5-1.36l-.36-.21-4.79.95.99-4.67-.24-.38a9.83 9.83 0 0 1-1.5-5.2c0-5.45 4.44-9.9 9.9-9.9 5.45 0 9.9 4.45 9.9 9.9 0 5.46-4.45 9.87-9.9 9.87zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.08-.13-.27-.2-.57-.35z"
    ></path>
  </svg>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    inset-block-end: 1.25rem;
    inset-inline-end: 1.25rem;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 28px -10px rgba(0,0,0,0.4);
    z-index: 150;
    transition: transform 0.15s ease;
  }
  .whatsapp-float:hover {
    transform: scale(1.06);
    text-decoration: none;
  }
</style>
