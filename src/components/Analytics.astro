---
// Google Analytics 4, loaded only after the visitor accepts cookies in the
// consent banner (CookieConsent.astro). The choice lives in localStorage
// under "etude-cookie-consent": "granted" | "denied".
import { SITE } from '../lib/site';
const id = SITE.ga4MeasurementId;
---

{id && (
  <script is:inline define:vars={{ id }}>
    window.etudeLoadAnalytics = function () {
      if (window.etudeAnalyticsLoaded) return;
      window.etudeAnalyticsLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', id);
    };
    try {
      if (localStorage.getItem('etude-cookie-consent') === 'granted') window.etudeLoadAnalytics();
    } catch (e) {}
  </script>
)}
