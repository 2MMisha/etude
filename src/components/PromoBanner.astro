---
import { translations } from '../lib/translations';
import { freeTrialActive, olimOfferActive } from '../lib/site';
import type { Lang } from '../lib/languages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = translations[lang].promo;
---

{(freeTrialActive || olimOfferActive) && (
  <div class="promo-banner">
    <span class="badge promo-banner__badge">{copy.badge}</span>
    <div class={`promo-banner__grid ${freeTrialActive && olimOfferActive ? 'promo-banner__grid--2' : ''}`}>
      {freeTrialActive && (
        <div class="promo-item">
          <h2 class="promo-item__title h3">{copy.trialTitle}</h2>
          <p>{copy.trialBody}</p>
        </div>
      )}
      {olimOfferActive && (
        <div class="promo-item">
          <h2 class="promo-item__title h3">{copy.olimTitle}</h2>
          <p>{copy.olimBody}</p>
        </div>
      )}
    </div>
  </div>
)}

<style>
  .promo-banner {
    background: var(--color-navy-900);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-md) var(--space-lg);
    color: #fff;
  }
  .promo-banner__badge {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    margin-block-end: var(--space-sm);
  }
  .promo-banner__grid {
    display: grid;
    gap: var(--space-md);
    margin-block-start: var(--space-xs);
  }
  .promo-banner__grid--2 {
    grid-template-columns: 1fr 1fr;
  }
  .promo-banner__grid--2 .promo-item + .promo-item {
    border-inline-start: 1px solid rgba(255, 255, 255, 0.22);
    padding-inline-start: var(--space-md);
  }
  @media (max-width: 880px) {
    .promo-banner__grid--2 { grid-template-columns: 1fr; }
    .promo-banner__grid--2 .promo-item + .promo-item {
      border-inline-start: 0;
      padding-inline-start: 0;
      border-block-start: 1px solid rgba(255, 255, 255, 0.22);
      padding-block-start: var(--space-md);
    }
  }
  /* h2 for a correct heading outline (it follows the page h1), sized like an h3 */
  .promo-item__title {
    color: #fff;
    margin-block-end: 0.4rem;
  }
  .promo-item p {
    color: var(--color-silver-200);
    margin: 0;
  }
</style>
