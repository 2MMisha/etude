---
// The homepage, shared by /[lang]/ and the bare "/" (which renders the
// Hebrew default directly — GitHub Pages can't send HTTP redirects, and a
// meta-refresh is treated as a thin "doorway" page by SEO tools).
import { excerpt } from '../lib/richText';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from './NewsCard.astro';
import PromoBanner from './PromoBanner.astro';
import { localizePath, type Lang } from '../lib/languages';
import { translations } from '../lib/translations';
import { SITE, freeTrialActive } from '../lib/site';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = translations[lang];
// "Free trial" wording only while the free-trial promo is switched on.
const trialCta = freeTrialActive ? copy.home.heroCtaPrimary : copy.home.heroCtaTrial;

const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---


<BaseLayout lang={lang} path="/" title={copy.home.metaTitle} description={copy.home.metaDescription}>
  {/* The hero background is the LCP element; a CSS url() is found late, so preload it. */}
  <link slot="head" rel="preload" as="image" href="/images/brand/bg.webp" type="image/webp" fetchpriority="high" />
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        {/* One h1 holds both lines so the keyword line (city + style) counts as the page heading. */}
        <h1 class="hero__heading">
          <span class="eyebrow">{copy.home.heroEyebrow}</span>
          <span class="hero__title">{copy.home.heroTitle}</span>
        </h1>
        <svg class="hero__stroke" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M4 26 C 90 8, 170 34, 250 22 S 420 6, 500 20 S 575 30, 596 14" pathLength="1" />
        </svg>
        <p class="hero__subtitle">{copy.home.heroSubtitle}</p>
        <div class="hero__ctas">
          <a href={localizePath(lang, '/contact')} class="btn btn--primary">{trialCta}</a>
          <a href={localizePath(lang, '/schedule')} class="btn btn--secondary">{copy.home.heroCtaSecondary}</a>
        </div>
      </div>
      <div class="hero__mark" aria-hidden="true">
        <img src="/images/brand/logo-full.svg" alt={`${SITE.brandName} — ${SITE.tagline[lang]}`} width="400" height="168" />
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <PromoBanner lang={lang} />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container intro">
      <div class="intro__text">
        <h2>{copy.home.introTitle}</h2>
        <p>{copy.home.introBody}</p>
        <p>{copy.home.introBody2}</p>
        <p>{copy.home.introBody3}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{copy.home.highlightsTitle}</h2>
      <ul class="highlights">
        {copy.home.highlights.map((h) => (
          <li>
            <h3>{h.title}</h3>
            <p>{h.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Testimonials.astro is ready but holds sample quotes only — re-add
      <Testimonials lang={lang} /> here once real student reviews are in
      translations.ts. */}

  {latestNews.length > 0 && (
    <section class="section section--surface">
      <div class="container">
        <h2>{copy.home.newsTitle}</h2>
        <div class="grid grid--3">
          {latestNews.map((post) => (
            <NewsCard
              lang={lang}
              id={post.id}
              date={post.data.date}
              image={post.data.image}
              title={post.data.title[lang]}
              excerpt={excerpt(post.data.body[lang], 110)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>{copy.home.ctaBandTitle}</h2>
        <p>{copy.home.ctaBandBody}</p>
      </div>
      <a href={localizePath(lang, '/contact')} class="btn btn--primary">{copy.home.ctaBandButton}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background:
      linear-gradient(180deg, rgba(247, 248, 251, 0.6) 0%, var(--color-ground) 92%),
      url('/images/brand/bg.webp');
    background-size: auto, 560px auto;
    padding-block: var(--space-xl) calc(var(--space-xl) - 1rem);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-lg);
  }
  .hero__heading {
    margin: 0;
  }
  .hero__title {
    display: block;
    font-size: clamp(3rem, 2rem + 4.4vw, 5.6rem);
    line-height: 1.02;
    margin-block-end: 0.15em;
    color: var(--color-blue-600);
  }
  :lang(he) .hero__title {
    font-size: clamp(3.4rem, 2.2rem + 5vw, 6.4rem);
    line-height: 1.15;
    /* Gveret Levin's lamed rises well above the line box — give it room so
       it doesn't brush over the line above. */
    padding-block-start: 0.2em;
  }
  /* The one motion moment on the site: a brush stroke draws itself under
     the headline, like a step traced across the floor. */
  .hero__stroke {
    display: block;
    width: min(100%, 460px);
    height: 26px;
    margin-block-end: var(--space-md);
    overflow: visible;
  }
  :dir(rtl) .hero__stroke { transform: scaleX(-1); }
  .hero__stroke path {
    fill: none;
    stroke: var(--color-blue-500);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.25s forwards;
  }
  @keyframes hero-draw {
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__stroke path { animation: none; stroke-dashoffset: 0; }
  }
  .hero__subtitle {
    font-size: 1.12rem;
    max-width: 48ch;
    color: var(--color-ink);
  }
  .hero__ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-block-start: var(--space-md);
  }
  .hero__mark {
    justify-self: center;
  }
  .hero__mark img {
    width: 100%;
    max-width: 400px;
    height: auto;
  }
  @media (max-width: 880px) {
    .hero { padding-block: var(--space-lg); }
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-md); }
    .hero__mark { order: -1; justify-self: start; }
    .hero__mark img { max-width: 200px; }
  }

  .intro { text-align: center; }
  .intro__text { max-width: 720px; margin-inline: auto; }
  .intro__text p { font-size: 1.08rem; }

  /* Highlights: three short statements divided by rules, not boxed cards. */
  .highlights {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .highlights li {
    padding-inline: var(--space-md);
    border-inline-start: 1px solid var(--color-line);
  }
  .highlights li:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .highlights h3 { color: var(--color-blue-600); margin-block-end: 0.3em; }
  .highlights p { margin: 0; }
  @media (max-width: 880px) {
    .highlights { grid-template-columns: 1fr; gap: var(--space-md); }
    .highlights li,
    .highlights li:first-child {
      padding-inline: 0;
      border-inline-start: 0;
      border-block-start: 1px solid var(--color-line);
      padding-block-start: var(--space-md);
    }
  }

  .cta-band {
    background: var(--color-navy-900);
    color: #fff;
    border-radius: var(--radius-lg);
    max-width: calc(var(--max-width) - 2 * var(--space-sm));
    margin-inline: auto;
    padding-inline: var(--space-md);
  }
  @media (max-width: 1212px) {
    .cta-band { margin-inline: var(--space-sm); }
  }
  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .cta-band h2 { color: #fff; }
  .cta-band p { color: var(--color-silver-200); margin: 0; }
  /* btn--primary defaults to a navy background, which would vanish against
     this section's own navy bg. */
  .cta-band .btn--primary {
    background: #fff;
    color: var(--color-navy-900);
  }
  .cta-band .btn--primary:hover {
    background: var(--color-silver-100);
  }
</style>
