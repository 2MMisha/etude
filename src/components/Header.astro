---
import { ALL_LANGS, LANGUAGES, localizePath, type Lang } from '../lib/languages';
import { translations } from '../lib/translations';
import { SITE } from '../lib/site';

interface Props {
  lang: Lang;
  path: string; // unprefixed current path, used to build the lang switcher + active states
}
const { lang, path } = Astro.props;
const nav = translations[lang].nav;
const common = translations[lang].common;

const navItems: { key: keyof typeof nav; href: string }[] = [
  { key: 'home', href: '/' },
  { key: 'about', href: '/about' },
  { key: 'classes', href: '/classes' },
  { key: 'schedule', href: '/schedule' },
  { key: 'instructors', href: '/instructors' },
  { key: 'pricing', href: '/pricing' },
  { key: 'hallRental', href: '/hall-rental' },
  { key: 'news', href: '/news' },
  { key: 'contact', href: '/contact' },
];
---

<header class="site-header">
  <div class="container site-header__row">
    <a href={localizePath(lang, '/')} class="brand" aria-label={SITE.brandNameLocalized[lang]}>
      <img src="/images/brand/icon.svg" alt={`${SITE.brandName} logo`} width="38" height="38" class="brand__mark" />
      <span class="brand__name">{SITE.brandNameLocalized[lang]}</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-label-open={common.menu}
      data-label-close={common.closeMenu}
      aria-label={common.menu}
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label={common.menu}>
      <ul class="site-nav__list">
        {navItems.map((item) => {
          const isActive = item.href === '/' ? path === '/' : path === item.href || path.startsWith(`${item.href}/`);
          return (
            <li>
              <a href={localizePath(lang, item.href)} aria-current={isActive ? 'page' : undefined}>
                {nav[item.key]}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="lang-switcher" role="group" aria-label="Language">
        {ALL_LANGS.map((l) => (
          <a
            href={localizePath(l, path)}
            class={`lang-switcher__item ${l === lang ? 'is-active' : ''}`}
            aria-current={l === lang ? 'true' : undefined}
            lang={LANGUAGES[l].htmlLang}
            hreflang={LANGUAGES[l].htmlLang}
          >
            {LANGUAGES[l].label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const header = document.querySelector('.site-header');
  if (toggle && header) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) || '');
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 1321px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    gap: var(--space-md);
  }
  .brand {
    flex-shrink: 0;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }
  .brand:hover { text-decoration: none; }
  .brand__mark { display: block; }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--color-navy-900);
    letter-spacing: 0.01em;
  }

  .site-nav__list {
    display: flex;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }
  .site-nav__list a {
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.25rem;
    border-block-end: 2px solid transparent;
  }
  .site-nav__list a:hover,
  .site-nav__list a[aria-current='page'] {
    color: var(--color-navy-900);
    border-block-end-color: var(--color-accent);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .lang-switcher {
    display: flex;
    gap: 0.4rem;
    border-inline-start: 1px solid var(--color-line);
    padding-inline-start: var(--space-sm);
  }
  .lang-switcher__item {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    padding: 0.3em 0.6em;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .lang-switcher__item.is-active {
    background: var(--color-navy-900);
    color: #fff;
  }
  .lang-switcher__item:hover:not(.is-active) {
    background: var(--color-silver-100);
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 1320px) {
    .site-nav {
      position: fixed;
      inset-block-start: 0;
      inset-inline-end: -100%;
      inset-block-end: 0;
      width: min(320px, 85vw);
      background: var(--color-surface);
      flex-direction: column;
      align-items: flex-start;
      padding: 5.5rem var(--space-md) var(--space-md);
      box-shadow: var(--shadow-lift);
      overflow-y: auto;
      z-index: 105;
    }
    .site-nav__list {
      flex-direction: column;
      gap: var(--space-sm);
      width: 100%;
    }
    .lang-switcher {
      border-inline-start: none;
      border-block-start: 1px solid var(--color-line);
      padding-inline-start: 0;
      padding-block-start: var(--space-md);
      margin-block-start: var(--space-md);
      width: 100%;
    }
    .site-nav { visibility: hidden; transition: inset-inline-end 0.25s ease, visibility 0s linear 0.25s; }
    .nav-toggle {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 0.6rem;
      position: relative;
      z-index: 110;
      background: none;
      border: 0;
      border-radius: var(--radius-sm);
    }
    .nav-toggle span {
      width: 24px;
      height: 2px;
      background: var(--color-navy-900);
      display: block;
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .is-open .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .is-open .nav-toggle span:nth-child(2) { opacity: 0; }
    .is-open .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .is-open .site-nav {
      inset-inline-end: 0;
      visibility: visible;
      transition: inset-inline-end 0.25s ease;
    }
  }
</style>
