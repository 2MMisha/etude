---
import { ALL_LANGS, LANGUAGES, localizePath, type Lang } from '../lib/languages';
import { translations } from '../lib/translations';
import { SITE } from '../lib/site';

interface Props {
  lang: Lang;
  path: string; // unprefixed current path, used to build the lang switcher + active states
}
const { lang, path } = Astro.props;
const nav = translations[lang].nav;

const navItems: { key: keyof typeof nav; href: string }[] = [
  { key: 'home', href: '/' },
  { key: 'about', href: '/about' },
  { key: 'classes', href: '/classes' },
  { key: 'schedule', href: '/schedule' },
  { key: 'instructors', href: '/instructors' },
  { key: 'pricing', href: '/pricing' },
  { key: 'news', href: '/news' },
  { key: 'contact', href: '/contact' },
];
---

<header class="site-header">
  <div class="container site-header__row">
    <a href={localizePath(lang, '/')} class="brand" aria-label={SITE.brandNameLocalized[lang]}>
      <img src="/images/brand/icon.svg" alt="" width="38" height="38" class="brand__mark" />
      <span class="brand__name">{SITE.brandNameLocalized[lang]}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {navItems.map((item) => {
          const isActive = path === item.href || (item.href === '/' && path === '/');
          return (
            <li>
              <a href={localizePath(lang, item.href)} aria-current={isActive ? 'page' : undefined}>
                {nav[item.key]}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="lang-switcher" role="group" aria-label="Language">
        {ALL_LANGS.map((l) => (
          <a
            href={localizePath(l, path)}
            class={`lang-switcher__item ${l === lang ? 'is-active' : ''}`}
            aria-current={l === lang ? 'true' : undefined}
          >
            {LANGUAGES[l].label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    gap: var(--space-md);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }
  .brand:hover { text-decoration: none; }
  .brand__mark { display: block; }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-navy-900);
    letter-spacing: 0.01em;
  }

  .site-nav__list {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .site-nav__list a {
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.25rem;
    border-block-end: 2px solid transparent;
  }
  .site-nav__list a:hover,
  .site-nav__list a[aria-current='page'] {
    color: var(--color-navy-900);
    border-block-end-color: var(--color-accent);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .lang-switcher {
    display: flex;
    gap: 0.4rem;
    border-inline-start: 1px solid var(--color-line);
    padding-inline-start: var(--space-md);
  }
  .lang-switcher__item {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    padding: 0.3em 0.6em;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .lang-switcher__item.is-active {
    background: var(--color-navy-900);
    color: #fff;
  }
  .lang-switcher__item:hover:not(.is-active) {
    background: var(--color-silver-100);
    text-decoration: none;
  }

  .nav-toggle,
  .nav-toggle-label {
    display: none;
  }

  @media (max-width: 900px) {
    .site-nav {
      position: fixed;
      inset-block-start: 0;
      inset-inline-end: -100%;
      inset-block-end: 0;
      width: min(320px, 85vw);
      background: var(--color-surface);
      flex-direction: column;
      align-items: flex-start;
      padding: 5.5rem var(--space-md) var(--space-md);
      box-shadow: var(--shadow-lift);
      transition: inset-inline-end 0.25s ease;
      overflow-y: auto;
    }
    .site-nav__list {
      flex-direction: column;
      gap: var(--space-sm);
      width: 100%;
    }
    .lang-switcher {
      border-inline-start: none;
      border-block-start: 1px solid var(--color-line);
      padding-inline-start: 0;
      padding-block-start: var(--space-md);
      margin-block-start: var(--space-md);
      width: 100%;
    }
    .nav-toggle-label {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 0.5rem;
      z-index: 110;
    }
    .nav-toggle-label span {
      width: 24px;
      height: 2px;
      background: var(--color-navy-900);
      display: block;
      border-radius: 2px;
    }
    .nav-toggle:checked ~ .site-nav {
      inset-inline-end: 0;
    }
  }
</style>
