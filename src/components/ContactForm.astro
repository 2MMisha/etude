---
import { translations } from '../lib/translations';
import { SITE } from '../lib/site';
import { localizePath, type Lang } from '../lib/languages';

interface Props {
  lang: Lang;
  /** Ad landing-page mode: name + phone only. `source` labels the lead in the email. */
  lead?: { source: string; submit: string; phoneHint: string };
}
const { lang, lead } = Astro.props;
const copy = translations[lang];
const consent = copy.contact.consent;
// Every form lands on the thank-you page, which fires the Ads conversion
// (Analytics.astro). `from=lp` lets it show the landing page's WhatsApp number.
const next = `${SITE.siteUrl}${localizePath(lang, '/thanks')}${lead ? '?from=lp' : ''}`;
---

<form class="contact-form" action={SITE.formSubmitEndpoint} method="POST">
  <input type="hidden" name="_subject" value={lead ? `Lead: ${lead.source}` : `New website inquiry — ${SITE.brandNameLocalized[lang]}`} />
  <input type="hidden" name="_next" value={next} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  {/* utm_* / gclid / fbclid from the ad click, filled in by the script below */}
  <input type="hidden" name="utm" value="" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="true" />
  <input type="hidden" name="_language" value={lang} />
  {/* Honeypot field for basic spam protection */}
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="field">
    <label for="name">{copy.contact.formName}</label>
    <input id="name" name="name" type="text" required autocomplete="name" />
  </div>

  {!lead && (
    <div class="field">
      <label for="email">{copy.contact.formEmail}</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
    </div>
  )}

  <div class="field">
    <label for="phone">{copy.contact.formPhone}</label>
    {lead ? (
      <input id="phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" dir="ltr" pattern="[0-9 +\-\(\)]{9,}" title={lead.phoneHint} />
    ) : (
      <input id="phone" name="phone" type="tel" autocomplete="tel" />
    )}
  </div>

  {!lead && (
    <div class="field">
      <label for="message">{copy.contact.formMessage}</label>
      <textarea id="message" name="message" rows="5" required></textarea>
    </div>
  )}

  {/* Required consent; the submitted value is kept in the emailed form as a record of agreement. */}
  <div class="consent">
    <input
      id="consent"
      name="consent"
      type="checkbox"
      required
      value={`${consent.before}${consent.terms}${consent.between}${consent.privacy}${consent.after}`}
      data-required-message={consent.required}
    />
    <label for="consent">
      {consent.before}<a href={localizePath(lang, '/terms')} target="_blank" rel="noopener">{consent.terms}</a>{consent.between}<a
        href={localizePath(lang, '/privacy')}
        target="_blank"
        rel="noopener">{consent.privacy}</a
      >{consent.after}
    </label>
  </div>

  <button type="submit" class="btn btn--primary">{lead ? lead.submit : copy.contact.formSubmit}</button>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 520px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-navy-900);
  }
  input,
  textarea {
    font: inherit;
    padding: 0.7em 0.85em;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  input:focus,
  textarea:focus {
    border-color: var(--color-blue-500);
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .consent input {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    margin: 0.15rem 0 0;
    padding: 0;
    flex-shrink: 0;
    accent-color: var(--color-navy-900);
    cursor: pointer;
  }
  .consent label {
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.5;
    cursor: pointer;
  }
  .consent a {
    color: var(--color-blue-600);
    text-decoration: underline;
  }
  .contact-form .btn {
    align-self: flex-start;
    margin-block-start: 0.4rem;
  }
</style>

<script>
  // Show the consent message in the page's own language instead of the browser default.
  document.querySelectorAll<HTMLInputElement>('.contact-form input[name="consent"]').forEach((box) => {
    const message = box.dataset.requiredMessage || '';
    box.addEventListener('invalid', () => box.setCustomValidity(box.checked ? '' : message));
    box.addEventListener('change', () => box.setCustomValidity(''));
  });

  const params = new URLSearchParams(location.search);
  const utm = [...params].filter(([k]) => /^(utm_|gclid|fbclid)/.test(k)).map(([k, v]) => `${k}=${v}`).join('; ');
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    const field = form.querySelector<HTMLInputElement>('input[name="utm"]');
    if (field) field.value = utm;
    // Read on the thank-you page so a reload or direct visit isn't counted.
    form.addEventListener('submit', () => {
      try { sessionStorage.setItem('etude-lead', '1'); } catch (e) { /* storage blocked */ }
    });
  });
</script>
