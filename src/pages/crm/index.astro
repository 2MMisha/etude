---
// /crm/ — the school's management system (staff only). The app itself is in
// src/crm/ (app.ts = shell and routing, views/ = one file per screen).
// Not linked anywhere, noindex; everything it shows comes from the database
// after a login, and what a login may see or change is decided there
// (supabase/migrations/), not on this page.
import '../../styles/global.css';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#17224a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Heebo:wght@400;500;600;700&display=swap"
    />
    <title>ETUDE — CRM</title>
    <style is:global>
      body { background: var(--color-ground); }
      .crm { max-width: 1040px; margin-inline: auto; padding: var(--space-sm) var(--space-sm) var(--space-xl); }
      .crm-top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-block-end: var(--space-sm); }
      .crm-top img { width: 32px; height: 32px; }
      .crm-top strong { font-family: var(--font-display); font-size: 1.2rem; color: var(--color-navy-900); margin-inline-end: auto; white-space: nowrap; }
      .langs { display: flex; gap: 0.2rem; }
      .langs button { padding: 0.25em 0.6em; font-size: 0.85rem; }

      .crm button, .crm input, .crm select, .crm textarea { font: inherit; }
      .crm button, .crm a.btn { padding: 0.5em 1em; border-radius: var(--radius-sm); border: 1px solid var(--color-line); background: var(--color-surface); color: var(--color-ink); cursor: pointer; text-decoration: none; }
      .crm button.primary { background: var(--color-navy-900); border-color: var(--color-navy-900); color: #fff; }
      .crm button.link { border: 0; background: none; color: var(--color-blue-600); padding: 0; }
      .crm button.danger { background: #b3261e; border-color: #b3261e; color: #fff; }
      .crm button[aria-pressed='true'] { background: var(--color-blue-100); border-color: var(--color-blue-500); }
      .crm button:disabled { opacity: 0.5; cursor: default; }
      .crm input[type='text'], .crm input[type='tel'], .crm input[type='email'], .crm input[type='search'], .crm input[type='date'],
      .crm input[type='number'], .crm input[type='password'], .crm select, .crm textarea {
        padding: 0.5em 0.7em; border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface);
        width: 100%; min-width: 0; box-sizing: border-box;
      }
      .crm input.num { width: 6.5em; }
      /* In a table a text field would shrink to nothing on a phone; the table scrolls sideways instead. */
      .crm td input[type='text'], .crm td select { min-width: 9em; }
      .crm input[type='checkbox'] { width: 1.1em; height: 1.1em; accent-color: var(--color-blue-600); }

      #nav { display: flex; gap: 0.3rem; overflow-x: auto; margin-block-end: var(--space-sm); border-block-end: 1px solid var(--color-line); }
      #nav a { padding: 0.6em 0.9em; text-decoration: none; color: var(--color-ink-soft); font-weight: 600; white-space: nowrap; border-block-end: 3px solid transparent; }
      #nav a[aria-current='page'] { color: var(--color-navy-900); border-block-end-color: var(--color-blue-600); }

      .card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-sm); display: grid; gap: 0.9rem; }
      .card.off { opacity: 0.6; }
      .stack { display: grid; gap: var(--space-sm); }
      .crm h1 { font-size: 1.35rem; margin: 0; }
      .crm h2 { font-size: 1.1rem; margin: 0; font-family: var(--font-body); font-weight: 700; }
      .crm h3 { font-size: 0.95rem; margin: 0; font-family: var(--font-body); font-weight: 700; color: var(--color-ink-soft); }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.7rem; }
      .field { display: grid; gap: 0.25em; font-size: 0.82rem; font-weight: 600; color: var(--color-ink-soft); }
      .field.wide { grid-column: span 2; }
      .row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
      .row > input:not([type='checkbox']), .row > select { flex: 1 1 140px; width: auto; }
      .row > input.num { flex: 0 0 6.5em; }
      .row .grow { flex: 1; }
      .row.spread { justify-content: space-between; }
      .tick { display: inline-flex; align-items: center; gap: 0.4em; font-size: 0.92rem; }
      .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
      .chip { display: inline-flex; align-items: center; gap: 0.4em; padding: 0.2em 0.3em 0.2em 0.7em; border-radius: 999px; background: var(--color-blue-100); font-weight: 600; font-size: 0.9rem; }
      [dir='rtl'] .chip { padding: 0.2em 0.7em 0.2em 0.3em; }
      .chips select { width: auto; padding-block: 0.25em; }
      .chips button { padding: 0.2em 0.7em; border-radius: 999px; font-size: 0.82rem; }
      .crm button.x { border: 0; background: none; padding: 0 0.3em; font-size: 1.1rem; line-height: 1; color: var(--color-ink-soft); }
      .quote { margin: 0; padding: 0.6em 0.8em; border-radius: var(--radius-sm); background: var(--color-silver-100); font-weight: 600; }
      .warn { margin: 0; padding: 0.6em 0.8em; border-radius: var(--radius-sm); background: #fff4d6; }
      .muted, .crm small { color: var(--color-ink-soft); font-size: 0.85rem; }
      .crm small { display: block; }
      .monthbar h1 { min-width: 9em; text-align: center; }
      .monthbar .primary { margin-inline-start: auto; }

      .scroll { overflow-x: auto; }
      .crm table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
      .crm th, .crm td { text-align: start; padding: 0.5em; border-block-end: 1px solid var(--color-line); vertical-align: middle; }
      .crm th { font-size: 0.8rem; color: var(--color-ink-soft); font-weight: 600; white-space: nowrap; }
      .crm tr.off td { opacity: 0.55; }
      .crm tr.pending td { background: #fffaf0; }
      .crm td.actions { white-space: nowrap; text-align: end; }
      .crm td.actions button { padding: 0.35em 0.7em; margin-inline-start: 0.2rem; }

      .sign { max-width: 380px; margin: 10vh auto 0; }
      .sign label { display: grid; gap: 0.3em; font-weight: 600; font-size: 0.9rem; }
      .msg { margin: 0; min-height: 1.4em; font-size: 0.9rem; color: var(--color-ink-soft); }
      .msg.bad { color: #b3261e; }
      .status {
        position: fixed; inset-block-end: 1rem; inset-inline: 0; margin-inline: auto; width: fit-content; max-width: min(92vw, 640px); z-index: 5;
        padding: 0.6em 1.1em; border-radius: 999px; background: #1f7a4d; color: #fff; font-weight: 600; font-size: 0.9rem; box-shadow: 0 6px 20px rgba(23, 34, 74, 0.25);
      }
      .status.bad { background: #b3261e; border-radius: var(--radius-md); }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <div class="crm">
      <div class="crm-top">
        <img src="/images/brand/icon.svg" alt="" />
        <strong>ETUDE — CRM</strong>
        <span class="langs" id="langs"></span>
        <button id="signOut" hidden></button>
      </div>
      <nav id="nav" hidden></nav>
      <main id="view"></main>
      <div id="status" class="status" role="status" hidden></div>
    </div>

    <script>
      import '../../crm/app';
    </script>
  </body>
</html>
