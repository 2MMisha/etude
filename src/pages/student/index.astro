      function renderNotice() {
        $('noticeBack').innerHTML = `${icon('back', 'ic--flip')}${t.home}`;
        const n = data.notice;
        $('noticePost').innerHTML = n
          ? `<p class="sa-badge">${icon('megaphone')}${t.important}</p><h1 dir="auto">${esc(n.title[lang])}</h1><div class="post__body" dir="auto">${n.html[lang]}</div>`
          : '';
      }

      function renderSchedule() {
        $('schedTitle').textContent = t.schedule;
        const q = $('q') as HTMLInputElement;
        q.placeholder = t.search;
        if (document.activeElement !== q) q.value = mineView ? '' : query;
        const chip = (v: string, label: string, cls = '') =>
          `<button type="button" data-q="${esc(v)}" aria-pressed="${!mineView && norm(v) === norm(query)}" dir="auto"${cls ? ` class="${cls}"` : ''}>${isFollowed(v) ? STAR : ''}${esc(label)}</button>`;
        $('chips').innerHTML =
          (follows.length ? `<button type="button" data-mine-view aria-pressed="${mineView}">${STAR}${t.mineChip} (${follows.length})</button>` : '') +
          chip('', t.all) +
          data.groups.map((g) => chip(g, g)).join('') +
          data.names.map((n) => chip(n, n, 'chip--name')).join('');
        $('mineRow').innerHTML = mineView
          ? follows.map((f, n) => `<button type="button" class="btn btn--ghost" data-unfollow="${n}" aria-label="${t.unfollow}: ${esc(f)}" dir="auto">${STAR}${esc(f)}${icon('close')}</button>`).join('')
          : !query.trim()
            ? ''
            : isFollowed(query)
              ? `<span class="tag">${STAR}${t.isMine}</span><button type="button" class="btn btn--ghost" data-follow="off">${t.unmine}</button>`
              : `<button type="button" class="btn" data-follow="on">${icon('star')}${t.mine}</button>`;

        // Calendar feeds whose group or name matches the query (or any follow).
        const wanted = mineView ? follows : query.trim() ? [query] : [];
        const feeds = data.feeds.filter((f) => wanted.some((w) => norm(f.name).includes(norm(w))));
        $('cal').hidden = !feeds.length;
        $('calSummary').innerHTML = `${icon('bell')}${t.calendar}`;
        $('calHint').textContent = t.calHint;
        $('alarmLabel').textContent = t.alarm;
        $('alarm').innerHTML = data.alarms.map((m) => `<option value="${m}" ${m === alarm ? 'selected' : ''}>${t.alarms[m]}</option>`).join('');
        $('calLinks').innerHTML = feeds
          .map((f) => `<div class="feed"><b dir="auto">${esc(f.name)}</b>${calButtons(`${data.siteUrl}/student/cal/${encodeURIComponent(`${f.slug}-${alarm}`)}.ics`)}</div>`)
          .join('');

        const days = upcoming(mineView ? matchesAny : (i) => matches(i, query));
        // Each day as a time grid with a lane per hall (src/lib/weekGrid.ts), like the trainers' pages.
        $('days').innerHTML = days.length
          ? weekGrid({
              dates: days.map((d) => d.date),
              byDate: new Map(days.map((d) => [d.date, d.items])),
              perDay: true,
              now: { date: today(), min: nowMin() },
              noClasses: t.noMatch,
              hallName: (h) => (/big/i.test(h) ? t.bigS : /small/i.test(h) ? t.smallS : h),
              dayHead: (date) => `<b class="sa-dname">${esc(dayName(date))}</b>`,
              who: (i) => i.column,
              colorClass: (i) => `c${Math.max(0, data.trainers.indexOf(i.column.split(' · ')[0])) % 6}`,
            })
          : `<p class="hint">${t.noMatch}</p>`;
        fitCards($('days'));
      }

      function renderClasses() {
        // Music: a section per dance style, a row per dance with its playlist(s).
        $('music').innerHTML = data.music.length
          ? `<h2 class="sa-h">${icon('music')}${t.music}</h2>` +
            data.music
              .map((st) => `<h3 class="sa-style" dir="auto">${esc(st.style)}</h3><ul class="list sa-dances">` + st.dances
                .map((d) => d.links.length === 1
                  ? `<li><a href="${esc(d.links[0])}" target="_blank" rel="noopener">${icon('music')}<span dir="auto">${esc(d.name)}</span><small>${esc(service(d.links[0]))}</small></a></li>`
                  : `<li class="sa-dance-multi">${icon('music')}<span dir="auto">${esc(d.name)}</span><span class="sa-row">${d.links.map((u) => `<a class="btn btn--ghost" href="${esc(u)}" target="_blank" rel="noopener">${esc(service(u))}</a>`).join('')}</span></li>`)
                .join('') + '</ul>')
              .join('')
          : '';
        const c = data.classes[lang];
        $('classesTitle').textContent = t.classesT;
        $('classes').innerHTML =
          `<p>${esc(c.intro)}</p>` +
          c.sections.map((sec) => (sec.title ? `<h3 class="day">${esc(sec.title)}</h3>` : '') + sec.items.map((s) => `<details class="card"><summary>${esc(s.title)}</summary><p>${esc(s.body)}</p></details>`).join('')).join('') +
          `<a class="btn btn--ghost" href="${c.url}">${t.more}</a>`;
        $('pricesTitle').textContent = t.prices;
        const prices = data.prices[lang]?.length ? data.prices[lang] : data.prices.he;
        // "Kids group, 4 lessons/month — 300 ₪": name and price on one row.
        $('prices').innerHTML = prices?.length
          ? `<dl class="prices">${prices.map((p) => { const [a, ...b] = p.split(/\s+[—–-]\s+/); return `<dt dir="auto">${esc(a)}</dt><dd dir="auto">${esc(b.join(' — '))}</dd>`; }).join('')}</dl>`
          : `<p class="hint">${t.noPrices}</p><a class="btn" href="https://wa.me/${data.contact.whatsapp}" target="_blank" rel="noopener">${icon('chat')}${t.whatsapp}</a>`;
      }

      function renderStudio() {
        $('rulesTitle').textContent = t.rules;
        $('rules').innerHTML = (data.rules[lang]?.length ? data.rules[lang] : data.rules.he).map((r) => `<li dir="auto">${esc(r)}</li>`).join('');
        $('payCard').innerHTML = data.payment.active
          ? `<div class="card sa-pay"><h2>${icon('wallet')}${t.payTitle}</h2><p>${esc(data.payment.body[lang])}</p><p class="hint">${icon('bell')}${t.payCal}</p><div class="sa-row">${calButtons(payFeed())}</div></div>`
          : '';
        $('contactTitle').textContent = t.contact;
        const c = data.contact;
        $('contact').innerHTML = `
          <p>${icon('pin')} ${esc(c.street)}, ${esc(c.city[lang])}</p>
          <div class="sa-row">
            <a class="btn" href="https://wa.me/${c.whatsapp}" target="_blank" rel="noopener">${icon('chat')}${t.whatsapp}</a>
            <a class="btn btn--ghost" href="tel:${c.phone}">${icon('phone')}<span dir="ltr">${esc(c.phoneDisplay)}</span></a>
            <a class="btn btn--ghost" href="${c.instagram}" target="_blank" rel="noopener">${icon('instagram')}Instagram</a>
          </div>
          <p class="hint">${t.route}</p>
          <div class="sa-row">
            <a class="btn btn--ghost" href="${c.google}" target="_blank" rel="noopener">${icon('pin')}Google Maps</a>
            <a class="btn btn--ghost" href="${c.waze}" target="_blank" rel="noopener">${icon('pin')}Waze</a>
          </div>`;
      }

      // ----- Request: private lesson or hall rental → summary → sent by email (FormSubmit) -----
      type ReqType = '' | 'private' | 'rental';
      const contactSaved = (() => { try { return JSON.parse(store.get('etude-req-contact') || '{}'); } catch { return {}; } })();
      const req = { type: '' as ReqType, name: contactSaved.name || '', phone: contactSaved.phone || '', trainer: '', length: '', pdate: '', ptime: '', date: '', from: '', to: '', hall: '', note: '' };
      let reqStep: 'form' | 'summary' = 'form';
      let reqFormLang = ''; // the form is rebuilt only when the language changes, so typing isn't lost
      let lastSent: [string, string][] = [];
      const pad = (n: number) => String(n).padStart(2, '0');
      /** Whole hours the halls can be booked, e.g. 08:00 … 21:00. */
      const hours = () => { const out: string[] = []; for (let m = toMin(data.request.opens); m <= toMin(data.request.closes); m += 60) out.push(`${pad(Math.floor(m / 60))}:${pad(m % 60)}`); return out; };
      /** Lesson start times every 30 minutes, leaving room for a 45-minute lesson before closing. */
      const halfHours = () => { const out: string[] = []; for (let m = toMin(data.request.opens); m <= toMin(data.request.closes) - 45; m += 30) out.push(`${pad(Math.floor(m / 60))}:${pad(m % 60)}`); return out; };
      const LENGTHS = ['45', '60', '90'];
      const trainerName = (id: string, l: Lang = lang) => data.request.trainers.find((x) => x.id === id)?.name[l] ?? '';
      const hallName = (i: string, l: Lang = lang) => data.request.halls[l][Number(i)] ?? '';

      function renderRequestForm() {
        const radio = (name: string, value: string, label: string, ico = '') =>
          `<label class="sa-choice"><input type="radio" name="${name}" value="${esc(value)}" ${req[name as 'type'] === value ? 'checked' : ''} required />${ico}<span dir="auto">${esc(label)}</span></label>`;
        const opts = (sel: string, list: string[]) => `<option value=""></option>` + list.map((h) => `<option ${h === sel ? 'selected' : ''}>${h}</option>`).join('');
        const hs = hours();
        $('reqForm').innerHTML = `
          <fieldset class="sa-choices sa-choices--type"><legend>${t.reqType}</legend>
            ${radio('type', 'private', t.private, icon('dance'))}${radio('type', 'rental', t.rental, icon('home'))}
            <p class="sa-err" data-err="type" hidden>${t.pickOne}</p></fieldset>
          <label class="sa-field"><span>${t.fullName}</span><input name="name" autocomplete="name" required minlength="2" value="${esc(req.name)}" /><small class="sa-err" hidden>${t.nameBad}</small></label>
          <label class="sa-field"><span>${t.phone}</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required value="${esc(req.phone)}" /><small class="sa-err" hidden>${t.phoneBad}</small></label>
          <div data-show="private" hidden>
            <fieldset class="sa-choices"><legend>${t.trainer}</legend>
              ${data.request.trainers.map((x) => radio('trainer', x.id, x.name[lang])).join('')}
              <p class="sa-err" data-err="trainer" hidden>${t.pickOne}</p></fieldset>
            <fieldset class="sa-choices sa-choices--row"><legend>${t.length}</legend>
              ${LENGTHS.map((m) => radio('length', m, `${m} ${t.min}`)).join('')}
              <p class="sa-err" data-err="length" hidden>${t.pickOne}</p></fieldset>
            <div class="sa-pair">
              <label class="sa-field"><span>${t.date}</span><input name="pdate" type="date" required min="${today()}" value="${esc(req.pdate)}" /><small class="sa-err" hidden>${t.dateBad}</small></label>
              <label class="sa-field"><span>${t.time}</span><select name="ptime" required>${opts(req.ptime, halfHours())}</select><small class="sa-err" hidden>${t.pickOne}</small></label>
            </div>
          </div>
          <div data-show="rental" hidden>
            <label class="sa-field"><span>${t.date}</span><input name="date" type="date" required min="${today()}" value="${esc(req.date)}" /><small class="sa-err" hidden>${t.dateBad}</small></label>
            <div class="sa-pair">
              <label class="sa-field"><span>${t.from}</span><select name="from" required>${opts(req.from, hs.slice(0, -1))}</select></label>
              <label class="sa-field"><span>${t.to}</span><select name="to" required>${opts(req.to, hs.slice(1))}</select></label>
            </div>
            <p class="sa-err" data-err="time" hidden>${t.toBad}</p>
            <fieldset class="sa-choices"><legend>${t.hall}</legend>
              ${data.request.halls[lang].map((h, i) => radio('hall', String(i), h)).join('')}
              <p class="sa-err" data-err="hall" hidden>${t.pickOne}</p></fieldset>
          </div>
          <label class="sa-field"><span>${t.note}</span><textarea name="note" rows="3" dir="auto">${esc(req.note)}</textarea></label>
          <button type="submit" class="btn btn--big">${t.continue}${icon('next', 'ic--flip')}</button>`;
        reqFormLang = lang;
        showReqType();
      }
      function showReqType() {
        $('reqForm').querySelectorAll<HTMLElement>('[data-show]').forEach((el) => {
          el.hidden = el.dataset.show !== req.type;
          // Hidden parts don't block sending.
          el.querySelectorAll<HTMLInputElement>('input, select').forEach((i) => (i.disabled = el.hidden));
        });
      }
      /** Checks the form, marks what's missing and focuses the first problem. */
      function validReq() {
        const f = $('reqForm') as HTMLFormElement;
        const bad: HTMLElement[] = [];
        const mark = (el: HTMLElement, ok: boolean, err?: HTMLElement | null) => {
          (err ?? el.closest('.sa-field')?.querySelector<HTMLElement>('.sa-err'))?.toggleAttribute('hidden', ok);
          if (!ok) bad.push(el);
        };
        const field = (n: string) => f.elements.namedItem(n) as HTMLInputElement;
        const errOf = (k: string) => f.querySelector<HTMLElement>(`[data-err="${k}"]`);
        mark(field('name'), req.name.trim().length >= 2);
        mark(field('phone'), (req.phone.match(/\d/g) || []).length >= 9 && /^[0-9 +()\-]+$/.test(req.phone.trim()));
        mark(f.querySelector('[name="type"]')!, !!req.type, errOf('type'));
        if (req.type === 'private') {
          mark(f.querySelector('[name="trainer"]')!, !!req.trainer, errOf('trainer'));
          mark(f.querySelector('[name="length"]')!, !!req.length, errOf('length'));
          mark(field('pdate'), !!req.pdate && req.pdate >= today());
          mark(field('ptime'), !!req.ptime);
        }
        if (req.type === 'rental') {
          mark(field('date'), !!req.date && req.date >= today());
          mark(field('from'), !!req.from && !!req.to && toMin(req.to) > toMin(req.from), errOf('time'));
          mark(f.querySelector('[name="hall"]')!, req.hall !== '', errOf('hall'));
        }
        bad[0]?.focus();
        return !bad.length;
      }
      /** The request as label/value rows — in the app's language for the screen, in English for the email. */
      function reqRows(l: Lang): [string, string][] {
        const tl = L[l];
        const rows: [string, string][] = [[tl.type, req.type === 'private' ? tl.private : tl.rental], [tl.fullName, req.name.trim()], [tl.phone, req.phone.trim()]];
        const longDate = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString(tl.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        if (req.type === 'private')
          rows.push([tl.trainerS, trainerName(req.trainer, l)], [tl.lengthS, `${req.length} ${tl.min}`], [tl.date, longDate(req.pdate)], [tl.time, req.ptime]);
        else rows.push([tl.date, longDate(req.date)], [tl.time, `${req.from}–${req.to}`], [tl.hallS, hallName(req.hall, l)]);
        if (req.note.trim()) rows.push([tl.noteS, req.note.trim()]);
        return rows;
      }
      const rowsHtml = (rows: [string, string][]) => `<dl class="sa-dl">${rows.map(([k, v]) => `<dt>${esc(k)}</dt><dd dir="auto">${esc(v)}</dd>`).join('')}</dl>`;
      const waText = () => `${t.reqTitle}\n` + reqRows(lang).map(([k, v]) => `${k}: ${v}`).join('\n');

      function renderRequest() {
        $('reqTitle').textContent = t.reqTitle;
        $('reqOnly').innerHTML = `${icon('info')}<span>${esc(t.reqOnly)}</span>`;
        if (reqFormLang !== lang) renderRequestForm();
        $('reqForm').hidden = reqStep !== 'form';
        $('reqSummary').hidden = reqStep !== 'summary';
        if (reqStep === 'summary')
          $('reqSummary').innerHTML = `<h2>${t.sumTitle}</h2>${rowsHtml(reqRows(lang))}
            <p class="sa-note">${icon('info')}<span>${esc(t.reqOnly)}</span></p>
            <p class="sa-err" id="reqErr" hidden></p>
            <div class="sa-row sa-row--end">
              <button type="button" class="btn btn--ghost" data-req="edit">${icon('edit')}${t.editReq}</button>
              <button type="button" class="btn btn--big" data-req="send">${icon('send', 'ic--flip')}${t.send}</button>
            </div>`;
        $('sent').innerHTML = `${icon('check', 'sa-done__ic')}<h1>${t.sentTitle}</h1><p>${esc(t.sentText)}</p>${lastSent.length ? `<div class="card">${rowsHtml(lastSent)}</div>` : ''}
          <div class="sa-row"><a class="btn" href="#home">${icon('home')}${t.home2}</a><button type="button" class="btn btn--ghost" data-req="new">${icon('request')}${t.newReq}</button></div>`;
      }

      $('reqForm').addEventListener('input', (e) => {
        const el = e.target as HTMLInputElement;
        if (el.name in req) (req as Record<string, string>)[el.name] = el.value;
        if (el.name === 'type') showReqType();
        el.closest('.sa-field, fieldset')?.querySelector<HTMLElement>('.sa-err')?.setAttribute('hidden', '');
        if (el.name === 'from' || el.name === 'to') $('reqForm').querySelector('[data-err="time"]')?.setAttribute('hidden', '');
      });
      $('reqForm').addEventListener('submit', (e) => {
        e.preventDefault();
        if (!validReq()) return;
        reqStep = 'summary';
        renderRequest();
        $('app').scrollTo(0, 0);
      });
      document.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-req]');
        if (!b) return;
        const act = b.dataset.req;
        if (act === 'edit') { reqStep = 'form'; renderRequest(); return; }
        if (act === 'new') { reqStep = 'form'; location.hash = '#request'; return; }
        // Send
        b.disabled = true;
        b.innerHTML = t.sending;
        const rows = reqRows('en');
        const kind = req.type === 'private' ? 'Private lesson' : 'Hall rental';
        const body: Record<string, string> = {
          _subject: `App request: ${kind} — ${req.name.trim()}`,
          _template: 'table',
          _captcha: 'false',
          ...Object.fromEntries(rows),
          'App language': lang,
        };
        try {
          const res = await fetch(data.request.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
          const out = await res.json().catch(() => ({}));
          if (!res.ok || String(out.success) !== 'true') throw new Error(out.message || res.statusText);
          store.set('etude-req-contact', JSON.stringify({ name: req.name.trim(), phone: req.phone.trim() }));
          lastSent = reqRows(lang);
          Object.assign(req, { type: '', trainer: '', length: '', pdate: '', ptime: '', date: '', from: '', to: '', hall: '', note: '' });
          reqStep = 'form';
          reqFormLang = '';
          location.hash = '#sent';
          renderRequest();
        } catch {
          renderRequest();
          const err = $('reqErr');
          err.hidden = false;
          err.innerHTML = `${esc(t.sendErr)} <a class="btn" href="https://wa.me/${data.contact.whatsapp}?text=${encodeURIComponent(waText())}" target="_blank" rel="noopener">${icon('chat')}${t.viaWa}</a>`;
        }
      });

      // ----- Pop-ups: notice (popup mode, once per version) and the payment day (once a month) -----
      function openPop(html: string) {
        const d = $('pop') as HTMLDialogElement;
        d.innerHTML = html;
        if (!d.open) d.showModal();
      }
      /** Shows the popup that's due, if any; true if one opened. */
      function maybePop() {
        if (noticeLive() && data.notice!.mode === 'popup' && store.get('etude-notice-seen') !== data.notice!.id) {
          store.set('etude-notice-seen', data.notice!.id);
          openPop(`<p class="sa-badge">${icon('megaphone')}${t.important}</p><h2 dir="auto">${esc(data.notice!.title[lang])}</h2>
            <a class="btn" href="#notice" data-close>${t.readMore}</a><button type="button" class="btn btn--ghost" data-close>${t.close}</button>`);
          return true;
        }
        const due = payDue();
        if (due && due.diff === 0 && store.get('etude-paid') !== due.iso && store.get('etude-pay-pop') !== due.iso) {
          store.set('etude-pay-pop', due.iso);
          openPop(`<p class="sa-badge sa-badge--pay">${icon('wallet')}${t.payTitle}</p><h2>${t.payDueToday}</h2><p>${esc(data.payment.body[lang])}</p>
            <button type="button" class="btn" data-paid="${due.iso}" data-close>${icon('check')}${t.paid}</button>
            <button type="button" class="btn btn--ghost" data-close>${t.close}</button>`);
          return true;
        }
        return false;
      }
      $('pop').addEventListener('click', (e) => {
        if (e.target === e.currentTarget || (e.target as HTMLElement).closest('[data-close]')) ($('pop') as HTMLDialogElement).close();
      });
      // "Invite a friend" through the phone's share menu.
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-invite]')) navigator.share?.({ text: data.invite.text[lang] }).catch(() => {});
      });
      // ----- Push notifications (OneSignal) -----
      // Its worker sits in its own scope, /student/push/, so it doesn't replace
      // the app's offline worker (/student/sw.js). iPhone allows push only in
      // the home-screen app — which is the only way this app opens anyway.
      let push: any = null; // OneSignal, once loaded on a phone that supports push
      if (data.pushAppId)
        ((window as any).OneSignalDeferred ||= []).push(async (OneSignal: any) => {
          await OneSignal.init({ appId: data.pushAppId, serviceWorkerPath: 'student/push/OneSignalSDKWorker.js', serviceWorkerParam: { scope: '/student/push/' } });
          if (!OneSignal.Notifications.isPushSupported()) return;
          push = OneSignal;
          push.User.setLanguage?.(lang);
