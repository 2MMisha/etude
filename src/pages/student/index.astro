          renderHome();
        });
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-push]')) push?.Notifications.requestPermission();
      });
      // "Already paid" hides this month's payment banner.
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-paid]');
        if (b) { store.set('etude-paid', b.dataset.paid!); renderAlerts(); }
      });

      function render() {
        document.documentElement.lang = lang;
        document.documentElement.dir = t.dir;
        document.querySelectorAll<HTMLButtonElement>('.sa-langs button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lang === lang)));
        $('codeLabel').textContent = t.code;
        $('codeBad').textContent = t.bad;
        document.querySelectorAll<HTMLAnchorElement>('#nav a').forEach((a) => (a.querySelector('b')!.textContent = t[a.dataset.go as 'home']));
        renderAlerts();
        renderHome();
        renderNews();
        renderNotice();
        renderEvents();
        renderSchedule();
        renderClasses();
        renderRequest();
        renderStudio();
        renderInstall();
        $('updated').textContent = data.updatedAt
          ? `${t.updated}: ${new Date(data.updatedAt).toLocaleString(t.locale, { dateStyle: 'medium', timeStyle: 'short' })}`
          : '';
      }

      // ----- Tabs via #hash, so the back button works -----
      const TABS = ['home', 'schedule', 'news', 'classes', 'request', 'sent', 'studio', 'notice', 'events'];
      const NAV_OF: Record<string, string> = { news: 'home', post: 'home', notice: 'home', events: 'home', event: 'home', sent: 'request' };
      function showTab() {
        const [name, id] = location.hash.slice(1).split('/');
        post = name === 'news' && id ? decodeURIComponent(id) : '';
        if (post && !data.news.some((n) => n.id === post)) post = '';
        eventId = name === 'event' && id ? decodeURIComponent(id) : '';
        if (eventId && !data.events.some((e) => e.id === eventId)) eventId = '';
        let tab = post ? 'post' : eventId ? 'event' : TABS.includes(name) ? name : 'home';
        if (tab === 'notice' && !data.notice) tab = 'home';
        if (post) renderNews();
        if (eventId) renderEvents();
        document.querySelectorAll<HTMLElement>('[data-tab]').forEach((s) => (s.hidden = s.dataset.tab !== tab));
        const navTab = NAV_OF[tab] ?? tab;
        document.querySelectorAll<HTMLAnchorElement>('#nav a').forEach((a) => a.toggleAttribute('aria-current', a.dataset.go === navTab));
        $('app').scrollTo(0, 0);
