            ${e.html[lang] ? `<div class="post__body" dir="auto">${e.html[lang]}</div>` : ''}
            <div class="sa-row"><a class="btn" href="${esc(googleCalendarUrl({ date: e.date, start: e.start || '00:00', end: e.end || '00:00', allDay: !e.start, title: e.title[lang], location: e.place || `ETUDE, ${c.street}` }))}" target="_blank" rel="noopener">${icon('calendar')}${t.addCal} (Google)</a></div>
            <div class="card">${$('eventsSub').innerHTML}</div>`
