          music: 'Музыка к занятиям', forAll: 'Для всех', bdayToday: 'Сегодня день рождения!', bdayWish: 'Поздравляем: {names}!', bdaySoon: 'Скоро день рождения',
          pushTitle: 'Уведомления от студии', pushText: 'Важные объявления, новости, мероприятия и напоминание об оплате — сразу на телефон.', pushOn: 'Включить уведомления',
