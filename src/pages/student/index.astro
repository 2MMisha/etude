      document.querySelectorAll<HTMLButtonElement>('.sa-langs button').forEach((b) =>
        b.addEventListener('click', () => { lang = b.dataset.lang as Lang; t = L[lang]; store.set('etude-lang', lang); push?.User.setLanguage?.(lang); render(); })
      );

      // ----- Code lock (the hash is remembered on this phone) -----
      async function sha256(s: string) {
        const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
        return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
      }
      function unlock() {
        $('lock').hidden = true;
        $('app').hidden = false;
        $('nav').hidden = false;
        showTab();
        if (maybePop()) return;
        if (!installed && !preview && !store.get('etude-install-seen')) setTimeout(openInstall, 1500);
      }

      // ----- "Add to home screen" -----
      // Chrome/Android offers a real install prompt; iPhone only has Safari's
      // Share → Add to Home Screen, so it gets the steps instead.
      const installed = ['standalone', 'fullscreen', 'minimal-ui'].some((m) => matchMedia(`(display-mode: ${m})`).matches) || (navigator as any).standalone === true;
      // Staff can look at the app in a browser with /student/?preview (linked from /admin/).
      const preview = new URLSearchParams(location.search).has('preview');
      const isAndroid = /Android/.test(navigator.userAgent);
      // iPadOS reports itself as a Mac with a touch screen.
      const isIos = !isAndroid && (/iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1));
      let installEvent: any = null;
      addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); installEvent = e; renderInstall(); });
      addEventListener('appinstalled', () => { ($('install') as HTMLDialogElement).close(); installEvent = null; appAdded = true; renderInstall(); });
      let appAdded = false;
      function renderInstall() {
        $('inTitle').innerHTML = `${icon('install')}${t.inTitle}`;
        $('inText').textContent = t.inText;
        $('inButton').textContent = t.inButton;
        $('inButton').hidden = !installEvent;
        $('inLater').textContent = t.inLater;
        // Steps are fixed strings from L (with <b> markup), not user content.
        $('inIos').innerHTML = t.ios.map((x) => `<li>${x}</li>`).join('');
        $('inAndroid').innerHTML = t.android.map((x) => `<li>${x}</li>`).join('');
        // Phones see their own steps; a computer sees both.
        $('inIos').hidden = !!installEvent || isAndroid;
        $('inAndroid').hidden = !!installEvent || isIos;
        // The browser-tab gate.
        $('gTitle').textContent = t.gTitle;
        $('gText').textContent = t.gText;
        $('gButton').innerHTML = `${icon('install')}${t.inButton}`;
        $('gButton').hidden = !installEvent || appAdded;
        $('gIos').innerHTML = $('inIos').innerHTML;
        $('gAndroid').innerHTML = $('inAndroid').innerHTML;
        $('gIos').hidden = $('inIos').hidden || appAdded;
        $('gAndroid').hidden = $('inAndroid').hidden || appAdded;
        $('gDone').innerHTML = `${icon('check')}<span>${t.gDone}</span>`;
        $('gDone').hidden = !appAdded;
        $('howInstall').innerHTML = `${icon('install')}${t.howInstall}`;
        $('howInstall').hidden = installed;
      }
      function openInstall() {
        renderInstall();
        store.set('etude-install-seen', '1');
        const d = $('install') as HTMLDialogElement;
        if (!d.open && !($('pop') as HTMLDialogElement).open) d.showModal();
      }
      $('inLater').addEventListener('click', () => ($('install') as HTMLDialogElement).close());
      $('howInstall').addEventListener('click', openInstall);
      $('inButton').addEventListener('click', async () => {
        if (!installEvent) return;
        installEvent.prompt();
        await installEvent.userChoice;
        installEvent = null;
        ($('install') as HTMLDialogElement).close();
      });
      // Tap on the dimmed backdrop closes it too.
      $('gButton').addEventListener('click', async () => {
        if (!installEvent) return;
        installEvent.prompt();
        await installEvent.userChoice;
      });
      $('install').addEventListener('click', (e) => { if (e.target === e.currentTarget) ($('install') as HTMLDialogElement).close(); });
      const code = $('code') as HTMLInputElement;
      code.addEventListener('input', async () => {
        code.value = code.value.replace(/\D/g, '');
        $('codeBad').hidden = true;
        if (code.value.length < 6) return;
        if ((await sha256(code.value)) === CODE) { store.set('etude-student', CODE); unlock(); }
        else { $('codeBad').hidden = false; code.select(); }
      });
      $('lock').addEventListener('submit', (e) => e.preventDefault());

      render();
      if (!installed && !preview) $('gate').hidden = false;
      else if (store.get('etude-student') === CODE) unlock();
      else { $('lock').hidden = false; code.focus(); }
      // Keep "next class" and the payment countdown right if the app stays open.
      setInterval(render, 5 * 60 * 1000);
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/student/sw.js', { scope: '/student/' }).catch(() => {});
    </script>

