---
// /student/ — the students' helper app (installable PWA, see
// public/student/manifest.webmanifest and sw.js): next class, schedule with
// search and follows (groups and student names), calendar reminders, classes,
// prices, rules, news, contacts, requests for a private lesson or a hall
// rental, an "important" notice and the monthly payment reminder.
// Not linked from the public site; noindex; behind a numeric code.
// Prices, rules, the notice and the payment reminder are edited in /admin/ ("Student app" tab).
import { createHash } from 'node:crypto';
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import '../../styles/week-grid.css';
import { getTimetable } from '../../lib/loadTimetable';
import { ALARMS, appEvents, chipsFrom, feedsFrom, paymentBody, paymentSettings, studentDays } from '../../lib/student';
import { trainersFrom } from '../../lib/trainers';
import { icon } from '../../lib/icons';
import { getPublishedNews } from '../../lib/news';
import { renderRichText } from '../../lib/richText';
import { t as tr } from '../../lib/translations';
import { ALL_LANGS, localizePath } from '../../lib/languages';
import { SITE } from '../../lib/site';
import app from '../../data/student-app.json';

// The studio code (changed in /admin/). A deterrent like /admin/'s password, not
// real protection: the page (and /data/timetable.json) is public to anyone with the link.
const CODE_SHA256 = (app as { codeSha256?: string }).codeSha256 || '096138f0929857ff2b93b50504a255bbc575eaca94cb9aadd5d8bccc31258bd7';

// "Invite a friend" message when /admin/ leaves a language empty; {link} = the website.
const INVITE_DEFAULT = {
  he: 'היי! אני רוקד/ת בסטודיו ETUDE בראשון לציון — בואו לשיעור ניסיון ונרקוד ביחד! {link}',
  en: "Hi! I dance at the ETUDE studio in Rishon LeZion — come to a trial class and let's dance together! {link}",
  ru: 'Привет! Я занимаюсь танцами в студии ETUDE в Ришон-ле-Ционе — приходи на пробное занятие, будем танцевать вместе! {link}',
};

// Requests (private lesson / hall rental) go straight to the studio's inbox.
// FormSubmit's AJAX endpoint answers with JSON, so the app stays open; the
// first request to a new address only triggers FormSubmit's activation email.
const DESTINATION = 'ETUDE Dance School, Rothschild 49, Rishon LeZion';

const REQUEST_ENDPOINT = 'https://formsubmit.co/ajax/etude.dance.il@gmail.com';

// Push notifications: the studio writes them in the OneSignal dashboard
// (onesignal.com → Messages → Push). Empty = the "Turn on" card stays hidden.
const ONESIGNAL_APP_ID = '064969bd-2602-4775-b49a-7b60231111d5';

const tt = await getTimetable();
const instructors = (await getCollection('instructors')).sort((a, b) => a.data.order - b.data.order);
const { groups, names } = chipsFrom(tt);
const payment = paymentSettings(app.payment);
// The notice: switched on and with a title (its "until" date is checked in the app, on the day).
const n = app.notice;
const notice =
  n?.active && (n.title.he || n.title.en || n.title.ru)
    ? {
        // Changes whenever the text does, so an edited notice pops up again.
        id: createHash('sha1').update(JSON.stringify(n)).digest('hex').slice(0, 10),
        mode: n.mode === 'popup' ? 'popup' : 'banner',
        until: n.until || '',
        title: Object.fromEntries(ALL_LANGS.map((l) => [l, n.title[l] || n.title.he || n.title.en || n.title.ru])),
        html: Object.fromEntries(ALL_LANGS.map((l) => [l, renderRichText(n.body[l] || n.body.he || '')])),
      }
    : null;
const news = (await getPublishedNews()).sort((a, b) => b.data.date.localeCompare(a.data.date));
const classes = Object.fromEntries(
  ALL_LANGS.map((l) => {
    const c = tr(l).classes;
    return [l, { intro: c.intro, sections: [{ title: '', items: c.categories }, { title: c.levelsTitle, items: c.levels }, { title: c.audiencesTitle, items: c.audiences }], url: localizePath(l, '/classes/') }];
  })
);
const data = {
  days: studentDays(tt),
  feeds: feedsFrom(tt).filter((f) => f.kind !== 'trainer').map((f) => ({ slug: f.slug, name: f.name })),
  groups,
  names,
  // Only to drop trainer names a student followed before the app stopped offering them.
  trainers: trainersFrom(tt).map((t) => t.name),
  alarms: ALARMS,
  siteUrl: SITE.siteUrl,
  pushAppId: ONESIGNAL_APP_ID,
  updatedAt: tt.updatedAt,
  news: news.map((n) => ({
    id: n.id,
    date: n.data.date,
    image: n.data.image,
    imageAlt: n.data.imageAlt,
    title: n.data.title,
    html: Object.fromEntries(ALL_LANGS.map((l) => [l, renderRichText(n.data.body[l] || n.data.body.he)])),
  })),
  classes,
  prices: app.prices,
  rules: app.rules,
  notice,
  events: appEvents().map(({ text: _text, body, ...e }) => ({ ...e, html: Object.fromEntries(ALL_LANGS.map((l) => [l, renderRichText(body[l])])) })),
  // Playlists by dance style → dance; dances and styles without a playlist are left out.
  music: (app.music ?? [])
    .map((st) => ({ style: st.style, dances: st.dances.filter((d) => d.links.length) }))
    .filter((st) => st.dances.length),
  birthdays: app.birthdays ?? [],
  invite: {
    active: app.invite?.active !== false,
    text: Object.fromEntries(ALL_LANGS.map((l) => [l, ((app.invite?.text as Record<string, string> | undefined)?.[l] || INVITE_DEFAULT[l]).replace('{link}', `${SITE.siteUrl}${localizePath(l, '/')}`)])),
  },
  payment: { ...payment, body: Object.fromEntries(ALL_LANGS.map((l) => [l, paymentBody(l, payment.day)])) },
  request: {
    endpoint: REQUEST_ENDPOINT,
    trainers: instructors.map((i) => ({ id: i.id, name: i.data.name })),
    halls: Object.fromEntries(ALL_LANGS.map((l) => [l, tr(l).hallRental.halls.map((h) => h.title)])),
    opens: SITE.hours.opens,
    closes: SITE.hours.closes,
  },
  contact: {
    phone: SITE.phone,
    phoneDisplay: SITE.phoneDisplay,
    whatsapp: SITE.whatsapp,
    instagram: SITE.social.instagram,
    // Directions straight to the studio, in Google Maps or Waze.
    google: `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(DESTINATION)}`,
    waze: `https://waze.com/ul?ll=${SITE.geo.lat},${SITE.geo.lng}&navigate=yes`,
    street: SITE.address.street,
    city: SITE.address.cityLocalized,
  },
};
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#17224a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ETUDE" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/student/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Heebo:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <title>ETUDE</title>
    {ONESIGNAL_APP_ID && <script is:inline src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>}
  </head>
  <body class="sa">
    <header class="sa-top">
      <img src="/images/brand/logo-full-white.svg" alt="ETUDE" width="96" height="40" />
      <div class="sa-langs" role="group" aria-label="Language">
        <button type="button" data-lang="he" lang="he">עב</button>
        <button type="button" data-lang="ru" lang="ru">RU</button>
        <button type="button" data-lang="en" lang="en">EN</button>
      </div>
    </header>

    <!-- Opened in a browser tab: the app works only from the home screen, so install it first. -->
    <section class="sa-gate" id="gate" hidden>
      <img src="/images/apple-touch-icon.png" alt="" width="88" height="88" />
      <h1 id="gTitle"></h1>
      <p id="gText"></p>
      <button type="button" class="btn btn--big" id="gButton" hidden></button>
      <ol id="gIos" hidden></ol>
      <ol id="gAndroid" hidden></ol>
      <p class="sa-note" id="gDone" hidden></p>
    </section>

    <form class="sa-lock" id="lock" hidden>
      <label for="code" id="codeLabel"></label>
      <input id="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="off" />
      <p class="sa-bad" id="codeBad" hidden></p>
    </form>

    <main class="sa-main" id="app" hidden>
      <!-- "Important" notice banner and the payment countdown, on every tab. -->
      <div class="sa-alerts" id="alerts"></div>

      <section data-tab="home">
        <h1 id="hello"></h1>
        <div id="important"></div>
        <div id="push"></div>
        <div id="bday"></div>
        <div id="next"></div>
        <div id="eventsHome"></div>
        <h2 id="newsTitle"></h2>
        <ul class="list" id="news"></ul>
        <a class="btn btn--ghost sa-more" href="#news" id="allNews"></a>
        <div id="invite"></div>
      </section>

      <section data-tab="events" hidden>
        <a class="sa-back" href="#home" id="eventsBack"></a>
        <h1 id="eventsTitle"></h1>
        <ul class="list" id="eventsAll"></ul>
        <div class="card" id="eventsSub"></div>
      </section>

      <section data-tab="event" hidden>
        <a class="sa-back" href="#events" id="eventBack"></a>
        <article class="post" id="eventPost"></article>
      </section>

      <section data-tab="news" hidden>
        <h1 id="newsAllTitle"></h1>
        <ul class="list" id="newsAll"></ul>
      </section>

      <section data-tab="post" hidden>
        <a class="sa-back" href="#news" id="back"></a>
        <article class="post" id="post"></article>
      </section>

      <section data-tab="notice" hidden>
        <a class="sa-back" href="#home" id="noticeBack"></a>
        <article class="post" id="noticePost"></article>
      </section>

      <section data-tab="schedule" hidden>
        <h1 id="schedTitle"></h1>
        <input type="search" id="q" class="sa-search" autocomplete="off" />
        <div class="chips" id="chips"></div>
        <div class="sa-row" id="mineRow"></div>
        <details class="card" id="cal" hidden>
          <summary id="calSummary"></summary>
          <p class="hint" id="calHint"></p>
          <label class="hint" for="alarm" id="alarmLabel"></label>
          <select id="alarm"></select>
          <div id="calLinks"></div>
        </details>
        <div id="days"></div>
      </section>

      <section data-tab="classes" hidden>
        <h1 id="classesTitle"></h1>
        <div id="music"></div>
        <div id="classes"></div>
        <h2 id="pricesTitle"></h2>
        <div class="card" id="prices"></div>
      </section>

      <!-- Request a private lesson or a hall rental: form → summary → sent. -->
      <section data-tab="request" hidden>
        <h1 id="reqTitle"></h1>
        <p class="sa-note" id="reqOnly"></p>
        <form class="sa-form" id="reqForm" novalidate></form>
        <div class="card sa-summary" id="reqSummary" hidden></div>
      </section>

      <section data-tab="sent" hidden>
        <div class="sa-done" id="sent"></div>
      </section>

      <section data-tab="studio" hidden>
        <h1 id="rulesTitle"></h1>
        <ol class="rules" id="rules"></ol>
        <div id="payCard"></div>
        <h2 id="contactTitle"></h2>
        <div class="card" id="contact"></div>
        <button type="button" class="btn btn--ghost sa-more" id="howInstall" hidden></button>
      </section>

      <p class="hint sa-updated" id="updated"></p>
    </main>

    <nav class="sa-nav" id="nav" hidden>
      <a href="#home" data-go="home"><Fragment set:html={icon('home')} /><b></b></a>
      <a href="#schedule" data-go="schedule"><Fragment set:html={icon('calendar')} /><b></b></a>
      <a href="#classes" data-go="classes"><Fragment set:html={icon('dance')} /><b></b></a>
      <a href="#request" data-go="request"><Fragment set:html={icon('request')} /><b></b></a>
      <a href="#studio" data-go="studio"><Fragment set:html={icon('info')} /><b></b></a>
    </nav>

    <!-- "Add to home screen" sheet: shown once after unlocking, reopenable from the Studio tab. -->
    <dialog class="sa-install" id="install">
      <h2 id="inTitle"></h2>
      <p id="inText"></p>
      <button type="button" class="btn" id="inButton" hidden></button>
      <ol id="inIos" hidden></ol>
      <ol id="inAndroid" hidden></ol>
      <button type="button" class="btn btn--ghost" id="inLater"></button>
    </dialog>

    <!-- Pop-ups: the "important" notice (popup mode) and the payment-day reminder. -->
    <dialog class="sa-install" id="pop"></dialog>

    <script type="application/json" id="sa-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    <script type="application/json" id="sa-code" set:html={JSON.stringify(CODE_SHA256)} />

    <script>
      import { weekOf, type TimetableItem } from '../../lib/timetable';
      import { fitCards, weekGrid } from '../../lib/weekGrid';
      import { icon } from '../../lib/icons';
      import { googleCalendarUrl } from '../../lib/calendar';

      type Lang = 'he' | 'en' | 'ru';
      const SHARE = '<svg class="share" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7.5 7.5 12 3l4.5 4.5M7 10H5v11h14V10h-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      const L = {
