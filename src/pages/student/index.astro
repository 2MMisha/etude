          sentTitle: 'Заявка отправлена!', sentText: 'Спасибо! Это пока только просьба — мы свяжемся с вами по телефону или в WhatsApp, чтобы подтвердить.', newReq: 'Новая заявка',
        },
      };
      const LANGS: Lang[] = ['he', 'en', 'ru'];

      type Loc = Record<Lang, string>;
      interface Data {
        days: { date: string; items: TimetableItem[] }[];
        feeds: { slug: string; name: string }[];
        groups: string[];
        names: string[];
        trainers: string[];
        alarms: number[];
        siteUrl: string;
        pushAppId: string;
        updatedAt: string;
        news: { id: string; date: string; image?: string; imageAlt?: Partial<Loc>; title: Loc; html: Loc }[];
        classes: Record<Lang, { intro: string; sections: { title: string; items: { title: string; body: string }[] }[]; url: string }>;
        prices: Record<Lang, string[]>;
        rules: Record<Lang, string[]>;
        events: { id: string; date: string; start: string; end: string; place: string; title: Loc; html: Loc }[];
        music: { style: string; dances: { name: string; links: string[] }[] }[];
        birthdays: { name: string; day: number; month: number }[];
        invite: { active: boolean; text: Loc };
        notice: { id: string; mode: 'banner' | 'popup'; until: string; title: Loc; html: Loc } | null;
        payment: { active: boolean; day: number; before: number; after: number; body: Loc };
        request: { endpoint: string; trainers: { id: string; name: Loc }[]; halls: Record<Lang, string[]>; opens: string; closes: string };
        contact: { phone: string; phoneDisplay: string; whatsapp: string; instagram: string; google: string; waze: string; street: string; city: Loc };
      }
      const data: Data = JSON.parse(document.getElementById('sa-data')!.textContent || '{}');
      const CODE: string = JSON.parse(document.getElementById('sa-code')!.textContent || '""');
      const $ = (id: string) => document.getElementById(id)!;
      const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const store = {
        get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
        set: (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} },
      };
      const STAR = icon('starFill');

      // ----- Language: saved choice → device language → Hebrew -----
      function pickLang(): Lang {
        const saved = store.get('etude-lang');
        if (LANGS.includes(saved as Lang)) return saved as Lang;
        for (const l of navigator.languages || [navigator.language]) {
          const c = l.slice(0, 2).toLowerCase();
          if (c === 'iw') return 'he';
          if (LANGS.includes(c as Lang)) return c as Lang;
          if (['uk', 'be', 'kk'].includes(c)) return 'ru';
        }
        return 'he';
      }
      let lang = pickLang();
      let t = L[lang];

      // ----- Search: groups and student names (class titles), not trainers -----
      const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').trim();
      // A student's name matches whole words only ("Ira" isn't "Kira"); anything else, any part of the title.
      const nameSet = new Set(data.names.map(norm));
      const words = (s: string) => norm(s).split(/[^\p{L}\p{N}]+/u);
      const matches = (i: TimetableItem, q: string) =>
        !q || (nameSet.has(norm(q)) ? words(i.title).includes(norm(q)) : norm(i.title).includes(norm(q)));
      // Followed searches (groups, names) — as many as the student likes.
      let follows: string[] = [];
      try { follows = JSON.parse(store.get('etude-follows') || '[]'); } catch {}
      const oldMine = store.get('etude-mine'); // the single "mine" of the first version
      if (oldMine && !follows.length) follows = [oldMine];
      // Trainers aren't offered any more: drop them from earlier follows.
      follows = follows.filter((f) => !data.trainers.some((n) => norm(n) === norm(f)));
      const saveFollows = () => store.set('etude-follows', JSON.stringify(follows));
      const isFollowed = (q: string) => follows.some((f) => norm(f) === norm(q));
      const matchesAny = (i: TimetableItem) => follows.some((f) => matches(i, f));
      let mineView = follows.length > 0; // schedule shows all followed classes together
      let query = '';
      let post = ''; // id of the news post open in the app
      let alarm = Number(store.get('etude-alarm') ?? 60);
      if (!data.alarms.includes(alarm)) alarm = 60;

      const isoOf = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const today = () => weekOf(new Date())[new Date().getDay()];
      const nowMin = () => new Date().getHours() * 60 + new Date().getMinutes();
      const toMin = (hhmm: string) => { const [h, m] = hhmm.split(':').map(Number); return h * 60 + m; };
      /** Upcoming days (from today) with the items still ahead that pass the filter. */
      function upcoming(keep: (i: TimetableItem) => boolean) {
        const d0 = today();
        return data.days
          .filter((d) => d.date >= d0)
          .map((d) => ({ date: d.date, items: d.items.filter((i) => keep(i) && (d.date > d0 || toMin(i.end) > nowMin())) }))
          .filter((d) => d.items.length);
      }
      function dayName(iso: string) {
        if (iso === today()) return t.today;
        const tm = new Date(); tm.setDate(tm.getDate() + 1);
        if (iso === weekOf(tm)[tm.getDay()]) return t.tomorrow;
        return new Date(`${iso}T12:00:00`).toLocaleDateString(t.locale, { weekday: 'long', day: 'numeric', month: 'short' });
      }
      const itemHtml = (i: TimetableItem) => `
        <li class="ev">
          <span class="ev__time" dir="ltr">${i.start}–${i.end}</span>
          <span class="ev__title" dir="auto">${esc(i.title)}</span>
          <span class="ev__who" dir="auto">${esc([i.column, i.hall && i.hall !== i.column ? i.hall : ''].filter(Boolean).join(' · '))}</span>
        </li>`;

      // ----- "Important" notice (edited in /admin/) -----
      const noticeLive = () => !!data.notice && (!data.notice.until || today() <= data.notice.until);

      // ----- Monthly payment reminder: banner from `before` days ahead to `after` days past the due day -----
      const ordinal = (n: number) => `${n}${[11, 12, 13].includes(n % 100) ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] ?? 'th'}`;
      /** The due date in range of today, and how many days away it is (negative = past). */
      function payDue() {
        const p = data.payment;
        if (!p.active) return null;
        const now = new Date();
        const d0 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        for (const m of [0, 1, -1]) {
          const due = new Date(now.getFullYear(), now.getMonth() + m, p.day);
          const diff = Math.round((due.getTime() - d0.getTime()) / 86400000);
          if (diff <= p.before && diff >= -p.after) return { iso: isoOf(due), diff };
        }
        return null;
      }
      const payFeed = () => `${data.siteUrl}/student/cal/pay-${lang}.ics`;
      const calButtons = (https: string) => {
        const webcal = https.replace(/^https:/, 'webcal:');
        return `<a class="btn" href="${webcal}">${icon('calendar')}${t.apple}</a>
          <a class="btn btn--ghost" href="https://calendar.google.com/calendar/render?cid=${encodeURIComponent(webcal)}" target="_blank" rel="noopener">${t.google}</a>`;
      };

      function renderAlerts() {
        let html = '';
        if (noticeLive() && data.notice!.mode === 'banner')
          html += `<a class="sa-alert sa-alert--notice" href="#notice">${icon('megaphone')}<span><small>${t.important}</small><b dir="auto">${esc(data.notice!.title[lang])}</b></span>${icon('next', 'ic--flip')}</a>`;
        const due = payDue();
        if (due && store.get('etude-paid') !== due.iso) {
          const n = Math.abs(due.diff);
          const timer = due.diff === 0
            ? `<div class="sa-timer sa-timer--today"><b>${t.payToday}</b></div>`
            : `<div class="sa-timer"><small>${due.diff > 0 ? t.payLeft : t.payAgo}</small><b>${n}</b><small>${t.days(n)}</small></div>`;
          const line = due.diff > 0 ? t.payDue.replace('{day}', lang === 'en' ? ordinal(data.payment.day) : String(data.payment.day)) : due.diff === 0 ? t.payDueToday : t.payLate;
          html += `<div class="sa-alert sa-alert--pay${due.diff < 0 ? ' is-late' : ''}">${icon('wallet')}<span><b>${t.payTitle}</b><small>${esc(line)}</small>
            <button type="button" class="sa-link" data-paid="${due.iso}">${icon('check')}${t.paid}</button></span>${timer}</div>`;
        }
        $('alerts').innerHTML = html;
      }

      // ----- Events, music -----
      /** "Spotify", "YouTube"… for a playlist link. */
      const service = (u: string) => {
        const h = u.replace(/^https?:\/\/(www\.|m\.|music\.|open\.)?/, '').split('/')[0];
        return h.includes('spotify') ? 'Spotify' : /youtu/.test(h) ? 'YouTube' : h.includes('apple') ? 'Apple Music' : h.includes('yandex') ? 'Яндекс Музыка' : h.includes('deezer') ? 'Deezer' : h.includes('soundcloud') ? 'SoundCloud' : h;
      };
      const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
      const upcomingEvents = () => data.events.filter((e) => e.date >= today());
      const evWhen = (e: Data['events'][number]) =>
        `${cap(new Date(`${e.date}T12:00:00`).toLocaleDateString(t.locale, { weekday: 'short', day: 'numeric', month: 'long' }))} · ${e.start ? `<span dir="ltr">${e.start}${e.end ? `–${e.end}` : ''}</span>` : t.allDay}`;
      const eventItem = (e: Data['events'][number]) =>
        `<li><a class="sa-ev" href="#event/${encodeURIComponent(e.id)}">${icon('trophy')}<span><b dir="auto">${esc(e.title[lang])}</b><span class="hint">${evWhen(e)}</span></span></a></li>`;

      // ----- Rendering -----
      function renderHome() {
        $('hello').innerHTML = `${esc(t.hello)} ${icon('hand')}`;
        // A popup notice stays reachable from the home screen after it's closed.
        $('important').innerHTML = noticeLive() && data.notice!.mode === 'popup'
          ? `<a class="sa-alert sa-alert--notice" href="#notice">${icon('megaphone')}<span><small>${t.important}</small><b dir="auto">${esc(data.notice!.title[lang])}</b></span>${icon('next', 'ic--flip')}</a>`
          : '';
        // Until the student answers the phone's "Allow notifications?" question.
        $('push').innerHTML = push && Notification.permission === 'default'
          ? `<div class="card sa-invite">${icon('bell')}<div><h2>${t.pushTitle}</h2><p>${t.pushText}</p>
              <div class="sa-row"><button type="button" class="btn" data-push>${icon('bell')}${t.pushOn}</button></div></div></div>`
          : '';
        const nextHtml = (keep: (i: TimetableItem) => boolean) => {
          const next = upcoming(keep)[0];
          return next
            ? `<p class="day">${esc(dayName(next.date))}</p><ul class="evs">${itemHtml(next.items[0])}</ul>`
            : `<p class="hint">${t.noNext}</p>`;
        };
        $('next').innerHTML = follows.length
          ? `<div class="sa-head"><h2>${t.myClasses}</h2><a href="#schedule" data-mine-view>${icon('edit')}${t.edit}</a></div>` +
            follows.map((f) => `<div class="card"><h3 class="follow" dir="auto">${STAR}${esc(f)}</h3>${nextHtml((i) => matches(i, f))}</div>`).join('')
          : `<div class="card"><h2>${t.nextAll}</h2>${nextHtml(() => true)}<p class="hint">${t.pickMine}</p><a class="btn" href="#schedule">${icon('star')}${t.choose}</a></div>`;
        // Birthdays: today's, and the next 7 days.
        const now = new Date();
        const inDays = (n: number) => new Date(now.getFullYear(), now.getMonth(), now.getDate() + n);
        const bdays = (d: Date) => data.birthdays.filter((b) => b.day === d.getDate() && b.month === d.getMonth() + 1).map((b) => b.name);
        const todays = bdays(now);
        const soon = [1, 2, 3, 4, 5, 6, 7].flatMap((n) => bdays(inDays(n)).map((name) => ({ name, d: inDays(n) })));
        $('bday').innerHTML =
          (todays.length ? `<div class="card sa-bday">${icon('cake')}<div><h2>${t.bdayToday}</h2><p dir="auto">${esc(t.bdayWish.replace('{names}', todays.join(', ')))}</p></div></div>` : '') +
          (soon.length ? `<div class="card sa-soon"><h3 class="sa-soon__t">${icon('cake')}${t.bdaySoon}</h3><ul>${soon.map((b) => `<li><b dir="auto">${esc(b.name)}</b><span class="hint">${esc(dayName(isoOf(b.d)))}</span></li>`).join('')}</ul></div>` : '');
        const evs = upcomingEvents();
        $('eventsHome').innerHTML = evs.length
          ? `<div class="sa-head"><h2>${t.events}</h2>${evs.length > 3 ? `<a href="#events">${t.allEvents}</a>` : ''}</div><ul class="list">${evs.slice(0, 3).map(eventItem).join('')}</ul>`
          : '';
        $('invite').innerHTML = data.invite.active
          ? `<div class="card sa-invite">${icon('invite')}<div><h2>${t.invite}</h2><p>${t.inviteText}</p>
              <div class="sa-row"><a class="btn" href="https://wa.me/?text=${encodeURIComponent(data.invite.text[lang])}" target="_blank" rel="noopener">${icon('chat')}${t.whatsapp}</a>
              ${'share' in navigator ? `<button type="button" class="btn btn--ghost" data-invite>${icon('share')}${t.share}</button>` : ''}</div></div></div>`
          : '';
        $('newsTitle').textContent = t.news;
        $('news').innerHTML = data.news.slice(0, 3).map(newsItem).join('');
        $('allNews').hidden = data.news.length <= 3;
        $('allNews').textContent = t.allNews;
      }

      const fmtDate = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString(t.locale, { dateStyle: 'medium' });
      const newsItem = (n: Data['news'][number]) =>
        `<li><a href="#news/${encodeURIComponent(n.id)}"><b dir="auto">${esc(n.title[lang] || n.title.he)}</b><span class="hint">${fmtDate(n.date)}</span></a></li>`;

      function renderNews() {
        $('newsAllTitle').textContent = t.news;
        $('newsAll').innerHTML = data.news.map(newsItem).join('');
        $('back').innerHTML = `${icon('back', 'ic--flip')}${t.back}`;
        const n = data.news.find((x) => x.id === post);
        // The body is already safe HTML (renderRichText escapes everything it doesn't format).
        $('post').innerHTML = n
          ? (n.image ? `<img src="${esc(n.image)}" alt="${esc(n.imageAlt?.[lang] || '')}" loading="lazy" />` : '') +
            `<p class="hint">${fmtDate(n.date)}</p><h1 dir="auto">${esc(n.title[lang] || n.title.he)}</h1><div class="post__body" dir="auto">${n.html[lang]}</div>`
