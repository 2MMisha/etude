      let eventId = ''; // id of the event open in the app
      function renderEvents() {
        $('eventsBack').innerHTML = `${icon('back', 'ic--flip')}${t.home}`;
        $('eventBack').innerHTML = `${icon('back', 'ic--flip')}${t.events}`;
        $('eventsTitle').textContent = t.events;
        $('eventsAll').innerHTML = upcomingEvents().map(eventItem).join('');
