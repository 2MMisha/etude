---
// ETUDE brand book — /brand/. For designers, printers and the owner.
// Not linked anywhere, noindex, excluded from the sitemap and robots.txt.
// Logo files live in public/brand/logos (SVG + PNG + PDF per variant); the PDF
// of this page (public/brand/etude-brandbook.pdf) is printed from it in Chrome
// (A4 landscape, see the @page rule below).
import { readdirSync } from 'node:fs';
import '../styles/global.css';
import { PHOTOS } from '../data/photos';

const VERSION = 'Version 1.0 · October 2026';
const L = '/brand/logos/';

// Every logo variant on disk, grouped by base name (logo-full, logo-full-white, …)
const files = readdirSync('public/brand/logos');
const COLOR_ORDER = ['', '-white', '-navy', '-black'];
const colorOf = (n: string) => COLOR_ORDER.findLastIndex((c) => c && n.endsWith(c)) + 1 || 0;
const baseOf = (n: string) => n.replace(/-(white|navy|black)$/, '');
const variants = files
  .filter((f) => f.endsWith('.svg') && f !== 'pattern-tile.svg')
  .map((f) => f.slice(0, -4))
  .sort((a, b) => baseOf(a).localeCompare(baseOf(b)) || colorOf(a) - colorOf(b));
const formats = (n: string) => ['svg', 'png', 'pdf'].filter((ext) => files.includes(`${n}.${ext}`));

const LOCKUPS = [
  { id: 'logo-full', name: 'Primary: ETUDE + Dance School, stacked', use: 'Default for everything: flyers, signs, certificates, apparel back prints.', primary: true },
  { id: 'logo-line', name: 'Horizontal: ETUDE + Dance School, one line', use: 'Wide, low spaces: entrance sign, banner headers, email/website headers.' },
  { id: 'logo', name: 'Wordmark: ETUDE', use: 'When "Dance School" is said nearby or is too small to read: left-chest embroidery, medals, small print.' },
  { id: 'logo-full-cursive', name: 'Cursive + tagline', use: 'Soft, celebratory pieces: recital programs, greeting cards, certificates. Not below 45 mm wide.' },
  { id: 'logo-line-cursive', name: 'Cursive, one line', use: 'Secondary horizontal option for the same soft pieces.' },
  { id: 'icon', name: 'Monogram: E', use: 'Favicons, stamps, small engravings, watermark, pattern accents. Never as the only identifier on a first-contact piece.' },
];
const LOCAL = [
  { id: 'logo-full-he', name: 'ETUDE + Hebrew descriptor', use: 'Preferred for Hebrew materials: keeps the recognizable wordmark.' },
  { id: 'logo-full-ru', name: 'ETUDE + Russian descriptor', use: 'Preferred for Russian materials.' },
  { id: 'logo-name-he', name: 'אטיוד, Hebrew name', use: 'Hebrew-only pieces where the Latin name would feel foreign: local notices, municipal events.' },
  { id: 'logo-name-ru', name: 'Этюд, Russian name', use: 'Russian-only pieces for the Russian-speaking community.' },
];

const COLORS = [
  { name: 'ETUDE Blue', token: '--color-blue-600', hex: '#2F4B9B', rgb: '47 75 155', cmyk: '88 70 0 4', pms: '7685 C', role: 'The brand color. Logo, headings, links, key accents.', dark: true },
  { name: 'Midnight Navy', token: '--color-navy-900', hex: '#17224A', rgb: '23 34 74', cmyk: '100 90 30 45', pms: '2767 C', role: 'Dark backgrounds, primary buttons, garments, sign panels.', dark: true },
  { name: 'Navy 800', token: '--color-navy-800', hex: '#1F2D5E', rgb: '31 45 94', cmyk: '100 85 25 30', pms: '2766 C', role: 'Hover/pressed states, depth on navy.', dark: true },
  { name: 'Navy 700', token: '--color-navy-700', hex: '#283A78', rgb: '40 58 120', cmyk: '95 80 10 15', pms: '7687 C', role: 'Gradients between navy and blue.', dark: true },
  { name: 'Soft Blue', token: '--color-blue-500', hex: '#5570B8', rgb: '85 112 184', cmyk: '72 52 0 0', pms: '7683 C', role: 'Brush-stroke underline, focus rings, secondary accents.', dark: true },
  { name: 'Mist', token: '--color-blue-100', hex: '#E6EBF7', rgb: '230 235 247', cmyk: '8 4 0 0', pms: '656 C', role: 'Tinted panels, table stripes, light backgrounds.' },
];
const NEUTRALS = [
  { name: 'Ink', hex: '#1B2132', rgb: '27 33 50', cmyk: '80 70 45 60', role: 'Body text.' , dark: true},
  { name: 'Ink Soft', hex: '#4A5367', rgb: '74 83 103', cmyk: '70 58 38 25', role: 'Secondary text, captions.', dark: true },
  { name: 'Silver 300', hex: '#D3D8E4', rgb: '211 216 228', cmyk: '17 10 4 0', role: 'Borders, dividers.' },
  { name: 'Silver 100', hex: '#F0F2F7', rgb: '240 242 247', cmyk: '5 3 1 0', role: 'Quiet panels, ghost buttons.' },
  { name: 'Ground', hex: '#F7F8FB', rgb: '247 248 251', cmyk: '2 1 0 0', role: 'Page background on screen.' },
  { name: 'White', hex: '#FFFFFF', rgb: '255 255 255', cmyk: '0 0 0 0', role: 'Paper, cards, logo on dark.' },
];
const CONTRAST = [
  ['#2F4B9B', '#FFFFFF', '8.1 : 1', 'Any size'],
  ['#17224A', '#FFFFFF', '15.4 : 1', 'Any size'],
  ['#FFFFFF', '#2F4B9B', '8.1 : 1', 'Any size'],
  ['#2F4B9B', '#E6EBF7', '6.8 : 1', 'Any size'],
  ['#FFFFFF', '#5570B8', '4.8 : 1', 'Text ≥ 14 pt only'],
  ['#2F4B9B', '#17224A', '1.9 : 1', 'Never for text or logo'],
];

const photoList = [PHOTOS.standardCouple, PHOTOS.latinCouple, PHOTOS.teacherWithStudent, PHOTOS.girlGold, PHOTOS.kidsGroup, PHOTOS.redDress];

const TEE = 'M60 20 L35 30 L5 60 L25 85 L45 72 L45 190 L155 190 L155 72 L175 85 L195 60 L165 30 L140 20 Q100 45 60 20 Z';
const ROLL = 'M4 26 C 90 8, 170 34, 250 22 S 420 6, 500 20 S 575 30, 596 14';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>ETUDE Brand Book</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&family=Heebo:wght@400;500;600;700&family=Marck+Script&family=Gveret+Levin&display=swap"
    />
  </head>
  <body>
    <!-- Cover -->
    <section class="cover page">
      <div class="cover__pattern" aria-hidden="true"></div>
      <div class="cover__inner">
        <img class="cover__logo" src={`${L}logo-full-white.svg`} alt="ETUDE Dance School" />
        <h1 class="cover__title">Brand book</h1>
        <p class="cover__meta">{VERSION} · Ballroom &amp; Latin Dance School · Rothschild 49, Rishon LeZion</p>
        <div class="cover__links no-print">
          <a class="btn btn--light" href="/brand/etude-brandbook.pdf" download>Download PDF</a>
          <a class="btn btn--outline" href="/brand/etude-logo-pack.zip" download>Logo pack (ZIP)</a>
        </div>
      </div>
    </section>

    <nav class="toc page-body no-print" aria-label="Contents">
      <ol>
        <li><a href="#logo">Logo</a></li>
        <li><a href="#color">Color</a></li>
        <li><a href="#type">Typography</a></li>
        <li><a href="#voice">Voice &amp; taglines</a></li>
        <li><a href="#photo">Photography</a></li>
        <li><a href="#graphics">Graphic elements</a></li>
        <li><a href="#print">Print</a></li>
        <li><a href="#files">Files &amp; contacts</a></li>
      </ol>
    </nav>

    <!-- 1. Logo -->
    <section id="logo" class="page page-body">
      <header class="sec-head"><span class="sec-num">01</span><h2>Logo</h2></header>
      <p class="lead">
        The ETUDE logo is hand-lettered brush artwork in one color. It is not typed in a font. Always use the supplied files and never
        retype, redraw or rearrange it.
      </p>
      <div class="primary">
        <div class="tile tile--hero"><img src={`${L}logo-full.svg`} alt="Primary ETUDE logo" /></div>
        <div>
          <h3>Primary logo</h3>
          <p>ETUDE + Dance School, stacked. If a brief does not say which version to use, use this one, in ETUDE Blue on white or in white on navy.</p>
          <p class="file">logo-full.svg / .png / .pdf</p>
        </div>
      </div>

      <h3 class="sub">The family</h3>
      <div class="grid3">
        {LOCKUPS.filter((l) => !l.primary).map((l) => (
          <figure class="lock">
            <div class="tile"><img src={`${L}${l.id}.svg`} alt={l.name} /></div>
            <figcaption><strong>{l.name}</strong><span>{l.use}</span><code>{l.id}</code></figcaption>
          </figure>
        ))}
        <figure class="lock">
          <div class="tile"><img src={`${L}avatar.svg`} alt="Round avatar" class="avatar" /></div>
          <figcaption><strong>Round avatar</strong><span>Profile picture for Instagram, WhatsApp, Google Business Profile. Upload the PNG.</span><code>avatar</code></figcaption>
        </figure>
      </div>
    </section>

    <section class="page page-body">
      <h3 class="sub">Hebrew &amp; Russian versions</h3>
      <p>
        Two kinds. <strong>ETUDE + translated descriptor</strong> is preferred because it keeps one recognizable mark across all three languages.{' '}
        <strong>Fully localized names</strong> are for pieces that are entirely in Hebrew or Russian. The brush capitals exist only in Latin, so the
        localized names are set in the script faces that pair with the logo: Gveret Levin (Hebrew) and Marck Script (Russian).
      </p>
      <div class="grid4">
        {LOCAL.map((l) => (
          <figure class="lock">
            <div class="tile"><img src={`${L}${l.id}.svg`} alt={l.name} /></div>
            <figcaption><strong>{l.name}</strong><span>{l.use}</span><code>{l.id}</code></figcaption>
          </figure>
        ))}
      </div>

      <h3 class="sub">Color versions</h3>
      <div class="grid4">
        <figure class="lock"><div class="tile"><img src={`${L}logo-full.svg`} alt="" /></div><figcaption><strong>Blue</strong><span>Default on white and light backgrounds.</span></figcaption></figure>
        <figure class="lock"><div class="tile tile--navy"><img src={`${L}logo-full-white.svg`} alt="" /></div><figcaption><strong>White</strong><span>On navy, blue and dark photos.</span></figcaption></figure>
        <figure class="lock"><div class="tile"><img src={`${L}logo-full-navy.svg`} alt="" /></div><figcaption><strong>Navy</strong><span>One-color print where blue is not available, e.g. on silver or cream stock.</span></figcaption></figure>
        <figure class="lock"><div class="tile"><img src={`${L}logo-full-black.svg`} alt="" /></div><figcaption><strong>Black</strong><span>B&amp;W print, stamps, laser engraving, newspaper ads.</span></figcaption></figure>
      </div>
      <p class="note">Every logo comes in blue, white, navy and black: add <code>-white</code>, <code>-navy</code> or <code>-black</code> to the file name.</p>
    </section>

    <section class="page page-body">
      <div class="two">
        <div>
          <h3 class="sub">Clear space</h3>
          <div class="tile tile--space">
            <div class="space-box"><img src={`${L}logo-full.svg`} alt="" /></div>
          </div>
          <p>Keep empty space around the logo on all sides equal to <strong>X = half the height of the "E"</strong>. No text, photo edge or other logo may enter this zone.</p>
        </div>
        <div>
          <h3 class="sub">Minimum size</h3>
          <table class="specs">
            <thead><tr><th>Version</th><th>Print</th><th>Screen</th></tr></thead>
            <tbody>
              <tr><td>Primary (stacked)</td><td>30 mm wide</td><td>120 px</td></tr>
              <tr><td>Horizontal</td><td>40 mm wide</td><td>160 px</td></tr>
              <tr><td>Wordmark ETUDE</td><td>20 mm wide</td><td>80 px</td></tr>
              <tr><td>Cursive + tagline</td><td>45 mm wide</td><td>180 px</td></tr>
              <tr><td>Monogram E</td><td>6 mm tall</td><td>16 px</td></tr>
              <tr><td>Embroidery (any)</td><td colspan="2">Descriptor letters ≥ 5 mm tall; otherwise use the wordmark alone</td></tr>
            </tbody>
          </table>
          <h3 class="sub">Backgrounds</h3>
          <ul class="ticks">
            <li>White, Ground, Mist → blue logo.</li>
            <li>Navy, ETUDE Blue → white logo.</li>
            <li>Photos → white logo on a calm, dark area, or on a navy band. Never on faces or busy detail.</li>
          </ul>
        </div>
      </div>

      <h3 class="sub">Don'ts</h3>
      <div class="donts">
        <figure><div class="tile"><img src={`${L}logo.svg`} alt="" style="transform:scaleX(1.5)" /></div><figcaption>Don't stretch or squash</figcaption></figure>
        <figure><div class="tile"><img src={`${L}logo.svg`} alt="" style="filter:hue-rotate(140deg) saturate(2)" /></div><figcaption>Don't recolor (blue, navy, white or black only)</figcaption></figure>
        <figure><div class="tile"><img src={`${L}logo.svg`} alt="" style="filter:drop-shadow(6px 6px 3px rgba(0,0,0,.6))" /></div><figcaption>No shadows, glows or outlines</figcaption></figure>
        <figure><div class="tile"><img src={`${L}logo.svg`} alt="" style="transform:rotate(-14deg)" /></div><figcaption>Don't rotate</figcaption></figure>
        <figure><div class="tile"><span class="fake">ETUDE</span></div><figcaption>Don't retype ETUDE in any font</figcaption></figure>
        <figure><div class="tile tile--busy"><img src={`${L}logo.svg`} alt="" /></div><figcaption>Not on busy or low-contrast backgrounds</figcaption></figure>
      </div>
    </section>

    <!-- 2. Color -->
    <section id="color" class="page page-body">
      <header class="sec-head"><span class="sec-num">02</span><h2>Color</h2></header>
      <p class="lead">One blue family, plus quiet neutrals. ETUDE Blue carries the brand and navy gives it depth. There are no other brand colors.</p>
      <div class="swatches">
        {COLORS.map((c) => (
          <div class="sw">
            <div class="sw__chip" style={`background:${c.hex}`}><span class:list={[{ light: c.dark }]}>{c.name}</span></div>
            <dl>
              <dt>HEX</dt><dd>{c.hex}</dd>
              <dt>RGB</dt><dd>{c.rgb}</dd>
              <dt>CMYK</dt><dd>{c.cmyk}</dd>
              <dt>Pantone</dt><dd>{c.pms}</dd>
            </dl>
            <p>{c.role}</p>
          </div>
        ))}
      </div>
      <div class="swatches swatches--small">
        {NEUTRALS.map((c) => (
          <div class="sw">
            <div class="sw__chip" style={`background:${c.hex}`}><span class:list={[{ light: c.dark }]}>{c.name}</span></div>
            <dl><dt>HEX</dt><dd>{c.hex}</dd><dt>RGB</dt><dd>{c.rgb}</dd><dt>CMYK</dt><dd>{c.cmyk}</dd></dl>
            <p>{c.role}</p>
          </div>
        ))}
      </div>
      <p class="note">
        CMYK and Pantone values are calculated matches, not printer-confirmed. Ask for a printed proof against ETUDE Blue (#2F4B9B) on the
        first job and record the confirmed values here.
      </p>
    </section>

    <section class="page page-body">
      <div class="two">
        <div>
          <h3 class="sub">Proportions</h3>
          <div class="ratio" aria-label="Color proportions">
            <span style="flex:60;background:#fff">White / Ground 60%</span>
            <span style="flex:25;background:#17224A;color:#fff">Navy 25%</span>
            <span style="flex:12;background:#2F4B9B;color:#fff">Blue 12%</span>
            <span style="flex:3;background:#5570B8"></span>
          </div>
          <p>Mostly white and calm. Navy for weight, ETUDE Blue for the logo and headings, Soft Blue only as a small accent.</p>
          <h3 class="sub">Screen-only colors</h3>
          <p>These appear in the website and the studio TV for functions only. They are not brand colors and are never used in print:</p>
          <ul class="chips">
            <li><i style="background:#FFB547"></i>Amber #FFB547: hall rentals on the TV schedule</li>
            <li><i style="background:#25D366"></i>WhatsApp green #25D366: WhatsApp buttons</li>
            <li><i style="background:#B3261E"></i>Error red #B3261E: form errors</li>
          </ul>
        </div>
        <div>
          <h3 class="sub">Readable pairs</h3>
          <table class="specs contrast">
            <thead><tr><th>Sample</th><th>Contrast</th><th>Use for</th></tr></thead>
            <tbody>
              {CONTRAST.map(([fg, bg, ratio, use]) => (
                <tr><td><span class="pair" style={`color:${fg};background:${bg}`}>Aa ETUDE</span></td><td>{ratio}</td><td>{use}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="note">WCAG AA needs 4.5 : 1 for normal text. All pairs above pass except blue on navy.</p>
        </div>
      </div>
    </section>

    <!-- 3. Typography -->
    <section id="type" class="page page-body">
      <header class="sec-head"><span class="sec-num">03</span><h2>Typography</h2></header>
      <p class="lead">
        Brush lettering for headlines echoes the hand-lettered logo, and a clean geometric sans keeps everything else easy to read. Each script
        (Latin, Cyrillic, Hebrew) has its own brush face.
      </p>
      <div class="type-grid">
        <div class="spec">
          <p class="spec__sample" style="font-family:'Another Shabby'">Learn to dance</p>
          <h3>Another Shabby</h3>
          <p>Headlines, Latin. One weight (Regular). By Zetafonts. A commercial license is required: <a href="https://www.zetafonts.com/another-shabby">zetafonts.com</a> · <a href="https://fontspring.com/fonts/zetafonts/another-shabby">Fontspring</a>.</p>
        </div>
        <div class="spec">
          <p class="spec__sample" style="font-family:'Marck Script'">Учитесь танцевать</p>
          <h3>Marck Script</h3>
          <p>Headlines, Cyrillic. One weight. Free for commercial use (SIL Open Font License): <a href="https://fonts.google.com/specimen/Marck+Script">Google Fonts</a>.</p>
        </div>
        <div class="spec" dir="rtl">
          <p class="spec__sample" style="font-family:'Gveret Levin'" lang="he">ללמוד לרקוד</p>
          <h3 dir="ltr">Gveret Levin</h3>
          <p dir="ltr">Headlines, Hebrew. One weight. Free for commercial use (OFL): <a href="https://fonts.google.com/specimen/Gveret+Levin">Google Fonts</a>.</p>
        </div>
        <div class="spec">
          <p class="spec__sample spec__sample--sans">Group &amp; private lessons</p>
          <h3>Montserrat</h3>
          <p>Body text, subheads, buttons, numbers, Latin + Cyrillic. 400 Regular, 600 SemiBold, 700 Bold. 300 Light only for the logo tagline. OFL: <a href="https://fonts.google.com/specimen/Montserrat">Google Fonts</a>.</p>
        </div>
        <div class="spec" dir="rtl">
          <p class="spec__sample spec__sample--sans" style="font-family:Heebo" lang="he">שיעורים קבוצתיים ופרטיים</p>
          <h3 dir="ltr">Heebo</h3>
          <p dir="ltr">Body text, Hebrew. 400 / 500 / 700. OFL: <a href="https://fonts.google.com/specimen/Heebo">Google Fonts</a>.</p>
        </div>
        <div class="spec">
          <p class="spec__sample spec__sample--sans">Arial · Arial Hebrew</p>
          <h3>Fallback</h3>
          <p>Only where the brand fonts cannot be installed (Word, email). Never substitute another script font for the brush faces. Use Montserrat or Arial instead.</p>
        </div>
      </div>
    </section>

    <section class="page page-body">
      <h3 class="sub">Hierarchy</h3>
      <div class="hier">
        <div><span class="hier__tag">H1 · brush · 48–72 pt</span><p class="h-demo h-demo--1">Dancing is for everyone</p></div>
        <div><span class="hier__tag">H2 · brush · 28–40 pt</span><p class="h-demo h-demo--2">Ballroom &amp; Latin</p></div>
        <div><span class="hier__tag">Eyebrow · Montserrat 600 · 11–13 pt · Blue</span><p class="h-demo h-demo--eyebrow">Rishon LeZion · Rothschild 49</p></div>
        <div><span class="hier__tag">Body · Montserrat 400 · 9–11 pt · Ink · line height 1.5–1.6</span><p class="h-demo h-demo--body">Group and private lessons in ballroom and Latin dance, for every age and level: from your first step to the dance floor.</p></div>
        <div><span class="hier__tag">Button / CTA · Montserrat 600</span><p><span class="btn-demo">Write to us on WhatsApp</span></p></div>
      </div>
      <h3 class="sub">Rules</h3>
      <ul class="ticks two-col">
        <li>Brush faces are for headlines only, at 24 pt / 28 px and up. Never for paragraphs, prices, dates or small print.</li>
        <li>Brush faces have one weight. Never apply bold or italic to them, and never set them in ALL CAPS or letter-spaced.</li>
        <li>Numbers, times and phone numbers are always set in Montserrat or Heebo.</li>
        <li>Hebrew text runs right-to-left and is aligned right. Set Hebrew body text about 5% larger than Latin, with more line height.</li>
        <li>Gveret Levin's tall letters (ל) need extra line height (about 1.25) so they don't touch the line above.</li>
        <li>Mixed-language pieces use the face that matches each script: never Latin brush letters on Hebrew text or the reverse.</li>
      </ul>
    </section>

    <!-- 4. Voice -->
    <section id="voice" class="page page-body">
      <header class="sec-head"><span class="sec-num">04</span><h2>Voice &amp; taglines</h2></header>
      <p class="lead">
        <strong>Warm and welcoming first.</strong> ETUDE talks like a good teacher at the studio door: friendly, encouraging, never intimidating.
        Then we turn up one of three dials, depending on the piece.
      </p>
      <div class="dials">
        <div class="dial dial--base"><h3>Warm &amp; welcoming</h3><p class="dial__when">Always: the base</p><p>"Everyone starts somewhere. Come try a class."</p></div>
        <div class="dial"><h3>Elegant &amp; classic</h3><p class="dial__when">Recitals, certificates, ballroom, invitations</p><p>"An evening of ballroom and Latin, danced by our students."</p></div>
        <div class="dial"><h3>Energetic &amp; fun</h3><p class="dial__when">Party master classes, Latin, social media</p><p>"Bachelorette? Team day? Let's get the whole group dancing."</p></div>
        <div class="dial"><h3>Expert &amp; precise</h3><p class="dial__when">Instructors, competitions, technique</p><p>"Coached by world-ranked dancers, step by step."</p></div>
      </div>

      <h3 class="sub">Names &amp; lines in three languages</h3>
      <table class="specs langs">
        <thead><tr><th></th><th>English</th><th>עברית</th><th>Русский</th></tr></thead>
        <tbody>
          <tr><th>Name in text</th><td>ETUDE</td><td dir="rtl" lang="he">אטיוד</td><td lang="ru">Этюд</td></tr>
          <tr><th>Descriptor</th><td>Dance School</td><td dir="rtl" lang="he">בית ספר לריקוד</td><td lang="ru">Школа танцев</td></tr>
          <tr><th>Full description</th><td>Ballroom &amp; Latin Dance School</td><td dir="rtl" lang="he">בית ספר לריקודי סטנדרט ולטיניים</td><td lang="ru">Школа бальных и латиноамериканских танцев</td></tr>
          <tr><th>Slogan (brand promise)</th><td>Dancing is for everyone</td><td dir="rtl" lang="he">כולם יכולים לרקוד</td><td lang="ru">Танцевать может каждый</td></tr>
          <tr><th>Campaign line</th><td>Learn to dance, at your own pace</td><td dir="rtl" lang="he">ללמוד לרקוד, בקצב שלכם</td><td lang="ru">Учитесь танцевать в своём темпе</td></tr>
        </tbody>
      </table>
    </section>

    <section class="page page-body">
      <div class="two">
