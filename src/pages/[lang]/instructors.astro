---
import PageMore from '../../components/PageMore.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { ALL_LANGS, localizePath, type Lang } from '../../lib/languages';
import { SITE } from '../../lib/site';
import { PHOTO_CREDIT } from '../../data/photos';
import { translations } from '../../lib/translations';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return ALL_LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const copy = translations[lang];

// Written/updated via the hidden /admin/ panel — see README.
const allInstructors = (await getCollection('instructors')).sort((a, b) => a.data.order - b.data.order);

// One Person per teacher, tied to the school, so search engines and AI
// assistants can connect the names and titles to ETUDE.
const JOB_TITLE: Record<Lang, string> = {
  he: 'מורה לריקודים סלוניים ולטיניים',
  en: 'Ballroom and Latin dance teacher',
  ru: 'Преподаватель бальных и латиноамериканских танцев',
};
const peopleSchema = {
  '@context': 'https://schema.org',
  '@graph': allInstructors.map((person) => ({
    '@type': 'Person',
    name: person.data.name[lang],
    jobTitle: JOB_TITLE[lang],
    description: person.data.bio[lang].replace(/●\s*/g, '').replace(/\s*\n\s*/g, ' ').trim(),
    // Only photos hosted on the site itself; hotlinked ones can vanish.
    ...(person.data.photo?.startsWith('/') && { image: `${SITE.siteUrl}${person.data.photo}` }),
    worksFor: { '@type': 'DanceSchool', name: SITE.brandNameLocalized[lang], url: `${SITE.siteUrl}${localizePath(lang, '/')}` },
  })),
};
---

<BaseLayout lang={lang} path="/instructors" title={copy.instructors.metaTitle} description={copy.instructors.metaDescription}>
  <PageIntro title={copy.instructors.title} intro={copy.instructors.intro} />
  {allInstructors.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(peopleSchema)} />}

  <section class="section">
    <div class="container">
      {allInstructors.length === 0 ? (
        <p class="notice">{copy.instructors.placeholderNotice}</p>
      ) : (
        <div class="grid grid--2 instructor-grid">
          {allInstructors.map((person, index) => (
            <div class="card instructor-card">
              {person.data.photo ? (
                <img
                  src={person.data.photo}
                  alt={person.data.name[lang]}
                  class="instructor-card__photo-img"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  referrerpolicy="no-referrer"
                  onerror="this.replaceWith(this.nextElementSibling.content.cloneNode(true))"
                />
                <template>
                  <div class="instructor-card__photo instructor-card__photo--monogram" aria-hidden="true">
                    <span>{person.data.name[lang].charAt(0)}</span>
                  </div>
                </template>
              ) : (
                <div class="instructor-card__photo instructor-card__photo--monogram" aria-hidden="true">
                  <span>{person.data.name[lang].charAt(0)}</span>
                </div>
              )}
              {person.data.photo?.startsWith('/images/') && (
                <p class="photo-credit">{copy.common.photoBy}: {PHOTO_CREDIT[lang]}</p>
              )}
              <div>
                <h2 class="h3">{person.data.name[lang]}</h2>
                <p class="instructor-card__bio">{person.data.bio[lang].trim()}</p>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
  <PageMore title={copy.pageMore.instructors.title} paragraphs={copy.pageMore.instructors.paragraphs} surface />
</BaseLayout>

<style>
  .instructor-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: 0;
    overflow: hidden;
  }
  .instructor-card__photo,
  .instructor-card__photo-img {
    aspect-ratio: 4 / 3;
    width: 100%;
  }
  .instructor-card__photo-img {
    object-fit: cover;
    object-position: center 35%;
  }
  .photo-credit {
    margin: 0;
    padding: 0.4rem var(--space-md) 0;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }
  .instructor-card__photo {
    background: repeating-linear-gradient(
      135deg,
      var(--color-silver-100),
      var(--color-silver-100) 10px,
      var(--color-silver-200) 10px,
      var(--color-silver-200) 20px
    );
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-ink-soft);
    font-size: 0.85rem;
    padding: var(--space-sm);
  }
  /* Shown when a photo is missing or its URL doesn't resolve to an image. */
  .instructor-card__photo--monogram {
    background: var(--color-blue-100);
  }
  .instructor-card__photo--monogram span {
    font-family: var(--font-display);
    font-size: 5rem;
    color: var(--color-blue-600);
  }
  .instructor-card__bio {
    white-space: pre-line;
  }
  .instructor-card > div:last-child {
    padding: 0 var(--space-md) var(--space-md);
  }
</style>
