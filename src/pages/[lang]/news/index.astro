---
import { excerpt } from '../../../lib/richText';
import PageMore from '../../../components/PageMore.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { ALL_LANGS, type Lang } from '../../../lib/languages';
import { translations } from '../../../lib/translations';
import { getPublishedNews } from '../../../lib/news';

export function getStaticPaths() {
  return ALL_LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const copy = translations[lang];

const allNews = (await getPublishedNews()).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout lang={lang} path="/news" title={copy.news.metaTitle} description={copy.news.metaDescription}>
  <PageIntro title={copy.news.title} intro={copy.news.intro} />

  <section class="section">
    <div class="container">
      {allNews.length === 0 ? (
        <p class="notice">{copy.news.empty}</p>
      ) : (
        <div class="grid grid--3">
          {allNews.map((post) => (
            <NewsCard
              lang={lang}
              headingLevel={2}
              id={post.id}
              date={post.data.date}
              image={post.data.image}
              title={post.data.title[lang]}
              excerpt={excerpt(post.data.body[lang], 110)}
            />
          ))}
        </div>
      )}
    </div>
  </section>
  <PageMore title={copy.pageMore.news.title} paragraphs={copy.pageMore.news.paragraphs} surface />
</BaseLayout>
