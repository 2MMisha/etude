---
// In-studio screen: today's classes from the timetable uploaded via /admin/.
// Open https://etude.ristar.co/display/ full-screen on the studio TV (any
// smart-TV browser, a Chromecast/Fire stick, or a mini PC). The page polls
// /data/timetable.json every couple of minutes, so a new Excel upload shows
// up on the TV within a few minutes of the site redeploying — no reload.
//
// A 5-minute loop driven by the clock: today's classes in Hebrew, English,
// Russian (one minute each), then the whole week for 2 minutes (in Hebrew).
//
// URL options: ?lang=he|en|ru pins one language · ?view=today|week pins a view ·
// ?rent=0 hides rental columns · ?date=2026-10-05&time=18:20 freezes the clock
// (for checking a layout).
// Not linked anywhere, noindex, excluded from the sitemap and robots.txt.
import '../styles/global.css';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Heebo:wght@400;500;600;700;800&family=Marck+Script&display=swap"
      rel="stylesheet"
    />
    <title>ETUDE — Today</title>
  </head>
  <body class="display">
    <div class="blobs" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="screen" id="screen">
      <header class="top">
        <img class="top__logo" src="/images/brand/logo-full-white.svg" alt="ETUDE" />
        <div class="top__day">
          <p class="top__label"></p>
          <p class="top__date" id="date"></p>
        </div>
        <p class="top__clock" id="clock" dir="ltr"></p>
      </header>

      <main class="body" id="todayView">
        <section class="focus" id="focus" aria-live="polite"></section>
        <section class="list">
          <h2 class="list__title" id="listTitle"></h2>
          <div class="fit" id="timelineBox"><ol class="timeline" id="timeline"></ol></div>
        </section>
      </main>
      <main class="weekview" id="weekView" hidden></main>

      <footer class="bottom">
        <span>etude.ristar.co</span>
        <span id="note"></span>
      </footer>
    </div>

    <script>
      import { dayFor, timeToMinutes, weekOf, RENTAL_COLUMN, type Timetable, type TimetableItem } from '../lib/timetable';

      type Lang = 'he' | 'en' | 'ru';
      const L = {
        he: {
          today: 'השיעורים היום', now: 'עכשיו', next: 'השיעור הבא', startsIn: 'מתחיל בעוד', endsIn: 'מסתיים בעוד',
          min: 'דק׳', h: 'שע׳', schedule: 'לוח השיעורים', tomorrow: 'מחר', noClasses: 'אין שיעורים היום',
          dayOver: 'השיעורים להיום הסתיימו', seeYou: 'נתראה בשיעור הבא!', template: 'לפי לוח השבוע האחרון שהועלה',
          noData: 'לוח הזמנים עדיין לא הועלה', offline: 'אין חיבור — מוצג המידע האחרון', locale: 'he-IL', dir: 'rtl',
          thisWeek: 'לוח השבוע', today2: 'היום', more: 'ועוד {n} — עד {end}',
        },
        en: {
          today: "Today's classes", now: 'Now', next: 'Up next', startsIn: 'Starts in', endsIn: 'Ends in',
          min: 'min', h: 'h', schedule: 'Schedule', tomorrow: 'Tomorrow', noClasses: 'No classes today',
          dayOver: "That's all for today", seeYou: 'See you at the next class!', template: 'Based on the latest uploaded week',
          noData: 'The schedule has not been uploaded yet', offline: 'Offline — showing the last known schedule', locale: 'en-GB', dir: 'ltr',
          thisWeek: "This week's classes", today2: 'Today', more: '+{n} more — until {end}',
        },
        ru: {
          today: 'Занятия сегодня', now: 'Сейчас', next: 'Следующее', startsIn: 'Начало через', endsIn: 'До конца',
          min: 'мин', h: 'ч', schedule: 'Расписание', tomorrow: 'Завтра', noClasses: 'Сегодня занятий нет',
          dayOver: 'Занятия на сегодня закончились', seeYou: 'До встречи на следующем занятии!', template: 'По последней загруженной неделе',
          noData: 'Расписание ещё не загружено', offline: 'Нет связи — показано последнее расписание', locale: 'ru-RU', dir: 'ltr',
          thisWeek: 'Расписание на неделю', today2: 'Сегодня', more: 'и ещё {n} — до {end}',
        },
      } as const;

      const params = new URLSearchParams(location.search);
      const ROTATION: Lang[] = ['he', 'en', 'ru'];
      const pinnedLang = ROTATION.find((l) => l === params.get('lang'));
      const pinnedView = ['today', 'week'].find((v) => v === params.get('view'));
      const hideRent = params.get('rent') === '0';
      const frozenDate = params.get('date');
      const frozenTime = params.get('time');

      // Loop position (0–4) from the clock, so every screen in the studio is in sync:
      // 0 he · 1 en · 2 ru (today), 3–4 the week.
      const LOOP = ROTATION.length + 2;
      const step = (d: Date) => (d.getHours() * 60 + d.getMinutes()) % LOOP;
      const viewFor = (d: Date) => pinnedView ?? (step(d) < ROTATION.length ? 'today' : 'week');
      const langFor = (d: Date): Lang => pinnedLang ?? (step(d) < ROTATION.length ? ROTATION[step(d)] : ROTATION[0]);
      let lang: Lang = langFor(new Date());
      let t: (typeof L)[Lang] = L[lang];
      let view = '';

      const $ = (id: string) => document.getElementById(id)!;
      let timetable: Timetable | null = null;
      let offline = false;
      const colors = new Map<string, number>();

      function now(): Date {
        if (!frozenDate) return new Date();
        const [y, m, d] = frozenDate.split('-').map(Number);
        const [hh, mm] = (frozenTime || '12:00').split(':').map(Number);
        return new Date(y, m - 1, d, hh, mm);
      }

      function esc(s: string) {
        return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      }

      function colorOf(column: string) {
        if (!colors.has(column)) colors.set(column, colors.size % 6);
        return colors.get(column)!;
      }

      function duration(mins: number) {
        if (mins < 60) return `${mins} ${t.min}`;
        const h = Math.floor(mins / 60), m = mins % 60;
        return m ? `${h} ${t.h} ${m} ${t.min}` : `${h} ${t.h}`;
      }

      function itemsOf(date: Date) {
        if (!timetable) return { items: [] as TimetableItem[], fromTemplate: false };
        const { day, fromTemplate } = dayFor(timetable, date);
        const items = (day?.items ?? []).filter((i) => !(hideRent && RENTAL_COLUMN.test(i.column)));
        return { items, fromTemplate };
      }

      // Hall rentals (column label contains "rent") get their own amber, hatched
      // look so they never read as a studio class; names stay exactly as in Excel.
      const isRent = (item: TimetableItem) => RENTAL_COLUMN.test(item.column);

      function chip(column: string) {
        if (RENTAL_COLUMN.test(column)) return `<span class="chip chip--rent">${esc(column)}</span>`;
        return `<span class="chip c${colorOf(column)}">${esc(column)}</span>`;
      }

      function focusCard(kind: 'now' | 'next', item: TimetableItem, minutes: number) {
        const start = timeToMinutes(item.start), end = timeToMinutes(item.end);
        const progress = kind === 'now' ? Math.min(100, Math.max(0, ((minutes - start) / (end - start)) * 100)) : 0;
        const left = kind === 'now' ? `${t.endsIn} ${duration(end - minutes)}` : `${t.startsIn} ${duration(start - minutes)}`;
        return `
          <article class="card card--${kind}${isRent(item) ? ' is-rent' : ''}">
            <p class="card__kind">${kind === 'now' ? `<span class="pulse"></span>${t.now}` : t.next}</p>
            <h3 class="card__title" dir="auto">${esc(item.title)}</h3>
            <p class="card__time" dir="ltr">${item.start} – ${item.end}</p>
            <div class="card__meta">${chip(item.column)}<span>${left}</span></div>
            ${kind === 'now' ? `<div class="bar"><span style="inline-size:${progress.toFixed(1)}%"></span></div>` : ''}
          </article>`;
      }

      function row(item: TimetableItem, state: string) {
        return `
          <li class="row row--${state}${isRent(item) ? ' is-rent' : ''}" data-end="${item.end}">
            <span class="row__time" dir="ltr">${item.start}–${item.end}</span>
            <span class="row__title" dir="auto">${esc(item.title)}</span>
            ${chip(item.column)}
          </li>`;
      }

      // Auto-fit: if a list is taller than its box, shrink it (uniformly across
      // the group, so all week columns stay the same size) down to MIN_FIT;
      // the width is widened by the same factor so lines don't wrap more.
      const MIN_FIT = 0.6;
      function fitGroup(boxes: HTMLElement[]) {
        const inners = boxes.map((b) => b.firstElementChild as HTMLElement | null).filter(Boolean) as HTMLElement[];
        const origin = t.dir === 'rtl' ? 'top right' : 'top left';
        let scale = 1;
        for (let pass = 0; pass < 3; pass++) {
          inners.forEach((el) => {
            el.style.transform = scale < 1 ? `scale(${scale})` : '';
            el.style.transformOrigin = origin;
            el.style.width = scale < 1 ? `${100 / scale}%` : '';
          });
          const need = Math.min(
            1,
            ...boxes.map((b) => {
              const inner = b.firstElementChild as HTMLElement | null;
              return inner && inner.scrollHeight > 0 ? b.clientHeight / inner.scrollHeight : 1;
            })
          );
          const next = Math.max(MIN_FIT, Math.min(1, need));
          if (Math.abs(next - scale) < 0.01) break;
          scale = next;
        }
        // Still too tall at the smallest size: drop the last rows and say how
        // many more there are (with the end time of the last one).
        for (const box of boxes) {
          const list = box.firstElementChild as HTMLElement | null;
          if (!list) continue;
          const rows = [...list.children].filter((li) => !li.classList.contains('more')) as HTMLElement[];
          const fits = () => list.scrollHeight * scale <= box.clientHeight + 1;
          if (fits()) continue;
          const lastEnd = rows[rows.length - 1]?.dataset.end ?? '';
          const more = document.createElement('li');
          more.className = 'more';
          list.appendChild(more);
          let hidden = 0;
          while (!fits() && rows.length - hidden > 1) {
            rows[rows.length - 1 - hidden].remove();
            hidden++;
            more.textContent = t.more.replace('{n}', String(hidden)).replace('{end}', lastEnd);
          }
        }
      }

      // Past classes are hidden, except the one that just ended (context).
      function withoutPast(items: TimetableItem[], minutes: number) {
        const past = items.filter((i) => timeToMinutes(i.end) <= minutes);
        const keep = past[past.length - 1];
        return items.filter((i) => timeToMinutes(i.end) > minutes || i === keep);
      }

      // Fade out, swap language/view, fade in — so the switch doesn't jump.
      let switching = false;
      function render() {
        const real = new Date();
        const nextLang = langFor(real);
        const nextView = viewFor(real);
        if ((nextLang !== lang || nextView !== view) && view && !switching) {
          switching = true;
          $('screen').classList.add('is-fading');
          setTimeout(() => {
            switching = false;
            draw(nextLang, nextView);
            $('screen').classList.remove('is-fading');
          }, 450);
          return;
        }
        if (!switching) draw(nextLang, nextView);
      }

      function draw(nextLang: Lang, nextView: string) {
        lang = nextLang;
        t = L[lang];
        view = nextView;
        document.documentElement.lang = lang;
        document.documentElement.dir = t.dir;
        const date = now();
        $('clock').textContent = date.toLocaleTimeString(t.locale, { hour: '2-digit', minute: '2-digit', hour12: false });
        $('todayView').hidden = view !== 'today';
        $('weekView').hidden = view !== 'week';
        if (view === 'week') return renderWeek(date);
        renderToday(date);
      }

      function renderWeek(date: Date) {
        const dates = weekOf(date);
        const dm = (iso: string) => `${iso.slice(8, 10)}.${iso.slice(5, 7)}`;
        document.querySelector<HTMLElement>('.top__label')!.textContent = t.thisWeek;
        $('date').innerHTML = `<bdi dir="ltr">${dm(dates[0])} – ${dm(dates[6])}</bdi>`;
        const todayIso = dates[date.getDay()];
        const minutes = date.getHours() * 60 + date.getMinutes();
        let fromTemplate = false;
        // Days already over collapse to a narrow column with just a tick and count.
        $('weekView').style.gridTemplateColumns = dates.map((iso) => (iso < todayIso ? 'minmax(0, 0.45fr)' : 'minmax(0, 1fr)')).join(' ');
        $('weekView').innerHTML = dates
          .map((iso) => {
            const d = new Date(`${iso}T12:00:00`);
            const { items: all, fromTemplate: ft } = itemsOf(d);
            fromTemplate ||= ft && all.length > 0;
            const past = iso < todayIso;
            const items = iso === todayIso ? withoutPast(all, minutes) : all;
            const body = past
              ? `<p class="wday__done">${all.length ? `✓ ${all.length}` : '—'}</p>`
              : items.length
                ? `<div class="fit"><ul class="wday__list">${items
                    .map(
                      (i) => `
                        <li class="wev${isRent(i) ? ' is-rent' : ` c${colorOf(i.column)}`}${iso === todayIso && timeToMinutes(i.end) <= minutes ? ' wev--past' : ''}" data-end="${i.end}">
                          <span class="wev__time" dir="ltr">${i.start}</span>
                          <span class="wev__title" dir="auto">${esc(i.title)}</span>
                          <span class="wev__who" dir="auto">${isRent(i) ? '🔑 ' : ''}${esc(i.column)}</span>
                        </li>`
                    )
                    .join('')}</ul></div>`
                : '<p class="wday__none">—</p>';
            return `
              <section class="wday${iso === todayIso ? ' wday--today' : ''}${past ? ' wday--past' : ''}">
                <h2 class="wday__head">
                  <span>${d.toLocaleDateString(t.locale, { weekday: past ? 'short' : 'long' })}</span>
                  <small>${iso === todayIso ? `${t.today2} · ` : ''}${dm(iso)}</small>
                </h2>
                ${body}
              </section>`;
          })
          .join('');
        fitGroup([...$('weekView').querySelectorAll<HTMLElement>('.fit')]);
        const notes = [];
        if (fromTemplate) notes.push(t.template);
        if (offline) notes.push(t.offline);
        $('note').textContent = notes.join(' · ');
      }

      function renderToday(date: Date) {
        const minutes = date.getHours() * 60 + date.getMinutes();
        document.querySelector<HTMLElement>('.top__label')!.textContent = t.today;
        const dateText = date.toLocaleDateString(t.locale, { weekday: 'long', day: 'numeric', month: 'long' });
        $('date').textContent = dateText;

        if (!timetable) {
          $('focus').innerHTML = `<div class="empty"><p class="empty__big">${t.noData}</p></div>`;
          $('timeline').innerHTML = '';
          $('listTitle').textContent = '';
          return;
        }

        const { items, fromTemplate } = itemsOf(date);
        const current = items.filter((i) => timeToMinutes(i.start) <= minutes && minutes < timeToMinutes(i.end));
        const upcoming = items.filter((i) => timeToMinutes(i.start) > minutes);
        const tomorrow = new Date(date.getFullYear(), date.getMonth(), date.getDate() + 1);
        const tomorrowItems = itemsOf(tomorrow).items;

        let focus = '';
        if (current.length) focus += current.slice(0, 2).map((i) => focusCard('now', i, minutes)).join('');
        if (upcoming.length && current.length < 2) {
          const firstStart = upcoming[0].start;
          focus += upcoming.filter((i) => i.start === firstStart).slice(0, 2 - current.length).map((i) => focusCard('next', i, minutes)).join('');
        }
        if (!focus) {
          focus = `<div class="empty"><p class="empty__big">${items.length ? t.dayOver : t.noClasses}</p><p class="empty__small">${t.seeYou}</p></div>`;
        }
        $('focus').innerHTML = focus;

        // Main list: today's classes; once the day is over (or empty), tomorrow's.
        const showTomorrow = !current.length && !upcoming.length && tomorrowItems.length > 0;
        const list = showTomorrow ? tomorrowItems : items;
        $('listTitle').textContent = showTomorrow
          ? `${t.tomorrow} · ${tomorrow.toLocaleDateString(t.locale, { weekday: 'long' })}`
          : t.schedule;
        const nextStart = upcoming[0]?.start;
        const shown = showTomorrow ? list : withoutPast(list, minutes);
        $('timeline').innerHTML = shown
          .map((i) => {
            if (showTomorrow) return row(i, 'future');
            const s = timeToMinutes(i.start), e = timeToMinutes(i.end);
            const state = e <= minutes ? 'past' : s <= minutes ? 'now' : i.start === nextStart ? 'next' : 'future';
            return row(i, state);
          })
          .join('');
        fitGroup([$('timelineBox')]);

        const notes = [];
        if (fromTemplate && !showTomorrow) notes.push(t.template);
        if (offline) notes.push(t.offline);
        $('note').textContent = notes.join(' · ');
      }

      async function load() {
        try {
          const res = await fetch(`/data/timetable.json?t=${Date.now()}`, { cache: 'no-store' });
          if (!res.ok) throw new Error(String(res.status));
          const data = (await res.json()) as Timetable;
          timetable = data.days?.length ? data : null;
          offline = false;
        } catch {
          offline = true; // keep showing the last good copy
        }
        render();
      }

      load();
      // Re-fit once the web fonts arrive (they change text widths/heights).
      document.fonts?.ready.then(() => render());
      setInterval(load, 2 * 60 * 1000);
      setInterval(render, 5 * 1000);
      // Reload a few times a day so the TV also picks up changes to this page itself.
      setTimeout(() => location.reload(), 6 * 60 * 60 * 1000);

      // Keep the TV/monitor from sleeping where the browser allows it.
      const wakeLock = () => (navigator as any).wakeLock?.request('screen').catch(() => {});
      wakeLock();
      document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && wakeLock());
      // Click/tap anywhere to go full-screen.
      document.addEventListener('click', () => {
        if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => {});
      });
    </script>

    <style is:global>
      html { font-size: clamp(12px, 1.05vw, 40px); }
      body.display {
        margin: 0;
        min-height: 100vh;
        overflow: hidden;
        color: #fff;
        font-family: 'Heebo', 'Montserrat', system-ui, sans-serif;
        background: var(--color-navy-900);
        cursor: none;
      }
      :lang(en) body.display, :lang(ru) body.display { font-family: 'Montserrat', 'Heebo', system-ui, sans-serif; }

      /* Slowly drifting colour blobs behind everything. Only transform is
         animated (no blur filter), so weak smart-TV browsers keep up. */
      .blobs { position: fixed; inset: 0; overflow: hidden; z-index: 0; pointer-events: none; }
      .blobs span {
        position: absolute; inline-size: 60vmax; block-size: 60vmax; border-radius: 50%;
        background: radial-gradient(circle at center, var(--blob) 0%, transparent 65%);
        opacity: 0.55; will-change: transform;
      }
      .blobs span:nth-child(1) { --blob: rgba(85, 112, 184, 0.9); inset-block-start: -25vmax; inset-inline-start: -15vmax; animation: drift1 38s ease-in-out infinite alternate; }
      .blobs span:nth-child(2) { --blob: rgba(124, 86, 196, 0.75); inset-block-end: -30vmax; inset-inline-end: -20vmax; animation: drift2 46s ease-in-out infinite alternate; }
      .blobs span:nth-child(3) { --blob: rgba(47, 132, 175, 0.6); inset-block-start: 20vh; inset-inline-start: 35vw; inline-size: 45vmax; block-size: 45vmax; animation: drift3 54s ease-in-out infinite alternate; }
      .blobs span:nth-child(4) { --blob: rgba(198, 92, 150, 0.45); inset-block-end: -10vmax; inset-inline-start: -10vmax; inline-size: 40vmax; block-size: 40vmax; animation: drift4 62s ease-in-out infinite alternate; }
      @keyframes drift1 { to { transform: translate(28vw, 22vh) scale(1.15); } }
      @keyframes drift2 { to { transform: translate(-30vw, -25vh) scale(0.9); } }
      @keyframes drift3 { 50% { transform: translate(-25vw, 18vh) scale(1.2); } to { transform: translate(15vw, -20vh) scale(0.85); } }
      @keyframes drift4 { to { transform: translate(35vw, -30vh) scale(1.25); } }
      .screen { position: relative; z-index: 1; transition: opacity 0.45s ease; }
      .screen.is-fading { opacity: 0; }

      /* Week view (2 minutes out of every 10). */
      .weekview { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1rem; min-height: 0; }
      .wday {
        display: flex; flex-direction: column; gap: 0.7rem; min-height: 0; overflow: hidden;
        padding: 1.1rem 0.9rem; border-radius: 1.3rem;
        background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .wday--today { background: rgba(255, 255, 255, 0.14); border: 2px solid rgba(255, 255, 255, 0.75); }
      .wday--past { opacity: 0.45; }
      .display .wday__head { display: flex; flex-direction: column; gap: 0.15rem; font-family: inherit; font-size: 1.45rem; font-weight: 800; line-height: 1.15; }
      .wday__head small { font-size: 1rem; font-weight: 600; color: var(--color-silver-300); }
      .wday--today .wday__head small { color: #fff; }
      .fit { flex: 1; min-height: 0; overflow: hidden; }
      .wday__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; }
      /* Compact entry: time + title on one line, trainer underneath in small type. */
      .wev {
        --c: #7aa2ff;
        display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 0.55rem; row-gap: 0.1rem;
        padding: 0.5rem 0.65rem; border-radius: 0.75rem; background: rgba(255, 255, 255, 0.08);
        border-inline-start: 0.3rem solid var(--c);
      }
      .wev__who { grid-column: 2; font-size: 0.9rem; font-weight: 600; color: var(--color-silver-300); }
      .wev--past { opacity: 0.4; }
      .more {
        list-style: none; text-align: center; font-weight: 700; font-size: 1.3rem;
        padding: 0.5rem; border-radius: 0.8rem; border: 1px dashed rgba(255, 255, 255, 0.4); color: var(--color-silver-200);
      }
      .wday__list .more { font-size: 0.95rem; padding: 0.35rem; }
      .wday--past { padding-inline: 0.5rem; align-items: center; text-align: center; }
      .display .wday--past .wday__head { font-size: 1.1rem; align-items: center; }
      .wday__done { font-size: 1.4rem; font-weight: 700; color: var(--color-silver-300); }
      .wev__time { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
      .wev__title { font-weight: 700; font-size: 1.15rem; line-height: 1.2; overflow-wrap: anywhere; }
      .wev.is-rent {
        background: repeating-linear-gradient(135deg, rgba(255, 181, 71, 0.16) 0 0.6rem, rgba(255, 181, 71, 0.05) 0.6rem 1.2rem);
        border: 1px dashed rgba(255, 181, 71, 0.7);
        border-inline-start: 0.3rem solid #ffb547;
      }
      .wev.is-rent .wev__who { color: #ffd38f; }
      .wev.is-rent .wev__title { color: #ffd38f; }
      .wday__none { font-size: 1.6rem; color: var(--color-silver-300); }
      .display p, .display h2, .display h3 { margin: 0; color: inherit; }
      /* .body / .weekview set display:grid, which would override the hidden attribute. */
      .display [hidden] { display: none !important; }

      .screen {
        box-sizing: border-box;
        height: 100vh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        gap: 2.2rem;
        padding: 2.4rem 3rem 1.6rem;
      }

      .top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
      .top__logo { block-size: 4.6rem; inline-size: auto; justify-self: start; }
      .top__day { text-align: center; }
      .top__label { font-size: 1.25rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-silver-300); font-weight: 600; }
      .top__date { font-size: 2.6rem; font-weight: 700; line-height: 1.15; }
      .top__clock {
        justify-self: end;
        font-family: 'Montserrat', sans-serif;
        font-size: 4.4rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.02em;
        line-height: 1;
      }

      .body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 2.6rem; min-height: 0; }

      .focus { display: flex; flex-direction: column; gap: 1.6rem; justify-content: safe center; min-height: 0; overflow: hidden; }
      /* Two cards at once (two classes now, or now + next): make them more compact. */
      .focus:has(.card + .card) { gap: 1.1rem; }
      .focus:has(.card + .card) .card { padding: 1.4rem 1.8rem; gap: 0.5rem; }
      .display .focus:has(.card + .card) .card__title { font-size: 2.5rem; }
      .focus:has(.card + .card) .card__time { font-size: 1.6rem; }
      .card {
        border-radius: 1.6rem;
        padding: 2rem 2.2rem;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.14);
        display: grid;
        gap: 0.8rem;
      }
      .card--now { background: #fff; color: var(--color-navy-900); border-color: #fff; box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.35); }
      .card__kind { display: flex; align-items: center; gap: 0.7rem; font-size: 1.3rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.85; }
      .card--now .card__kind { color: var(--color-blue-600); opacity: 1; }
      .display .card__title { font-size: 3.4rem; font-weight: 800; line-height: 1.08; font-family: inherit; }
      .display .card--next .card__title { font-size: 2.6rem; }
      .card__time { font-family: 'Montserrat', sans-serif; font-size: 2rem; font-weight: 600; font-variant-numeric: tabular-nums; opacity: 0.85; justify-self: start; }
      .card__meta { display: flex; align-items: center; gap: 1rem; font-size: 1.35rem; font-weight: 600; flex-wrap: wrap; }
      .bar { block-size: 0.6rem; border-radius: 1rem; background: var(--color-blue-100); overflow: hidden; margin-block-start: 0.4rem; }
      .bar span { display: block; block-size: 100%; background: var(--color-blue-600); border-radius: inherit; transition: inline-size 1s linear; }
      .pulse { inline-size: 0.8rem; block-size: 0.8rem; border-radius: 50%; background: #e5484d; animation: pulse 1.6s ease-in-out infinite; }
      @keyframes pulse { 50% { opacity: 0.25; transform: scale(0.8); } }

      .empty { display: grid; gap: 1rem; padding: 2rem 0; }
      .empty__big { font-size: 3.4rem; font-weight: 800; line-height: 1.1; }
      .empty__small { font-size: 1.6rem; color: var(--color-silver-300); }

      .list { display: flex; flex-direction: column; min-height: 0; }
      .display .list__title { font-size: 1.25rem; line-height: 1.3; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-silver-300); font-weight: 600; margin-block-end: 1rem; font-family: inherit; }
      .list .fit { display: flex; flex-direction: column; }
      .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.8rem; }
      .row {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 1.4rem;
        padding: 0.85rem 1.4rem;
        border-radius: 1.1rem;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid transparent;
        transition: opacity 0.6s, background 0.6s;
      }
      .row__time { font-family: 'Montserrat', sans-serif; font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .row__title { font-size: 1.9rem; font-weight: 700; line-height: 1.15; overflow-wrap: anywhere; }
      .row--past { opacity: 0.38; }
      .row--now { background: #fff; color: var(--color-navy-900); }
      .row--next { border-color: rgba(255, 255, 255, 0.45); background: rgba(255, 255, 255, 0.1); }

      .chip {
        --c: #7aa2ff;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        font-size: 1.15rem;
        font-weight: 700;
        white-space: nowrap;
        background: color-mix(in srgb, var(--c) 22%, transparent);
        color: inherit;
      }
      .chip::before { content: ''; inline-size: 0.65rem; block-size: 0.65rem; border-radius: 50%; background: var(--c); }
      .c1 { --c: #f59ac0; } .c2 { --c: #5fd3a8; } .c3 { --c: #9ad468; } .c4 { --c: #b79cff; } .c5 { --c: #5cc8e6; }
      .card--now .chip, .row--now .chip { background: color-mix(in srgb, var(--c) 30%, #fff); }

      /* Hall rentals: amber, hatched, with a key mark — clearly not a class. */
      .chip--rent { --c: #ffb547; background: #ffb547; color: #3a2600; }
      .chip--rent::before { content: '🔑'; inline-size: auto; block-size: auto; background: none; border-radius: 0; font-size: 0.9em; }
      .row.is-rent, .card.is-rent {
        background:
          repeating-linear-gradient(135deg, rgba(255, 181, 71, 0.13) 0 0.7rem, rgba(255, 181, 71, 0.04) 0.7rem 1.4rem);
        border: 1px dashed rgba(255, 181, 71, 0.7);
      }
      .row.is-rent .row__title, .card.is-rent .card__title { color: #ffd38f; }
      .row--now.is-rent, .card--now.is-rent { background: #fff4e0; border: 2px solid #ffb547; color: #3a2600; }
      .row--now.is-rent .row__title, .card--now.is-rent .card__title { color: #3a2600; }
      .card--now.is-rent .card__kind { color: #b36b00; }
      .card--now.is-rent .bar { background: #ffe2b0; }
      .card--now.is-rent .bar span { background: #ffb547; }

      .bottom { display: flex; justify-content: space-between; gap: 2rem; font-size: 1.05rem; color: var(--color-silver-300); }

      /* Portrait screens: stack the focus card above the list. */
      @media (orientation: portrait) {
        html { font-size: clamp(12px, 1.9vw, 40px); }
        .body { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
        .top__logo { block-size: 3.4rem; }
      }
      @media (orientation: portrait) {
        .weekview { grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: hidden; }
      }
      @media (prefers-reduced-motion: reduce) { .pulse, .blobs span { animation: none; } }
    </style>
  </body>
</html>
