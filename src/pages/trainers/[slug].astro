---
// /trainers/<slug>/ — one trainer's or one hall's weekly schedule (columns of
// the Google Sheet), and /trainers/rentals/ — all hall rentals together.
import TrainerSchedule from '../../components/TrainerSchedule.astro';
import { getTimetable } from '../../lib/loadTimetable';
import { RENTALS_SLUG, hallsFrom, trainersFrom } from '../../lib/trainers';

export async function getStaticPaths() {
  const tt = await getTimetable();
  return [...trainersFrom(tt), ...hallsFrom(tt), { slug: RENTALS_SLUG }].map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params as { slug: string };
---

<TrainerSchedule slug={slug} />
