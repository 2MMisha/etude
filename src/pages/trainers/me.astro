---
// /trainers/me/ — a trainer's own page inside the trainers' app (same home-screen
// app, same scope): sign in, then my private lessons and my earnings. The page
// itself is in src/crm/trainer.ts; what it may read or change is decided by the
// trainer_* functions in the database (supabase/migrations/), not here.
// Not linked from the public site; noindex.
import '../../styles/global.css';
import '../../styles/crm.css';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#17224a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ETUDE" />
    <link rel="manifest" href="/trainers/manifest-all.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Heebo:wght@400;500;600;700&display=swap"
    />
    <title>ETUDE — trainers</title>
  </head>
  <body>
    <div class="crm">
      <div class="crm-top">
        <img src="/images/brand/icon.svg" alt="" />
        <strong id="who">ETUDE</strong>
        <a class="btn" href="/trainers/" id="toSchedule"></a>
        <span class="langs" id="langs"></span>
        <button id="signOut" hidden></button>
      </div>
      <main id="view"></main>
      <div id="status" class="status" role="status" hidden></div>
    </div>

    <script>
      import '../../crm/trainer';
    </script>
  </body>
</html>
