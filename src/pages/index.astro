---
import HomePage from '../components/HomePage.astro';
import { DEFAULT_LANG } from '../lib/languages';
// "/" serves the Hebrew homepage itself instead of redirecting: GitHub Pages
// can't send HTTP redirects, and a meta-refresh "doorway" page is flagged by
// SEO tools (no H1, no description, no links). Its canonical points at /he/,
// so search engines index one URL. We deliberately do NOT auto-redirect by
// browser language — LanguageBanner.astro offers a dismissible suggestion.
---

<HomePage lang={DEFAULT_LANG} />
