---
import { DEFAULT_LANG } from '../lib/languages';
// This page exists only to route "/" to the right language.
// No-JS clients get an instant meta-refresh to the Hebrew default;
// JS clients get redirected based on their browser language first.
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=/${DEFAULT_LANG}/`} />
    <link rel="canonical" href={`/${DEFAULT_LANG}/`} />
    <title>ETUDE Dance School</title>
    <script>
      const supported = ['he', 'en', 'ru'];
      const browserLangs = navigator.languages || [navigator.language];
      let target = 'he';
      for (const bl of browserLangs) {
        const code = bl.slice(0, 2).toLowerCase();
        if (supported.includes(code)) {
          target = code;
          break;
        }
      }
      window.location.replace(`/${target}/`);
    </script>
  </head>
  <body>
    <p>Redirecting… <a href="/he/">ETUDE Dance School</a></p>
  </body>
</html>
