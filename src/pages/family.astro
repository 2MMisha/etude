---
// /family/ — families register here: their own login, the account holder's
// details, their students and each student's forms; /family/#/s/<token> opens
// one student's forms without a login. The page is src/crm/family.ts; what it
// may read or change is decided by database functions, not here. noindex: the
// link is shared, not searched for.
import '../styles/global.css';
import '../styles/crm.css';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#17224a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Heebo:wght@400;500;600;700&display=swap"
    />
    <title>ETUDE — registration</title>
  </head>
  <body>
    <div class="crm">
      <div class="crm-top">
        <img src="/images/brand/icon.svg" alt="" />
        <strong>ETUDE</strong>
        <span class="langs" id="langs"></span>
        <button id="signOut" hidden></button>
      </div>
      <main id="view"></main>
      <div id="status" class="status" role="status" hidden></div>
    </div>

    <script>
      import '../crm/family';
    </script>
  </body>
</html>
