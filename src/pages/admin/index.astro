      // ---------- Students' app (src/data/student-app.json, one file for the whole tab) ----------
      let studentSha = null;
      const SA_LANGS = { He: 'he', Ru: 'ru', En: 'en' };
      let studentData = {}; // the whole file, so fields this tab doesn't edit survive a save
      const escAttr = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

      document.querySelectorAll('#saSubtabs button').forEach((b) =>
        b.addEventListener('click', () => {
