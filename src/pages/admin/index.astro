          document.querySelectorAll('[data-subpanel]').forEach((p) => (p.hidden = p.dataset.subpanel !== b.dataset.sub));
        })
      );

      // Events: one card per event.
      const todayIso = () => new Date().toLocaleDateString('en-CA');
      function eventCard(e = {}) {
        const card = document.createElement('div');
        card.className = 'row-card' + (e.date && e.date < todayIso() ? ' past' : '');
        card.dataset.id = e.id || Math.random().toString(36).slice(2, 10);
        const t = e.title || {}, b = e.body || {};
        card.innerHTML = `
          <div class="row-head"><span>${e.date && e.date < todayIso() ? 'Past event (hidden in the app)' : 'Event'}</span><button type="button" class="btn-mini danger" data-remove>Remove</button></div>
          <div class="row-4">
            <div><label>Date</label><input type="date" data-f="date" value="${escAttr(e.date)}" /></div>
            <div><label>Start (optional)</label><input type="time" data-f="start" value="${escAttr(e.start)}" /></div>
            <div><label>End (optional)</label><input type="time" data-f="end" value="${escAttr(e.end)}" /></div>
            <div><label>Place (empty = the studio)</label><input data-f="place" value="${escAttr(e.place)}" /></div>
          </div>
          <div><label>Title</label><div class="lang-grid">
            <input data-f="title.he" dir="rtl" placeholder="עברית" value="${escAttr(t.he)}" />
            <input data-f="title.ru" placeholder="Русский" value="${escAttr(t.ru)}" />
            <input data-f="title.en" placeholder="English" value="${escAttr(t.en)}" /></div></div>
          <div><label>Details (optional)</label><div class="lang-grid">
            <textarea data-f="body.he" dir="rtl" rows="3" placeholder="עברית">${escAttr(b.he)}</textarea>
            <textarea data-f="body.ru" rows="3" placeholder="Русский">${escAttr(b.ru)}</textarea>
            <textarea data-f="body.en" rows="3" placeholder="English">${escAttr(b.en)}</textarea></div></div>`;
        return card;
      }
      /** A dance style: its name and its dances/songs as text (see parseDances). */
      function musicCard(st = { style: '', dances: [] }) {
        const card = document.createElement('div');
        card.className = 'row-card';
        const text = (st.dances || []).map((d) => [d.name, ...(d.links || [])].join(' — ').replace(/ — (https?:\/\/\S+) — /g, ' — $1 ')).join('\n');
        card.innerHTML = `
          <div class="row-head"><span>Dance style</span><button type="button" class="btn-mini danger" data-remove>Remove</button></div>
          <div><label>Style</label><input data-f="style" placeholder="Латина / Latin" value="${escAttr(st.style)}" /></div>
          <div><label>Dances and playlists</label><textarea data-f="dances" rows="7" placeholder="Cha-cha-cha — https://open.spotify.com/playlist/…&#10;Rumba — https://…">${escAttr(text)}</textarea></div>`;
        return card;
      }
      /** "Dance — https://… [https://…]" lines → [{ name, links }]. */
      function parseDances(text) {
        const dances = [];
        for (const raw of text.split('\n')) {
          const line = raw.trim();
          if (!line) continue;
          const links = line.match(/https?:\/\/\S+/g) || [];
          const name = line.replace(/https?:\/\/\S+/g, '').replace(/[\s—–:-]+$/, '').trim();
          if (!name) return { error: `A playlist link without a dance name: "${line}" — write it as "Dance — link".` };
          dances.push({ name, links });
        }
        return { dances };
      }
      document.addEventListener('click', (e) => {
        const r = e.target.closest('#studentSection [data-remove]');
        if (r && confirm('Remove this item?')) r.closest('.row-card').remove();
      });
      $('saAddEvent').addEventListener('click', () => $('saEvents').prepend(eventCard()));
      $('saAddMusic').addEventListener('click', () => $('saMusic').append(musicCard()));
      /** Reads a row card's inputs into an object ("title.he" → { title: { he } }). */
      function readCard(card) {
        const o = {};
        card.querySelectorAll('[data-f]').forEach((el) => {
          const [k, sub] = el.dataset.f.split('.');
          const v = el.value.trim();
          if (sub) (o[k] ??= {})[sub] = v;
          else o[k] = v;
        });
        return o;
      }

      const pad2 = (n) => String(n).padStart(2, '0');
      /** "Маша К. — 15.03" lines → [{ name, day, month }]; null + message on a bad line. */
      function parseBirthdays(text) {
        const out = [];
        for (const raw of text.split('\n')) {
          const line = raw.trim();
          if (!line) continue;
          const m = line.match(/^(.+?)\s*[—–-]\s*(\d{1,2})[./](\d{1,2})$/);
          const day = m && Number(m[2]), month = m && Number(m[3]);
          if (!m || month < 1 || month > 12 || day < 1 || day > 31) return { error: `Can't read this line: "${line}" — write it as "Name — DD.MM".` };
          out.push({ name: m[1].trim(), day, month });
        }
        return { list: out };
      }

      async function loadStudent() {
        $('studentStatus').textContent = 'Loading…';
        $('studentStatus').className = 'status-msg pending';
        try {
          const file = await ghGetFile(STUDENT_PATH);
          const s = file ? JSON.parse(file.content) : {};
          studentData = s;
          studentSha = file?.sha ?? null;
          for (const [suffix, lang] of Object.entries(SA_LANGS)) {
            $('saPrices' + suffix).value = (s.prices?.[lang] || []).join('\n');
            $('saRules' + suffix).value = (s.rules?.[lang] || []).join('\n');
            $('saNoticeTitle' + suffix).value = s.notice?.title?.[lang] || '';
            $('saNoticeBody' + suffix).value = s.notice?.body?.[lang] || '';
            $('saInvite' + suffix).value = s.invite?.text?.[lang] || '';
          }
          $('saNoticeActive').checked = !!s.notice?.active;
          $('saNoticeMode').value = s.notice?.mode === 'popup' ? 'popup' : 'banner';
          $('saNoticeUntil').value = s.notice?.until || '';
          const pay = { active: true, day: 10, before: 3, after: 3, ...s.payment };
          $('saPayActive').checked = pay.active !== false;
          $('saPayDay').value = pay.day;
          $('saPayBefore').value = pay.before;
          $('saPayAfter').value = pay.after;
          $('saEvents').replaceChildren(...[...(s.events || [])].sort((a, b) => (b.date || '').localeCompare(a.date || '')).map(eventCard));
          $('saMusic').replaceChildren(...(s.music || []).map(musicCard));
          $('saBirthdays').value = (s.birthdays || []).map((b) => `${b.name} — ${pad2(b.day)}.${pad2(b.month)}`).join('\n');
          $('saInviteActive').checked = s.invite?.active !== false;
          $('saNewCode').value = '';
          $('studentStatus').textContent = '';
        } catch (err) {
          $('studentStatus').textContent = 'Could not load: ' + err.message;
          $('studentStatus').className = 'status-msg bad';
        }
      }

      function saveError(msg, sub) {
        if (sub) document.querySelector(`#saSubtabs [data-sub="${sub}"]`).click();
        $('studentSaveStatus').textContent = msg;
        $('studentSaveStatus').className = 'status-msg bad';
      }

      async function saveStudent() {
        const lines = (id) => $(id).value.split('\n').map((l) => l.trim()).filter(Boolean);
        const num = (id, lo, hi, fallback) => {
          const n = Math.round(Number($(id).value));
          return $(id).value === '' || !Number.isFinite(n) ? fallback : Math.min(hi, Math.max(lo, n));
        };
        $('saBirthdaysError').textContent = '';
        $('saCodeError').textContent = '';
        const birthdays = parseBirthdays($('saBirthdays').value);
        if (birthdays.error) { $('saBirthdaysError').textContent = birthdays.error; return saveError(birthdays.error, 'birthdays'); }
        const events = [...$('saEvents').children].map((c) => ({ id: c.dataset.id, ...readCard(c) }));
        const badEvent = events.find((e) => !e.date || !(e.title.he || e.title.ru || e.title.en));
        if (badEvent) return saveError('Every event needs a date and a title (at least in one language).', 'events');
        const music = [];
        for (const c of $('saMusic').children) {
          const { style, dances: text } = readCard(c);
          const parsed = parseDances(text);
          if (parsed.error) return saveError(parsed.error, 'music');
          if (!style) return saveError('Every dance style needs a name.', 'music');
          music.push({ style, dances: parsed.dances });
        }
        const newCode = $('saNewCode').value.trim();
        if (newCode && !/^\d{6}$/.test(newCode)) { $('saCodeError').textContent = 'The code must be exactly 6 digits.'; return saveError('The code must be exactly 6 digits.', 'access'); }

        const { playlists: _old, ...rest } = studentData; // replaced by "music"
        const data = {
          ...rest,
          prices: {},
          rules: {},
          notice: { active: $('saNoticeActive').checked, mode: $('saNoticeMode').value, until: $('saNoticeUntil').value, title: {}, body: {} },
          payment: {
            active: $('saPayActive').checked,
            day: num('saPayDay', 1, 28, 10),
            before: num('saPayBefore', 0, 14, 3),
            after: num('saPayAfter', 0, 14, 3),
          },
          events: events.sort((a, b) => a.date.localeCompare(b.date) || (a.start || '').localeCompare(b.start || '')),
          music,
          birthdays: birthdays.list,
          invite: { active: $('saInviteActive').checked, text: {} },
        };
        for (const [suffix, lang] of Object.entries(SA_LANGS)) {
          data.prices[lang] = lines('saPrices' + suffix);
          data.rules[lang] = lines('saRules' + suffix);
          data.notice.title[lang] = $('saNoticeTitle' + suffix).value.trim();
          data.notice.body[lang] = $('saNoticeBody' + suffix).value.trim();
          data.invite.text[lang] = $('saInvite' + suffix).value.trim();
        }
        if (data.notice.active && !data.notice.title.he && !data.notice.title.ru && !data.notice.title.en)
          return saveError('The notice needs a title (at least in one language).', 'notice');
        if (newCode) {
          if (!confirm('Change the app code? Every student will have to enter the new code.')) return;
          data.codeSha256 = await sha256Hex(newCode);
        }
        $('studentSaveStatus').textContent = 'Saving…';
        $('studentSaveStatus').className = 'status-msg pending';
        try {
          await ghPutFile(STUDENT_PATH, data, studentSha, 'chore(student): update student app via admin panel');
          $('studentSaveStatus').textContent = 'Saved. The app will update in about 1–2 minutes.';
          $('studentSaveStatus').className = 'status-msg ok';
          loadStudent();
        } catch (err) {
          $('studentSaveStatus').textContent = 'Save failed: ' + err.message;
          $('studentSaveStatus').className = 'status-msg bad';
        }
      }
      $('saveStudentBtn').addEventListener('click', saveStudent);


      // ---------- Timetable (Google Sheet) ----------
      // Shows exactly what the deployed site serves to /display/ (built from the
      // sheet), so it always matches the screen.
      const RENT = /\brent\b|השכרה|аренд/i;

      function fmtDate(iso) {
        const [y, m, d] = iso.split('-');
        return `${d}/${m}/${y}`;
      }

      function sundayOf(iso) {
        const d = new Date(`${iso}T12:00:00`);
        d.setDate(d.getDate() - d.getDay());
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      }

      let ttDaysCache = [];
      let ttWeeks = [];
      let ttWeek = '';
      const SHORT_DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

      // One week at a time, as a compact 7-column grid, plus A4 print links.
      function renderTtWeek() {
        const days = ttDaysCache;
        const idx = ttWeeks.indexOf(ttWeek);
        const start = new Date(`${ttWeek}T12:00:00`);
        const dates = Array.from({ length: 7 }, (_, n) => {
          const d = new Date(start);
          d.setDate(d.getDate() + n);
          return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        });
        const byDate = new Map(days.map((d) => [d.date, d.items]));
        const columns = [...new Set(
          dates.flatMap((date) => (byDate.get(date) || []).flatMap((i) => i.column.split(' · ').map((c) => c.trim())))
        )].filter(Boolean).sort();
        const trainers = columns.filter((c) => !RENT.test(c));
        const halls = columns.filter((c) => RENT.test(c));
        const short = (iso) => `${iso.slice(8, 10)}.${iso.slice(5, 7)}`;
        $('ttDays').innerHTML = `
          <div class="tt-weekbar">
            <button class="btn-mini" id="ttPrev" ${idx <= 0 ? 'disabled' : ''}>‹</button>
            <strong>Week ${short(dates[0])} – ${short(dates[6])}</strong>
            <button class="btn-mini" id="ttNext" ${idx >= ttWeeks.length - 1 ? 'disabled' : ''}>›</button>
          </div>
          <div class="tt-print">
            <span>🖨 Print this week (A4):</span>
            <select id="ttPrintLang" aria-label="Print language">
              <option value="he"${ttPrintLang === 'he' ? ' selected' : ''}>עברית</option>
              <option value="ru"${ttPrintLang === 'ru' ? ' selected' : ''}>Русский</option>
              <option value="en"${ttPrintLang === 'en' ? ' selected' : ''}>English</option>
            </select>
            <button class="btn-mini primary" data-print="all">Whole studio</button>
            ${trainers.map((name) => `<button class="btn-mini" data-print="col" data-name="${escapeHtml(name)}">${escapeHtml(name)}</button>`).join('')}
            ${halls.length ? '<button class="btn-mini tt-rent-btn" data-print="rentals">🔑 All rentals</button>' : ''}
            ${halls.map((name) => `<button class="btn-mini tt-rent-btn" data-print="col" data-name="${escapeHtml(name)}">${escapeHtml(name)}</button>`).join('')}
          </div>
          <div id="ttGrid"></div>`;
        const now = new Date();
        const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
        // window.weekGrid comes from the module script below (src/lib/weekGrid.ts).
        $('ttGrid').innerHTML = window.weekGrid
          ? window.weekGrid({
              dates,
              byDate,
              perDay: matchMedia('(max-width: 699px)').matches,
              now: { date: todayIso, min: now.getHours() * 60 + now.getMinutes() },
              noClasses: 'No classes',
              hallName: (h) => h.replace(/\s*hall$/i, '') || '—',
              dayHead: (date) => `<b>${SHORT_DAYS[dates.indexOf(date)]}</b> <span class="muted">${short(date)}</span>`,
              who: (i) => i.column,
              colorClass: (i) => `c${Math.max(0, trainers.indexOf(i.column.split(' · ')[0].trim())) % 6}`,
            })
          : '';
        $('ttPrev').addEventListener('click', () => { ttWeek = ttWeeks[idx - 1]; renderTtWeek(); });
        $('ttNext').addEventListener('click', () => { ttWeek = ttWeeks[idx + 1]; renderTtWeek(); });
        $('ttPrintLang').addEventListener('change', (e) => {
          ttPrintLang = e.target.value;
          try { localStorage.setItem('etudePrintLang', ttPrintLang); } catch {}
        });
        $('ttDays').querySelectorAll('button[data-print]').forEach((b) =>
          b.addEventListener('click', () => printWeek(dates, byDate, b.dataset.print, b.dataset.name || ''))
        );
      }

      // ---------- A4 printout (built here, printed from a hidden frame) ----------
      let ttPrintLang = (() => { try { return localStorage.getItem('etudePrintLang') || 'he'; } catch { return 'he'; } })();
      const PRINT_L = {
        he: { studio: 'לוח הזמנים של הסטודיו', trainer: 'לוח הזמנים של {name}', hall: '{name} — לוח זמנים', rentals: 'השכרות אולמות', week: 'שבוע', none: 'אין שיעורים', updated: 'הודפס', locale: 'he-IL', dir: 'rtl' },
        ru: { studio: 'Расписание студии', trainer: 'Расписание: {name}', hall: '{name} — расписание', rentals: 'Аренда залов', week: 'Неделя', none: 'Нет занятий', updated: 'Напечатано', locale: 'ru-RU', dir: 'ltr' },
        en: { studio: 'Studio schedule', trainer: "{name}'s schedule", hall: '{name} — schedule', rentals: 'Hall rentals', week: 'Week', none: 'No classes', updated: 'Printed', locale: 'en-GB', dir: 'ltr' },
      };

      function printWeek(dates, byDate, kind, name) {
        const L = PRINT_L[ttPrintLang] || PRINT_L.he;
        const columnsOf = (i) => i.column.split(' · ').map((c) => c.trim());
        const keep = (i) =>
          kind === 'all' ? true : kind === 'rentals' ? RENT.test(i.column) : columnsOf(i).includes(name);
        const showColumn = kind === 'all' || kind === 'rentals' || name === '';
        const title =
          kind === 'all' ? L.studio : kind === 'rentals' ? L.rentals : (RENT.test(name) ? L.hall : L.trainer).replace('{name}', name);
        const dm = (iso) => `${iso.slice(8, 10)}.${iso.slice(5, 7)}`;
        const cols = dates
          .map((date) => {
            const d = new Date(`${date}T12:00:00`);
            const items = (byDate.get(date) || []).filter(keep);
            return `
              <section class="day">
                <h2><span>${d.toLocaleDateString(L.locale, { weekday: 'long' })}</span><small>${dm(date)}</small></h2>
                ${items.length
                  ? items
                      .map(
                        (i) => `
                          <div class="ev${RENT.test(i.column) ? ' rent' : ''}">
                            <b dir="ltr">${i.start}–${i.end}</b>
                            <span class="t" dir="auto">${escapeHtml(i.title)}</span>
                            ${showColumn || i.column.includes(' · ') ? `<span class="c" dir="auto">${RENT.test(i.column) ? '🔑 ' : ''}${escapeHtml(i.column)}</span>` : ''}
                          </div>`
                      )
                      .join('')
                  : `<p class="none">${L.none}</p>`}
              </section>`;
          })
          .join('');
        const html = `<!doctype html>
          <html lang="${ttPrintLang}" dir="${L.dir}"><head><meta charset="utf-8">
          <title>${escapeHtml(title)} — ${dm(dates[0])}–${dm(dates[6])}</title>
          <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Heebo:wght@500;600;700&display=swap">
          <style>
            @page { size: A4 landscape; margin: 9mm; }
            * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            body { margin: 0; font: 9pt/1.25 ${ttPrintLang === 'he' ? "'Heebo', 'Montserrat'" : "'Montserrat', 'Heebo'"}, sans-serif; color: #1b2132; }
            header { display: flex; align-items: center; justify-content: space-between; gap: 6mm; padding-bottom: 2mm; border-bottom: 0.5mm solid #17224a; }
            h1 { margin: 0; font-size: 16pt; color: #17224a; }
            header img { height: 10mm; }
            .week { margin: 2mm 0; font-size: 12pt; font-weight: 700; color: #17224a; }
            .grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2mm; }
            .day { border: 0.3mm solid #c9cfdc; border-radius: 2mm; padding: 1.5mm; min-height: 30mm; }
            .day h2 { display: flex; justify-content: space-between; align-items: baseline; gap: 1mm; margin: 0 0 1.5mm; font-size: 9.5pt; color: #17224a; }
            .day h2 small { font-size: 7.5pt; font-weight: 500; color: #4a5367; }
            .day h2 span { text-transform: capitalize; }
            .ev { display: grid; gap: 0.3mm; padding: 1mm 1.5mm; margin-bottom: 1mm; border-radius: 1.2mm; background: #e6ebf7; border-inline-start: 0.8mm solid #2f4b9b; break-inside: avoid; }
            .ev b { font-size: 7.5pt; color: #2f4b9b; justify-self: start; }
            .ev .t { font-size: 8.5pt; font-weight: 700; overflow-wrap: break-word; }
            .ev .c { font-size: 7pt; font-weight: 600; color: #4a5367; }
            .ev.rent { background: repeating-linear-gradient(135deg, #fff4e0 0 2mm, #fffaf1 2mm 4mm); border-inline-start-color: #ffb547; }
            .ev.rent b, .ev.rent .c { color: #9a5b00; }
            html[dir='rtl'] .ev .t, html[dir='rtl'] .ev .c { text-align: right; }
            html[dir='ltr'] .ev .t, html[dir='ltr'] .ev .c { text-align: left; }
            .none { margin: 0; font-size: 7.5pt; color: #4a5367; }
            footer { display: flex; justify-content: space-between; margin-top: 2mm; font-size: 7.5pt; color: #4a5367; }
          </style></head><body>
          <header><h1>${escapeHtml(title)}</h1><img src="${location.origin}/images/brand/logo-full.svg" alt="ETUDE"></header>
          <p class="week">${L.week} <bdi dir="ltr">${dm(dates[0])} – ${dm(dates[6])}</bdi></p>
          <div class="grid">${cols}</div>
          <footer><span>etude.ristar.co</span><span>${L.updated}: ${new Date().toLocaleDateString(L.locale)}</span></footer>
          </body></html>`;

        document.getElementById('ttPrintFrame')?.remove();
        const frame = document.createElement('iframe');
        frame.id = 'ttPrintFrame';
        frame.setAttribute('aria-hidden', 'true');
        frame.style.cssText = 'position:fixed;inset-inline-end:0;bottom:0;width:0;height:0;border:0;visibility:hidden';
        document.body.appendChild(frame);
        const doc = frame.contentDocument;
        doc.open();
        doc.write(html);
        doc.close();
        // Print once the logo and fonts are in (with a timeout as a safety net).
        const ready = Promise.all([
          new Promise((r) => { const img = doc.querySelector('img'); img.complete ? r() : (img.onload = img.onerror = r); }),
          doc.fonts ? doc.fonts.ready : Promise.resolve(),
        ]);
        Promise.race([ready, new Promise((r) => setTimeout(r, 2500))]).then(() => {
          frame.contentWindow.focus();
          frame.contentWindow.print();
        });
      }

      window.addEventListener('weekgrid-ready', () => ttWeek && renderTtWeek());

      async function loadTimetable() {
        $('ttCurrentStatus').textContent = 'Loading…';
        $('ttCurrentStatus').className = 'status-msg pending';
        try {
          const res = await fetch(`/data/timetable.json?t=${Date.now()}`, { cache: 'no-store' });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const tt = await res.json();
          const days = (tt.days || []).filter((d) => d.date).sort((a, b) => a.date.localeCompare(b.date));
          if (!days.length) {
            $('ttCurrentStatus').textContent = 'No classes found in the sheet yet.';
            $('ttCurrentStatus').className = 'status-msg';
            $('ttCurrent').hidden = true;
            $('ttDays').innerHTML = '';
            return;
          }
          ttDaysCache = days;
          ttWeeks = [...new Set(days.map((d) => sundayOf(d.date)))].sort();
          const thisSunday = sundayOf(new Date().toISOString().slice(0, 10));
          ttWeek = ttWeeks.includes(ttWeek) ? ttWeek : ttWeeks.find((w) => w >= thisSunday) ?? ttWeeks[ttWeeks.length - 1];
          const classes = days.reduce((n, d) => n + d.items.length, 0);
          $('ttCurrent').hidden = false;
          $('ttCurrent').innerHTML = `
            <div><strong>${fmtDate(days[0].date)} – ${fmtDate(days[days.length - 1].date)}</strong>${ttWeeks.length} weeks · ${classes} entries</div>
            ${tt.updatedAt ? `<div><strong>${escapeHtml(new Date(tt.updatedAt).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }))}</strong>last read from the sheet</div>` : ''}`;
          renderTtWeek();
          $('ttCurrentStatus').textContent = '';
          $('ttCurrentStatus').className = 'status-msg';
        } catch (err) {
          $('ttCurrentStatus').textContent = 'Could not load the timetable: ' + err.message;
          $('ttCurrentStatus').className = 'status-msg bad';
        }
      }

      // "Update now": an empty commit on the branch triggers the deploy workflow,
      // which re-reads the sheet. Needs only the token's Contents permission.
      async function ghApi(path, options = {}) {
        const res = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/${path}`, {
          cache: 'no-store',
          ...options,
          headers: {
            Authorization: `Bearer ${getToken()}`,
            Accept: 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
            ...(options.headers || {}),
          },
        });
        if (!res.ok) throw await ghError(res);
        return res.json();
      }

      $('ttRefreshBtn').addEventListener('click', async () => {
        if (!getToken()) {
          $('ttRefreshStatus').textContent = 'Save a GitHub token first (top of the page).';
          $('ttRefreshStatus').className = 'status-msg bad';
          return;
        }
        $('ttRefreshBtn').disabled = true;
        $('ttRefreshStatus').textContent = 'Starting…';
        $('ttRefreshStatus').className = 'status-msg pending';
        try {
          const ref = await ghApi(`git/ref/heads/${ADMIN_BRANCH}`);
          const parent = await ghApi(`git/commits/${ref.object.sha}`);
          const commit = await ghApi('git/commits', {
            method: 'POST',
            body: JSON.stringify({ message: 'chore(timetable): refresh from Google Sheet via admin panel', tree: parent.tree.sha, parents: [ref.object.sha] }),
          });
          await ghApi(`git/refs/heads/${ADMIN_BRANCH}`, { method: 'PATCH', body: JSON.stringify({ sha: commit.sha }) });
          $('ttRefreshStatus').textContent = 'Update started — the screen and this list refresh in about 2–3 minutes.';
          $('ttRefreshStatus').className = 'status-msg ok';
        } catch (err) {
          $('ttRefreshStatus').textContent = 'Could not start the update: ' + err.message;
          $('ttRefreshStatus').className = 'status-msg bad';
        } finally {
          $('ttRefreshBtn').disabled = false;
        }
      });

      // ---------- News body formatting toolbar ----------
      // Inserts the light markup that src/lib/richText.ts renders on the site.
      function wrapSelection(area, before, after = before, placeholder = 'text') {
        const { selectionStart: start, selectionEnd: end, value } = area;
        const selected = value.slice(start, end) || placeholder;
        area.setRangeText(before + selected + after, start, end, 'end');
        area.setSelectionRange(start + before.length, start + before.length + selected.length);
        area.focus();
      }

      function addLink(area) {
        const url = (prompt('Link address (https://…, or a site page like /he/contact/):', 'https://') || '').trim();
        if (!url || url === 'https://') return;
        if (!/^(https?:\/\/|mailto:|tel:|\/)/i.test(url)) {
          alert('The link must start with https://, http://, mailto:, tel: or /');
          return;
        }
        wrapSelection(area, '[', `](${url})`, 'link text');
      }

      function toggleList(area) {
        const { selectionStart: start, selectionEnd: end, value } = area;
        const lineStart = value.lastIndexOf('\n', start - 1) + 1;
        const nl = value.indexOf('\n', end);
        const lineEnd = nl === -1 ? value.length : nl;
        const lines = value.slice(lineStart, lineEnd).split('\n');
        const allListed = lines.every((l) => /^- /.test(l));
        const next = lines.map((l) => (allListed ? l.replace(/^- /, '') : /^- /.test(l) ? l : '- ' + l)).join('\n');
        area.setRangeText(next, lineStart, lineEnd, 'select');
        area.focus();
      }

      document.querySelectorAll('textarea[data-rich]').forEach((area) => {
        const wrap = document.createElement('div');
        wrap.className = 'rich-wrap';
        const bar = document.createElement('div');
        bar.className = 'rich-bar';
        const buttons = [
          ['<b>B</b>', 'Bold', () => wrapSelection(area, '**')],
          ['<i>I</i>', 'Italic', () => wrapSelection(area, '*')],
          ['<u>U</u>', 'Underline', () => wrapSelection(area, '__')],
          ['🔗', 'Link', () => addLink(area)],
          ['• List', 'Bulleted list', () => toggleList(area)],
        ];
        for (const [html, title, action] of buttons) {
          const b = document.createElement('button');
          b.type = 'button';
          b.innerHTML = html;
          b.title = title;
          b.addEventListener('click', action);
          bar.appendChild(b);
        }
        area.replaceWith(wrap);
        wrap.append(bar, area);
      });

      // ---------- Init ----------
      function initAdmin() {
        refreshTokenUi();
        if (getToken()) {
          loadNews();
          loadSchedule();
          loadInstructors();
          loadSettings();
          loadStudent();
        }
        loadTimetable();
      }
    </script>
    <script>
      import { weekGrid } from '../../lib/weekGrid';
      (window as any).weekGrid = weekGrid;
      window.dispatchEvent(new Event('weekgrid-ready'));
    </script>
  </body>
</html>
