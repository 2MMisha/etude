    <script define:vars={{ REPO_OWNER, REPO_NAME, ADMIN_BRANCH, ADMIN_PASSWORD_SHA256 }}>
      const NEWS_DIR = 'src/content/news';
      const SCHEDULE_DIR = 'src/content/schedule';
      const INSTRUCTORS_DIR = 'src/content/instructors';
      const SETTINGS_PATH = 'src/data/site-settings.json';
      const STUDENT_PATH = 'src/data/student-app.json';
      const SLUG_PATTERN = /^[a-z0-9]+(-[a-z0-9]+)*$/;
      const TIME_PATTERN = /^([01]\d|2[0-3]):[0-5]\d$/;

      const $ = (id) => document.getElementById(id);

      // ---------- Password gate ----------
      async function sha256Hex(text) {
        const data = new TextEncoder().encode(text);
        const digest = await crypto.subtle.digest('SHA-256', data);
        return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
      }

      function showMain() {
        $('lockScreen').hidden = true;
        $('adminMain').hidden = false;
        initAdmin();
      }

      if (sessionStorage.getItem('etudeAdminUnlocked') === '1') {
        showMain();
      }

      $('unlockBtn').addEventListener('click', tryUnlock);
      $('passwordInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') tryUnlock(); });

      async function tryUnlock() {
        const value = $('passwordInput').value;
        const hash = await sha256Hex(value);
        if (hash === ADMIN_PASSWORD_SHA256) {
          sessionStorage.setItem('etudeAdminUnlocked', '1');
          $('lockError').textContent = '';
          showMain();
        } else {
          $('lockError').textContent = 'Incorrect password.';
        }
      }

      $('lockBtn').addEventListener('click', () => {
        sessionStorage.removeItem('etudeAdminUnlocked');
        location.reload();
      });

      // ---------- UTF-8 safe base64 ----------
      function b64Encode(str) {
        return btoa(encodeURIComponent(str).replace(/%([0-9A-F]{2})/g, (_, p1) => String.fromCharCode(parseInt(p1, 16))));
      }
      function b64Decode(b64) {
        return decodeURIComponent(atob(b64).split('').map((c) => '%' + c.charCodeAt(0).toString(16).padStart(2, '0')).join(''));
      }

      // ---------- GitHub API ----------
      function getToken() { return localStorage.getItem('etudeAdminGhToken') || ''; }

      async function ghRequest(path, options = {}) {
        const token = getToken();
        const res = await fetch(`https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${path}`, {
          cache: 'no-store', // GitHub caches GETs ~60s; a stale sha makes the next save fail with 409
          ...options,
          headers: {
            Authorization: `Bearer ${token}`,
            Accept: 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
            ...(options.headers || {}),
          },
        });
        return res;
      }

      async function ghGetFile(path) {
        const res = await ghRequest(`${path}?ref=${ADMIN_BRANCH}`);
        if (res.status === 404) return null;
        if (!res.ok) throw await ghError(res);
        const data = await res.json();
        return { sha: data.sha, content: b64Decode(data.content.replace(/\n/g, '')) };
      }

      async function ghListDir(dir) {
        const res = await ghRequest(`${dir}?ref=${ADMIN_BRANCH}`);
        if (res.status === 404) return [];
        if (!res.ok) throw await ghError(res);
        return res.json();
      }

      async function ghPutFile(path, obj, sha, message) {
        const body = {
          message,
          content: b64Encode(JSON.stringify(obj, null, 2) + '\n'),
          branch: ADMIN_BRANCH,
        };
        if (sha) body.sha = sha;
        return ghWrite(path, 'PUT', body);
      }

      async function ghDeleteFile(path, sha, message) {
        return ghWrite(path, 'DELETE', { message, sha, branch: ADMIN_BRANCH });
      }

      // On 409 (our sha is stale, or another commit landed at the same moment)
      // re-read the file's current sha and retry. New files (no sha) never conflict this way.
      async function ghWrite(path, method, body) {
        for (let attempt = 0; ; attempt++) {
          const res = await ghRequest(path, { method, body: JSON.stringify(body) });
          if (res.ok) return res.json();
          if (res.status !== 409 || !body.sha || attempt >= 3) throw await ghError(res);
          const latest = await ghGetFile(path);
          if (!latest) throw new Error('The file was removed by someone else — reload the page.');
          body.sha = latest.sha;
          await new Promise((r) => setTimeout(r, 500 * (attempt + 1)));
        }
      }

      async function ghError(res) {
        let msg = `${res.status} ${res.statusText}`;
        try {
          const data = await res.json();
          if (data.message) msg = `${res.status}: ${data.message}`;
        } catch {}
        return new Error(msg);
      }

      // ---------- Token panel ----------
      function refreshTokenUi() {
        const token = getToken();
        $('tokenInput').value = token ? '••••••••••••' : '';
        $('tokenStatus').textContent = token ? 'A token is saved in this browser.' : 'No token saved yet.';
        $('tokenStatus').className = 'token-status ' + (token ? 'ok' : '');
      }

      $('saveTokenBtn').addEventListener('click', async () => {
        const value = $('tokenInput').value.trim();
        if (!value || value.startsWith('••')) return;
        localStorage.setItem('etudeAdminGhToken', value);
        refreshTokenUi();
        $('tokenStatus').textContent = 'Checking access…';
        $('tokenStatus').className = 'token-status';
        try {
          const res = await ghRequest('');
          if (res.ok || res.status === 404) {
            $('tokenStatus').textContent = 'Token saved and repository is reachable.';
            $('tokenStatus').className = 'token-status ok';
            loadNews();
            loadSchedule();
            loadInstructors();
            loadSettings();
            loadStudent();
          } else {
            throw await ghError(res);
          }
        } catch (err) {
          $('tokenStatus').textContent = 'Token saved, but access check failed: ' + err.message;
          $('tokenStatus').className = 'token-status bad';
        }
      });

      $('forgetTokenBtn').addEventListener('click', () => {
        localStorage.removeItem('etudeAdminGhToken');
        refreshTokenUi();
      });

      // ---------- Tabs ----------
      $('tabNewsBtn').addEventListener('click', () => switchTab('news'));
      $('tabScheduleBtn').addEventListener('click', () => switchTab('schedule'));
      $('tabInstructorsBtn').addEventListener('click', () => switchTab('instructors'));
      $('tabSettingsBtn').addEventListener('click', () => switchTab('settings'));
      $('tabTimetableBtn').addEventListener('click', () => switchTab('timetable'));
      $('tabStudentBtn').addEventListener('click', () => switchTab('student'));
      function switchTab(which) {
        $('tabStudentBtn').classList.toggle('active', which === 'student');
        $('studentSection').hidden = which !== 'student';
        $('tabTimetableBtn').classList.toggle('active', which === 'timetable');
        $('timetableSection').hidden = which !== 'timetable';
        $('tabNewsBtn').classList.toggle('active', which === 'news');
        $('tabScheduleBtn').classList.toggle('active', which === 'schedule');
        $('tabInstructorsBtn').classList.toggle('active', which === 'instructors');
        $('tabSettingsBtn').classList.toggle('active', which === 'settings');
        $('newsSection').hidden = which !== 'news';
        $('scheduleSection').hidden = which !== 'schedule';
        $('instructorsSection').hidden = which !== 'instructors';
        $('settingsSection').hidden = which !== 'settings';
      }

      // ---------- News ----------
      let newsCache = [];

      async function loadNews() {
        $('newsListStatus').textContent = 'Loading…';
        $('newsListStatus').className = 'status-msg pending';
        try {
          const files = await ghListDir(NEWS_DIR);
          newsCache = await Promise.all(
            files.filter((f) => f.name.endsWith('.json')).map(async (f) => {
              const file = await ghGetFile(f.path);
              const data = JSON.parse(file.content);
              return { id: f.name.replace(/\.json$/, ''), sha: file.sha, data };
            })
          );
          newsCache.sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));
          renderNewsTable();
          $('newsListStatus').textContent = newsCache.length ? '' : 'No posts yet.';
          $('newsListStatus').className = 'status-msg';
        } catch (err) {
          $('newsListStatus').textContent = 'Could not load posts: ' + err.message;
          $('newsListStatus').className = 'status-msg bad';
        }
      }

      function renderNewsTable() {
        const table = $('newsTable');
        const tbody = table.querySelector('tbody');
        tbody.innerHTML = '';
        table.hidden = newsCache.length === 0;
        for (const post of newsCache) {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>${escapeHtml(post.data.date || '')}</td>
            <td>${escapeHtml(post.data.title?.en || '')}</td>
            <td><code>${escapeHtml(post.id)}</code></td>
            <td class="actions"></td>
          `;
          const actionsTd = tr.querySelector('.actions');
          const editBtn = document.createElement('button');
          editBtn.className = 'btn-mini';
          editBtn.textContent = 'Edit';
          editBtn.addEventListener('click', () => openNewsForm(post));
          const delBtn = document.createElement('button');
          delBtn.className = 'btn-mini danger';
          delBtn.textContent = 'Delete';
          delBtn.addEventListener('click', () => deleteNews(post));
          actionsTd.append(editBtn, delBtn);
          tbody.appendChild(tr);
        }
      }

      let editingNewsId = null;
      let editingNewsSha = null;

      $('newNewsBtn').addEventListener('click', () => openNewsForm(null));
      $('cancelNewsBtn').addEventListener('click', () => { $('newsForm').hidden = true; });

      function openNewsForm(post) {
        $('newsForm').hidden = false;
        $('newsSaveStatus').textContent = '';
        $('newsIdError').textContent = '';
        $('newsDateError').textContent = '';
        if (post) {
          $('newsFormTitle').textContent = 'Edit post: ' + post.id;
          $('newsId').value = post.id;
          $('newsId').disabled = true;
          $('newsDate').value = post.data.date || '';
          $('newsImage').value = post.data.image || '';
          for (const l of ['He', 'En', 'Ru']) {
            $('newsImageAlt' + l).value = post.data.imageAlt?.[l.toLowerCase()] || '';
            $('newsImageCredit' + l).value = post.data.imageCredit?.[l.toLowerCase()] || '';
          }
          $('newsTitleHe').value = post.data.title?.he || '';
          $('newsTitleEn').value = post.data.title?.en || '';
          $('newsTitleRu').value = post.data.title?.ru || '';
          $('newsBodyHe').value = post.data.body?.he || '';
          $('newsBodyEn').value = post.data.body?.en || '';
          $('newsBodyRu').value = post.data.body?.ru || '';
          editingNewsId = post.id;
          editingNewsSha = post.sha;
        } else {
          $('newsFormTitle').textContent = 'New post';
          $('newsId').value = '';
          $('newsId').disabled = false;
          $('newsDate').value = '';
          $('newsImage').value = '';
          for (const l of ['He', 'En', 'Ru']) {
            $('newsImageAlt' + l).value = '';
            $('newsImageCredit' + l).value = '';
          }
          $('newsTitleHe').value = '';
          $('newsTitleEn').value = '';
          $('newsTitleRu').value = '';
          $('newsBodyHe').value = '';
          $('newsBodyEn').value = '';
          $('newsBodyRu').value = '';
          editingNewsId = null;
          editingNewsSha = null;
        }
        $('newsForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      $('saveNewsBtn').addEventListener('click', async () => {
        const id = (editingNewsId || $('newsId').value).trim().toLowerCase();
        $('newsIdError').textContent = '';
        $('newsDateError').textContent = '';
        if (!SLUG_PATTERN.test(id)) {
          $('newsIdError').textContent = 'Use lowercase letters, numbers, and hyphens only (e.g. "autumn-open-house").';
          return;
        }
        const date = $('newsDate').value;
        if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
          $('newsDateError').textContent = 'Pick a date.';
          return;
        }
        const post = {
          date,
          image: $('newsImage').value.trim(),
          imageAlt: { he: $('newsImageAltHe').value.trim(), en: $('newsImageAltEn').value.trim(), ru: $('newsImageAltRu').value.trim() },
          imageCredit: { he: $('newsImageCreditHe').value.trim(), en: $('newsImageCreditEn').value.trim(), ru: $('newsImageCreditRu').value.trim() },
          title: { he: $('newsTitleHe').value, en: $('newsTitleEn').value, ru: $('newsTitleRu').value },
          body: { he: $('newsBodyHe').value, en: $('newsBodyEn').value, ru: $('newsBodyRu').value },
        };
        for (const [lang, val] of Object.entries(post.title)) {
          if (!val.trim()) { $('newsIdError').textContent = `Title (${lang}) is required.`; return; }
        }
        for (const [lang, val] of Object.entries(post.body)) {
          if (!val.trim()) { $('newsIdError').textContent = `Body (${lang}) is required.`; return; }
        }
        $('newsSaveStatus').textContent = 'Saving…';
        $('newsSaveStatus').className = 'status-msg pending';
        try {
          const sha = editingNewsId === id ? editingNewsSha : null;
          await ghPutFile(`${NEWS_DIR}/${id}.json`, post, sha, `chore(news): ${editingNewsId ? 'update' : 'add'} "${id}" via admin panel`);
          $('newsSaveStatus').textContent = 'Saved. The site will rebuild in about 1–2 minutes.';
          $('newsSaveStatus').className = 'status-msg ok';
          $('newsForm').hidden = true;
          loadNews();
        } catch (err) {
          $('newsSaveStatus').textContent = 'Save failed: ' + err.message;
          $('newsSaveStatus').className = 'status-msg bad';
        }
      });

      async function deleteNews(post) {
        if (!confirm(`Delete news post "${post.id}"? This cannot be undone.`)) return;
        try {
