---
// Hidden staff-only content panel — replaces the old GitHub Actions
// "News/Schedule: Add/Update/Delete" workflows with a proper in-browser UI.
// Not linked from any nav; gated by a password + a GitHub token the admin
// supplies themselves. See README "Editing content: the admin panel".
import { SITE } from '../../lib/site';
import { ADMIN_PASSWORD_SHA256, ADMIN_BRANCH } from '../../lib/adminConfig';
import { TIMETABLE_SHEET_ID } from '../../lib/loadTimetable';
import QRCode from 'qrcode';
import '../../styles/global.css';
import '../../styles/week-grid.css';

const REPO_OWNER = SITE.githubOrg;
const REPO_NAME = SITE.repoName;
const SHEET_URL = `https://docs.google.com/spreadsheets/d/${TIMETABLE_SHEET_ID}/edit`;
// The students' app link and its QR code (for printing in the studio).
const APP_URL = `${SITE.siteUrl}/student/`;
const APP_QR = await QRCode.toString(APP_URL, { type: 'svg', margin: 1, color: { dark: '#17224a', light: '#ffffff' } });
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>ETUDE — Admin</title>
    <style is:global>
      body { background: var(--color-ground); }
      .admin-shell { max-width: 880px; margin-inline: auto; padding: var(--space-lg) var(--space-sm) var(--space-xl); }
      .admin-brand { display: flex; align-items: center; gap: 0.6rem; margin-block-end: var(--space-md); }
      .admin-brand img { width: 32px; height: 32px; }
      .admin-brand span { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: var(--color-navy-900); }

      .lock-screen { max-width: 360px; margin: 15vh auto 0; text-align: center; }
      .lock-screen input { width: 100%; padding: 0.7em 0.9em; border: 1px solid var(--color-line); border-radius: var(--radius-sm); font-size: 1rem; margin-block: var(--space-sm); }
      .lock-error { color: #b3261e; font-size: 0.9rem; min-height: 1.4em; }

      .warning-box {
        background: #fff7e6; border: 1px solid #f0c674; border-radius: var(--radius-md);
        padding: var(--space-sm) var(--space-md); font-size: 0.88rem; color: #6b4e00; margin-block-end: var(--space-md);
      }
      .warning-box strong { display: block; margin-block-end: 0.3em; }

      .panel { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-md); margin-block-end: var(--space-lg); }
      .panel h2 { margin-block-end: 0.4em; }
      .panel .hint { font-size: 0.85rem; color: var(--color-ink-soft); margin-block-end: var(--space-sm); }
      .token-row { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
      .token-row input[type="password"], .token-row input[type="text"] { flex: 1; min-width: 220px; padding: 0.55em 0.7em; border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
      .token-status { font-size: 0.85rem; margin-block-start: 0.5em; }
      .token-status.ok { color: #1b7a3d; }
      .token-status.bad { color: #b3261e; }

      .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-end: var(--space-md); }
      .tab-btn { padding: 0.5em 1.1em; border-radius: 999px; border: 1px solid var(--color-line); background: var(--color-surface); cursor: pointer; font-weight: 600; font-size: 0.9rem; }
      .tab-btn.active { background: var(--color-navy-900); color: #fff; border-color: var(--color-navy-900); }

      table.data-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      table.data-table th, table.data-table td { text-align: left; padding: 0.5em 0.6em; border-block-end: 1px solid var(--color-line); vertical-align: top; }
      table.data-table td.actions { white-space: nowrap; }
      table.data-table td.actions button { margin-inline-end: 0.4em; }

      .btn-mini { padding: 0.35em 0.8em; font-size: 0.82rem; border-radius: var(--radius-sm); border: 1px solid var(--color-line); background: var(--color-silver-100); cursor: pointer; }
      .btn-mini.danger { color: #b3261e; border-color: #eab8b3; }
      .btn-mini.primary { background: var(--color-navy-900); color: #fff; border-color: var(--color-navy-900); }

      .form-grid { display: grid; gap: 0.7rem; margin-block-start: var(--space-sm); }
      .form-grid label { display: block; font-size: 0.85rem; font-weight: 600; margin-block-end: 0.25em; color: var(--color-ink); }
      .form-grid input, .form-grid select, .form-grid textarea { width: 100%; padding: 0.55em 0.7em; border: 1px solid var(--color-line); border-radius: var(--radius-sm); font-family: inherit; font-size: 0.95rem; }
      .form-grid textarea { min-height: 4.5em; resize: vertical; }
      .lang-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
      @media (max-width: 700px) { .lang-grid { grid-template-columns: 1fr; } }
      .row-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
      @media (max-width: 700px) { .row-3 { grid-template-columns: 1fr; } }

      .field-error { color: #b3261e; font-size: 0.8rem; margin-block-start: 0.2em; }
      .form-actions { display: flex; gap: 0.6rem; margin-block-start: var(--space-sm); align-items: center; }
      .status-msg { font-size: 0.88rem; padding: 0.5em 0; }
      .status-msg.ok { color: #1b7a3d; }
      .status-msg.bad { color: #b3261e; }
      .status-msg.pending { color: var(--color-ink-soft); }

      .tt-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.6rem; margin-block: var(--space-sm); }
      .tt-summary div { background: var(--color-silver-100); border-radius: var(--radius-sm); padding: 0.6em 0.8em; font-size: 0.85rem; }
      .tt-summary strong { display: block; font-size: 1rem; color: var(--color-navy-900); }
      .tt-weekbar { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-block: var(--space-sm) 0.6rem; font-size: 0.9rem; }
      .tt-print { display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap; margin-block: 0 0.6rem; font-size: 0.82rem; color: var(--color-ink-soft); }
      .tt-print select { font: inherit; padding: 0.25em 0.4em; border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
      .tt-print .tt-rent-btn { background: #fff4e0; border-color: #f0c674; }
      .admin-shell:has(#timetableSection:not([hidden])) { max-width: 1280px; }

      .rich-wrap { display: flex; flex-direction: column; gap: 0.3rem; }
      .rich-bar { display: flex; gap: 0.3rem; flex-wrap: wrap; }
      .rich-bar button { min-width: 2.1em; padding: 0.2em 0.55em; font-size: 0.85rem; border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); cursor: pointer; line-height: 1.4; }
      .rich-bar button:hover { background: var(--color-silver-100); }
      .form-grid .rich-wrap textarea { min-height: 9em; }

      .inline-check { width: auto !important; display: inline-block; margin-inline-end: 0.4em; }
      .subtabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-block-start: var(--space-sm); }
      .subtabs button { padding: 0.4em 0.9em; border-radius: 999px; border: 1px solid var(--color-line); background: var(--color-silver-100); cursor: pointer; font-weight: 600; font-size: 0.85rem; }
      .subtabs button.active { background: var(--color-blue-600); color: #fff; border-color: var(--color-blue-600); }
      .sa-share { display: flex; gap: var(--space-sm); align-items: center; font-size: 0.88rem; margin-block-end: var(--space-sm); overflow-wrap: anywhere; }
      .sa-share svg { width: 96px; height: 96px; flex: none; border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
      .rows { display: grid; gap: 0.8rem; margin-block-end: 0.8rem; }
      .row-card { border: 1px solid var(--color-line); border-radius: var(--radius-sm); padding: 0.8rem; display: grid; gap: 0.6rem; background: var(--color-surface); }
      .row-card.past { opacity: 0.6; }
      .row-card .row-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.9rem; }
      .row-card label { display: block; font-size: 0.8rem; font-weight: 600; margin-block-end: 0.2em; }
      .row-card input, .row-card textarea, .row-card select { width: 100%; padding: 0.45em 0.6em; border: 1px solid var(--color-line); border-radius: var(--radius-sm); font: inherit; font-size: 0.9rem; box-sizing: border-box; }
      .row-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; }
      @media (max-width: 700px) { .row-4 { grid-template-columns: 1fr 1fr; } }
      .save-bar {
        position: sticky; bottom: 0; z-index: 3; display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap;
        background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md);
        padding: 0.7rem var(--space-md); box-shadow: 0 -6px 18px rgba(23, 34, 74, 0.08);
      }

      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <div class="admin-shell">
      <div class="admin-brand">
        <img src="/images/brand/icon.svg" alt="" />
        <span>ETUDE — Admin</span>
      </div>

      <div id="lockScreen" class="lock-screen">
        <h1 style="font-size:1.3rem">Staff access</h1>
        <p class="hint">Enter the admin password to continue.</p>
        <input type="password" id="passwordInput" placeholder="Password" autocomplete="current-password" />
        <button class="btn-mini primary" id="unlockBtn" style="width:100%; padding-block:0.6em;">Unlock</button>
        <p class="lock-error" id="lockError"></p>
      </div>

      <div id="adminMain" hidden>
        <div class="warning-box">
          <strong>How this works</strong>
          This page writes directly to the site's GitHub repository using a personal access token you provide below —
          it is stored only in this browser (localStorage), never sent anywhere but api.github.com. Don't use this on a
          shared or public computer, and use a token scoped to only this one repository. Saving anything here —
          a news post, a schedule slot, an instructor, the site settings, or a timetable update — pushes a commit to
          <code>{REPO_OWNER}/{REPO_NAME}</code>, which rebuilds the live site automatically within about 1–2 minutes.
        </div>

        <div class="panel">
          <h2 style="font-size:1.05rem">GitHub access</h2>
          <p class="hint">
            Create a fine-grained token at
            <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">github.com/settings/personal-access-tokens/new</a>
            scoped to the <code>{REPO_OWNER}/{REPO_NAME}</code> repository only, with <strong>Contents: Read and write</strong> permission.
          </p>
          <div class="token-row">
            <input type="password" id="tokenInput" placeholder="GitHub personal access token" autocomplete="off" />
            <button class="btn-mini primary" id="saveTokenBtn">Save token</button>
            <button class="btn-mini" id="forgetTokenBtn">Forget token</button>
            <button class="btn-mini" id="lockBtn">Lock panel</button>
          </div>
          <p class="token-status" id="tokenStatus"></p>
        </div>

        <div class="tabs">
          <button class="tab-btn active" id="tabNewsBtn">News posts</button>
          <button class="tab-btn" id="tabStudentBtn">📱 Students' app</button>
          <button class="tab-btn" id="tabScheduleBtn">Schedule slots</button>
          <button class="tab-btn" id="tabInstructorsBtn">Instructors</button>
          <button class="tab-btn" id="tabSettingsBtn">Site settings</button>
          <button class="tab-btn" id="tabTimetableBtn">Timetable (Google Sheet)</button>
        </div>

        <section id="newsSection">
          <div class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <h2 style="font-size:1.05rem">News posts</h2>
              <button class="btn-mini primary" id="newNewsBtn">+ New post</button>
            </div>
            <p class="status-msg" id="newsListStatus"></p>
            <div style="overflow-x:auto">
              <table class="data-table" id="newsTable" hidden>
                <thead><tr><th>Date</th><th>Title (EN)</th><th>ID</th><th></th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
          </div>

          <div class="panel" id="newsForm" hidden>
            <h2 style="font-size:1.05rem" id="newsFormTitle">New post</h2>
            <div class="form-grid">
              <div>
                <label for="newsId">Post ID (lowercase, hyphens only — reusing an existing ID overwrites it)</label>
                <input type="text" id="newsId" placeholder="autumn-open-house" />
                <p class="field-error" id="newsIdError"></p>
              </div>
              <div>
                <label for="newsDate">Date</label>
                <input type="date" id="newsDate" />
                <p class="field-error" id="newsDateError"></p>
              </div>
              <div>
                <label for="newsImage">Image URL (optional)</label>
                <input type="text" id="newsImage" placeholder="https://…" />
              </div>
              <div>
                <label>Photo description (alt text, shown under the photo)</label>
                <div class="lang-grid">
                  <input type="text" id="newsImageAltHe" placeholder="עברית" dir="rtl" />
                  <input type="text" id="newsImageAltEn" placeholder="English" />
                  <input type="text" id="newsImageAltRu" placeholder="Русский" />
                </div>
              </div>
              <div>
                <label>Photo by (optional)</label>
                <div class="lang-grid">
                  <input type="text" id="newsImageCreditHe" placeholder="מיכאל מוקרושוב (2M Photo)" dir="rtl" />
                  <input type="text" id="newsImageCreditEn" placeholder="Michael Mokrushov (2M Photo)" />
                  <input type="text" id="newsImageCreditRu" placeholder="Михаил Мокрушов (2M Photo)" />
                </div>
              </div>
              <div>
                <label>Title</label>
                <div class="lang-grid">
                  <input type="text" id="newsTitleHe" placeholder="עברית" dir="rtl" />
                  <input type="text" id="newsTitleEn" placeholder="English" />
                  <input type="text" id="newsTitleRu" placeholder="Русский" />
                </div>
              </div>
              <div>
                <label>Body</label>
                <p class="hint" style="margin:0 0 0.4em">
                  Select text and use the buttons, or type it yourself:
                  <code>**bold**</code> · <code>*italic*</code> · <code>__underline__</code> ·
                  <code>[link text](https://…)</code> · a line starting with <code>- </code> is a list item ·
                  an empty line starts a new paragraph.
                </p>
                <div class="lang-grid">
                  <textarea id="newsBodyHe" placeholder="עברית" dir="rtl" data-rich></textarea>
                  <textarea id="newsBodyEn" placeholder="English" data-rich></textarea>
                  <textarea id="newsBodyRu" placeholder="Русский" data-rich></textarea>
                </div>
              </div>
            </div>
            <div class="form-actions">
              <button class="btn-mini primary" id="saveNewsBtn">Save post</button>
              <button class="btn-mini" id="cancelNewsBtn">Cancel</button>
              <span class="status-msg" id="newsSaveStatus"></span>
            </div>
          </div>
        </section>

        <section id="scheduleSection" hidden>
          <div class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <h2 style="font-size:1.05rem">Schedule slots</h2>
              <button class="btn-mini primary" id="newSlotBtn">+ New slot</button>
            </div>
            <p class="status-msg" id="scheduleListStatus"></p>
            <div style="overflow-x:auto">
              <table class="data-table" id="scheduleTable" hidden>
                <thead><tr><th>Day</th><th>Time</th><th>Class (EN)</th><th>Level</th><th>ID</th><th></th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
          </div>

          <div class="panel" id="scheduleForm" hidden>
            <h2 style="font-size:1.05rem" id="scheduleFormTitle">New slot</h2>
            <div class="form-grid">
              <div>
                <label for="slotId">Slot ID (lowercase, hyphens only — reusing an existing ID overwrites it)</label>
                <input type="text" id="slotId" placeholder="mon-latin-beginner" />
                <p class="field-error" id="slotIdError"></p>
              </div>
              <div class="row-3">
                <div>
                  <label for="slotDay">Day</label>
                  <select id="slotDay">
                    <option value="sunday">Sunday</option>
                    <option value="monday">Monday</option>
                    <option value="tuesday">Tuesday</option>
                    <option value="wednesday">Wednesday</option>
                    <option value="thursday">Thursday</option>
                    <option value="friday">Friday</option>
                    <option value="saturday">Saturday</option>
                  </select>
                </div>
                <div>
                  <label for="slotLevel">Level</label>
                  <select id="slotLevel">
                    <option value="beginner">Beginner</option>
                    <option value="intermediate">Intermediate</option>
                    <option value="advanced">Advanced</option>
                    <option value="private">Private</option>
                  </select>
                </div>
                <div></div>
              </div>
              <div class="row-3">
                <div>
                  <label for="slotStart">Start time (24h)</label>
                  <input type="time" id="slotStart" />
                </div>
                <div>
                  <label for="slotEnd">End time (24h)</label>
                  <input type="time" id="slotEnd" />
                </div>
                <div></div>
              </div>
              <p class="field-error" id="slotTimeError"></p>
              <div>
                <label>Class name</label>
                <div class="lang-grid">
                  <input type="text" id="slotNameHe" placeholder="עברית" dir="rtl" />
                  <input type="text" id="slotNameEn" placeholder="English" />
                  <input type="text" id="slotNameRu" placeholder="Русский" />
                </div>
              </div>
            </div>
            <div class="form-actions">
              <button class="btn-mini primary" id="saveSlotBtn">Save slot</button>
              <button class="btn-mini" id="cancelSlotBtn">Cancel</button>
              <span class="status-msg" id="scheduleSaveStatus"></span>
            </div>
          </div>
        </section>

        <section id="instructorsSection" hidden>
          <div class="panel">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <h2 style="font-size:1.05rem">Instructors</h2>
              <button class="btn-mini primary" id="newInstructorBtn">+ New instructor</button>
            </div>
            <p class="status-msg" id="instructorsListStatus"></p>
            <div style="overflow-x:auto">
              <table class="data-table" id="instructorsTable" hidden>
                <thead><tr><th>Order</th><th>Name (EN)</th><th>ID</th><th></th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
          </div>

          <div class="panel" id="instructorForm" hidden>
            <h2 style="font-size:1.05rem" id="instructorFormTitle">New instructor</h2>
            <div class="form-grid">
              <div>
                <label for="instructorId">Instructor ID (lowercase, hyphens only — reusing an existing ID overwrites it)</label>
                <input type="text" id="instructorId" placeholder="jane-doe" />
                <p class="field-error" id="instructorIdError"></p>
              </div>
              <div class="row-3">
                <div>
                  <label for="instructorOrder">Display order (lower shows first)</label>
                  <input type="number" id="instructorOrder" step="1" value="1" />
                </div>
                <div style="grid-column: span 2">
                  <label for="instructorPhoto">Photo URL (optional)</label>
                  <input type="text" id="instructorPhoto" placeholder="https://…" />
                </div>
              </div>
              <div>
                <label>Name</label>
                <div class="lang-grid">
                  <input type="text" id="instructorNameHe" placeholder="עברית" dir="rtl" />
                  <input type="text" id="instructorNameEn" placeholder="English" />
                  <input type="text" id="instructorNameRu" placeholder="Русский" />
                </div>
              </div>
              <div>
                <label>Bio</label>
                <div class="lang-grid">
                  <textarea id="instructorBioHe" placeholder="עברית" dir="rtl"></textarea>
                  <textarea id="instructorBioEn" placeholder="English"></textarea>
                  <textarea id="instructorBioRu" placeholder="Русский"></textarea>
                </div>
              </div>
            </div>
            <div class="form-actions">
              <button class="btn-mini primary" id="saveInstructorBtn">Save instructor</button>
              <button class="btn-mini" id="cancelInstructorBtn">Cancel</button>
              <span class="status-msg" id="instructorSaveStatus"></span>
            </div>
          </div>
        </section>

        <section id="settingsSection" hidden>
          <div class="panel">
            <h2 style="font-size:1.05rem">Site settings</h2>
            <p class="hint">
              Contact details, hours, social links, map link, and the homepage/pricing promotions. Everything else
              (domain, branding text, page copy, opening days) is developer-only and lives in the code.
            </p>
            <p class="status-msg" id="settingsStatus"></p>
            <div class="form-grid" id="settingsFormFields">
              <div class="row-3">
                <div>
                  <label for="setPhone">Phone (with country code)</label>
                  <input type="text" id="setPhone" placeholder="+972-53-472-6458" />
                </div>
                <div>
                  <label for="setPhoneDisplay">Phone (as shown to visitors)</label>
                  <input type="text" id="setPhoneDisplay" placeholder="053-472-6458" />
                </div>
                <div>
                  <label for="setWhatsapp">WhatsApp number (digits only, country code, no +)</label>
                  <input type="text" id="setWhatsapp" placeholder="972534726458" />
                </div>
              </div>
              <div>
                <label for="setEmail">Email</label>
                <input type="text" id="setEmail" placeholder="studio@example.com" />
              </div>
              <div>
                <label for="setStreet">Street address</label>
                <input type="text" id="setStreet" placeholder="Meow Pow St. 34" />
              </div>
              <div class="row-3">
                <div>
                  <label for="setLat">Map latitude</label>
                  <input type="text" id="setLat" placeholder="31.973" />
                </div>
                <div>
                  <label for="setLng">Map longitude</label>
                  <input type="text" id="setLng" placeholder="34.7925" />
                </div>
                <div>
                  <label for="setGoogleMaps">Google Maps link</label>
                  <input type="text" id="setGoogleMaps" placeholder="https://maps.app.goo.gl/…" />
                </div>
              </div>
              <div class="row-3">
                <div>
                  <label for="setOpens">Opens</label>
                  <input type="time" id="setOpens" />
                </div>
                <div>
                  <label for="setCloses">Closes</label>
                  <input type="time" id="setCloses" />
                </div>
                <div>
                  <label for="setInstagram">Instagram URL</label>
                  <input type="text" id="setInstagram" placeholder="https://www.instagram.com/…" />
                </div>
              </div>
              <div>
                <label><input type="checkbox" id="setPromoActive" style="width:auto; display:inline-block; margin-inline-end:0.4em" /> Show promotions sitewide</label>
              </div>
              <div>
                <label><input type="checkbox" id="setFreeTrial" style="width:auto; display:inline-block; margin-inline-end:0.4em" /> Show the free trial class offer</label>
              </div>
              <div>
                <label><input type="checkbox" id="setOlimOffer" style="width:auto; display:inline-block; margin-inline-end:0.4em" /> Show the new immigrants (Olim) offer — no percentages are published, visitors are asked to get in touch</label>
              </div>
            </div>
            <div class="form-actions">
