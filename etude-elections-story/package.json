{
  "name": "etude-elections-story",
  "version": "1.0.0",
  "private": true,
  "description": "ETUDE Dance School — Knesset election day story series (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "audio": "python3 audio-src/generate_audio.py",
    "render:all": "bash scripts/render-all.sh",
    "render": "remotion render Story01 out/story-01.mp4 --codec=h264",
    "render:notext": "remotion render Story01-NoText out/story-01-notext.mp4 --codec=h264",
    "render:full": "remotion render SeriesFull out/story-series-full.mp4 --codec=h264",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.539",
    "@remotion/fonts": "^4.0.539",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "typescript": "^5.6.3"
  }
}
